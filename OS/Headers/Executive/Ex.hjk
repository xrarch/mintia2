FNPTR ExArenaLookupTagF (
    IN context : ^VOID,
    IN address : ^VOID,
) : ^ExpArenaTag

FNPTR ExArenaInsertTagF (
    IN context : ^VOID,
    IN address : ^VOID,
    IN size : UWORD,
