    IN flags : UWORD,
    OUT counter : ^ExuEventCounter,
) : OsStatus

EXTERN FN ExReferenceEventCounter (
    IN counter : ^ExuEventCounter,
)

EXTERN FN ExUnreferenceEventCounter (
    IN counter : ^ExuEventCounter,
)

EXTERN FN ExFindName (
    IN str : ^RtlString,
