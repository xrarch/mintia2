) : OsStatus

FNPTR ExArenaRemoveTagF (
    IN context : ^VOID,
    IN address : ^VOID,
    IN size : UWORD,
    IN tag : ^ExpArenaTag,
)

STRUCT ExArenaTagCallbacks
    Context : ^VOID,
    LookupTag : ExArenaLookupTagF,
    InsertTag : ExArenaInsertTagF,
    RemoveTag : ExArenaRemoveTagF,
END

FNPTR ExArenaImportF (
