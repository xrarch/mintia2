//
// Public header file for the Memory Management (Mm) component of the
// MINTIA Executive.
//

#INCLUDE "<ll>/Rtl.hjk"

FNPTR MmUseQuickPteF (
    IN vaddr : ^VOID,
    IN context : ^VOID,
) : OsStatus

EXTERN FN MmUseQuickPte (
    IN func : MmUseQuickPteF,
    IN pfn : UWORD,
    IN context : ^VOID,
) : OsStatus

EXTERN FN MmZeroPage (
    IN pfn : UWORD,
    IN offset : UWORD,
    IN length : UWORD,
)

EXTERN FN MmIsVirtualValid (
    IN vaddr : ^VOID,
) : UWORD

#DEFINE MM_ALLOCATE_LOW 1
#DEFINE MM_ALLOCATE_ZERO 2
#DEFINE MM_ALLOCATE_WAIT 4
#DEFINE MM_ALLOCATE_NO_BORROW 8
#DEFINE MM_ALLOCATE_FORCE_COMMIT 16
#DEFINE MM_ALLOCATE_NO_QUANTUM_CACHE 32

#MACRO MmAllocatePool ( poolindex, bytes, tag, flags, ptr ) [
    MmAllocatePoolEx (
        NULLPTR, // kenode
        poolindex, // poolindex
        bytes, // bytes
        tag, // tag
        flags, // flags
        ptr, // ptr
    )
]

EXTERN FN MmAllocatePoolEx (
    IN kenode : ^KeuNode,
    IN pageable : UWORD,
    IN bytes : UWORD,
    IN tag : ULONG,
    IN flags : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

EXTERN FN MmFreePool (
    IN ptr : ^VOID,
    IN tag : ULONG,
)

EXTERN FN MmGetOverheadOfBlock (
    IN ptr : ^VOID,
) : UWORD

EXTERN FN MmGetOverheadOfBytes (
    IN bytes : UWORD,
) : UWORD

ENUM MmSystemSize : UBYTE
    MM_UNINITIALIZED_SYSTEM,
    MM_TINY_SYSTEM,
    MM_SMALL_SYSTEM,
    MM_MEDIUM_SYSTEM,
    MM_LARGE_SYSTEM,
    MM_MASSIVE_SYSTEM,
END

EXTERN FN MmGetMmNodeSize (
    IN mmnode : ^MmpNode,
) : UWORD

EXTERN FN MmGetKeNodeSize (
    IN kenode : ^KeuNode,
) : UWORD

EXTERN FN MmSafeCopyIn (
    IN dest : ^VOID,
    IN src : ^VOID,
    IN sz : UWORD,
) : OsStatus

EXTERN FN MmSafeCopyOut (
    IN dest : ^VOID,
    IN src : ^VOID,
    IN sz : UWORD,
) : OsStatus

EXTERN FN MmCaptureString (
    IN string : ^RtlString,
    IN output : ^RtlString,
    IN maxlen : UWORD,
) : OsStatus

EXTERN FN MmFreeCapturedString (
    IN string : ^RtlString,
)

EXTERN FN MmAllocateAndChargeSysBuffer (
    IN bytes : UWORD,
    IN pageable : UWORD,
    IN tag : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

EXTERN FN MmDeallocateAndUnchargeSysBuffer (
    IN ptr : ^VOID,
    IN tag : UWORD,
    IN bytes : UWORD,
    IN pageable : UWORD,
)

EXTERN FN MmWaitForPoolMemory ()

#MACRO MmCurrentAffinityNode () [
    (KeCurrentAffinityNode()^.Mmp)
]

EXTERN FN MmCreateObjectCache (
    IN kenode : ^KeuNode,
    IN name : ^UBYTE,
    IN flags : UWORD,
    IN objectsize : UWORD,
    IN magazinecached : UWORD,
    IN pageable : UWORD,
    OUT objectcache : ^MmpObjectCache,
) : OsStatus

EXTERN FN MmDeleteObjectCache (
    IN objectcache : ^MmpObjectCache,
)

EXTERN FN MmAllocateFromObjectCache (
    IN objectcache : ^MmpObjectCache,
    IN flags : UWORD,
    IN tag : UWORD,
    OUT object : ^VOID,
) : OsStatus

EXTERN FN MmFreeToObjectCache (
    IN objectcache : ^MmpObjectCache,
    IN object : ^VOID,
    IN tag : UWORD,
)

EXTERN FN MmAllocateMappedPages (
    IN kenode : ^KeuNode,
    IN flags : UWORD,
    IN pages : UWORD,
    IN pageable : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

EXTERN FN MmFreeMappedPages (
    IN kenode : ^KeuNode,
    IN ptr : ^VOID,
    IN pages : UWORD,
    IN pageable : UWORD,
)