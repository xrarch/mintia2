//
// Public object management header file for the MINTIA system.
//

#DEFINE OS_HANDLE_SHIFT 3

#DEFINE OS_CURRENT_PROCESS -1
#DEFINE OS_CURRENT_THREAD -2
#DEFINE OS_NULL_HANDLE -3
#DEFINE OS_CURRENT_GROUP -4

#DEFINE OS_ACCESS_EXEC 1
#DEFINE OS_ACCESS_WRITE 2
#DEFINE OS_ACCESS_READ 4

#DEFINE OS_ACCESS_ALL [(OS_ACCESS_EXEC | OS_ACCESS_WRITE | OS_ACCESS_READ)]

#DEFINE OS_ACCESS_WORLD_EXEC 1
#DEFINE OS_ACCESS_WORLD_WRITE 2
#DEFINE OS_ACCESS_WORLD_READ 4

#DEFINE OS_ACCESS_WORLD_ALL [(OS_ACCESS_WORLD_EXEC |
    OS_ACCESS_WORLD_READ |
    OS_ACCESS_WORLD_WRITE)]

#DEFINE OS_ACCESS_GROUP_EXEC 8
#DEFINE OS_ACCESS_GROUP_WRITE 16
#DEFINE OS_ACCESS_GROUP_READ 32

#DEFINE OS_ACCESS_GROUP_ALL [(OS_ACCESS_GROUP_EXEC |
    OS_ACCESS_GROUP_WRITE |
    OS_ACCESS_GROUP_READ)]

#DEFINE OS_ACCESS_OWNER_EXEC 64
#DEFINE OS_ACCESS_OWNER_WRITE 128
#DEFINE OS_ACCESS_OWNER_READ 256

#DEFINE OS_ACCESS_OWNER_ALL [(OS_ACCESS_OWNER_EXEC |
    OS_ACCESS_OWNER_WRITE |
    OS_ACCESS_OWNER_READ)]

#DEFINE OS_ACCESS_ALL_ALL [(OS_ACCESS_WORLD_ALL |
    OS_ACCESS_GROUP_ALL |
    OS_ACCESS_OWNER_ALL)]

#DEFINE OS_ACCESS_ANY_EXEC [(OS_ACCESS_WORLD_EXEC |
    OS_ACCESS_GROUP_EXEC |
    OS_ACCESS_OWNER_EXEC)]

#DEFINE OS_ACCESS_NO_INHERIT 0x80000000

#DEFINE OS_SYSTEM_UID 0
#DEFINE OS_SYSTEM_GID 0

ENUM OsObjectType : UWORD
    OS_ANY_TYPE,

    OS_FILE_TYPE,
    OS_FCB_TYPE,
    OS_EVENT_TYPE,
    OS_PROCESS_TYPE,
    OS_THREAD_TYPE,
    OS_JOB_TYPE,
    OS_GROUP_TYPE,

    OS_MAX_TYPE,
END

// OS_SAFE_LENGTH is defined to be 256M less than the signed 32-bit maximum.
// This is used as a hard "safe maximum" for various things in the system in
// order to help avoid bugs around clumsy handling of buffer lengths being
// exploitable (such as interned string management in ExInternedStrings and
// temporary buffer management in MmCapture). This does not mean that consumers
// of these things don't need to care about not being stupid with buffers.

// The things that use this internally MAY depend on it to avoid bugs. For
// example the interned string management relies on it to avoid problems from
// the fact that the length field in RtlString is 64 bits on 64 bit platforms
// but the inlined length field in ExNameReference is always only 32 bit. By
// refusing to intern strings larger than this, lengths that extend into the
// upper 32 bits of the RtlString length are not chopped off when stashed in
// the ExNameReference. And there are others. Therefore it shouldn't be changed
// (increased) lightly.

#DEFINE OS_SAFE_LENGTH 0x70000000