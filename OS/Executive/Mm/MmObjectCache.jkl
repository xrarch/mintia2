//
// Implementation of object caches for the MINTIA Executive.
//
// A "slabs and magazines" type cache is implemented, inspired by Solaris.
// Magazines provide a per-cpu caching mechanism.
//
// It is recommended that for best performance on NUMA systems, object caches
// be duplicated per NUMA node, because the slab caches and magazines are not
// automatically duplicated on that basis.
// 

#INCLUDE "Mmp.hjk"

#DEFINE MMP_PREALLOCATED_CACHES 4

#DEFINE MMP_MAXIMUM_SMALL_SLAB_PAGES 2
#DEFINE MMP_MAXIMUM_MEDIUM_SLAB_PAGES 4
#DEFINE MMP_MAXIMUM_LARGE_SLAB_PAGES 6

#DEFINE MMP_SMALL_OBJECT [(RTL_PAGE_SIZE / 4)]
#DEFINE MMP_MEDIUM_OBJECT [(RTL_PAGE_SIZE)]
#DEFINE MMP_LARGE_OBJECT [(RTL_PAGE_SIZE * 2)]

STRUCT MmpObjectCache
    Lock : KeLock,

KE_CACHE_LINE_END

    Node : ^KeuNode,
    MagazineCache : ^ExpMagazineCache,
    ObjectSize : ULONG,
    ObjectsPerSlab : UINT,
    SlabPages : UBYTE,
    Pageable : UBYTE,
    PoolCacheIndex : UBYTE,

KE_CACHE_LINE_END

    PartialSlabListHead : RtlListEntry[2],
END

#MACRO MmpInitializeSlabObject ( object, objectsize, tag ) [
    NOTHING (CAST ((object) + (objectsize) - SIZEOF ULONG) TO ^ULONG)^ = (tag)
]

EXPORT FN MmAllocateFromObjectCache (
    IN objectcache : ^MmpObjectCache,
    IN flags : UWORD,
    IN tag : UWORD,
    OUT object : ^VOID,
) : OsStatus

    // Allocate an object.

    objectsize := objectcache^.ObjectSize

@Retry

    IF objectcache^.MagazineCache AND
        ExAllocateFromMagazineCache (
            objectcache^.MagazineCache, // magazinecache
            OUT object, // address
        ) THEN

        // There's a magazine cache and we managed to pull an object off it, so
        // go report success.

        MmpInitializeSlabObject ( object, objectsize, tag )

        RETURN OS_STATUS_SUCCESS
    END

    // Need to consult the slabs. First we're going to look at the unprivileged
    // slab list head.

    listhead := &objectcache^.PartialSlabListHead[FALSE]

    saveflags := flags

    thread := KeCurrentThread ()

    IF thread^.VmPrivilegeBits THEN
        // The thread is VM-privileged, so it should do two passes. The first
        // is a non-blocking attempt to pick up an object from an unprivileged
        // slab or to create a new unprivileged slab using normal pages. The
        // second is a blocking attempt to pick up an object from a privileged
        // slab or create one using privileged pages.

        flags &= ~MM_ALLOCATE_WAIT
        flags |= MM_ALLOCATE_NORMAL
    END

@RetryPrivileged

    ipl := KeAcquireLockExclusiveRaise ( &objectcache^.Lock )

    listentry := listhead^.Next
    vpe : ^MmpVpe

    IF listentry != listhead THEN
        // There's a partial slab, so grab an object from it.
        // We know for a fact there must be one there.

        vpe = CONTAINEROF listentry TO MmpVpe.U.ObjectCache.SlabListEntry

        object = vpe^.U.ObjectCache.FreeListHead

        KeAssert ( object != NULLPTR )

        vpe^.U.ObjectCache.InUseObjects += 1

        next := (CAST object TO ^^VOID)^

        vpe^.U.ObjectCache.FreeListHead = next

        IF NOT next THEN
            // Remove this slab from the partial list, since it is fully used.

            RtlRemoveEntryList ( &vpe^.U.ObjectCache.SlabListEntry )
        END

        KeReleaseLockLower ( &objectcache^.Lock, ipl )

        MmpInitializeSlabObject ( object, objectsize, tag )

        RETURN OS_STATUS_SUCCESS
    END

    // Need to allocate a new slab since there are no partial ones.

    KeReleaseLockLower ( &objectcache^.Lock, ipl )

    status := MmAllocateMappedPages (
        objectcache^.Node, // kenode
        flags, // flags
        objectcache^.SlabPages, // pages
        objectcache^.Pageable, // pageable
        OUT object, // address
    )

    IF OsError ( status ) THEN
        IF flags & MM_ALLOCATE_NORMAL AND
            listhead == &objectcache^.PartialSlabListHead[FALSE] THEN

            // This is a VM-privileged thread that failed to pick up an
            // unprivileged slab. So switch to privileged and try again.

            flags = saveflags
            listhead = &objectcache^.PartialSlabListHead[TRUE]

            GOTO RetryPrivileged
        END

        IF status == OS_STATUS_TRY_AGAIN AND
            flags & MM_ALLOCATE_WAIT THEN

            // We're the top level and the mapped page arena said to try again,
            // so try again.

            flags = saveflags

            GOTO Retry
        END

        RETURN status
    END

    // It's possible that our VM-privileged state changed while we waited for
    // pages and that we actually have reserved pages despite initially
    // thinking we didn't, so we need to check again. This might also allow
    // us to back down from making the slab VM-privileged if it turns out the
    // memory situation has improved since we made that choice.

    vmprivileged := FALSE
    listhead = &objectcache^.PartialSlabListHead[FALSE]
    mmnode := objectcache^.Node^.Mmp

    IF thread^.VmPrivilegeBits AND
        mmnode^.AvailablePageCount <= MMP_BLOCK_FOR_PAGES_THRESHOLD THEN

        // We did not observe the available page count above the reserved
        // threshold, so we still have to make it VM-privileged. (If we had,
        // that would mean the page count we claimed doesn't count as reserved,
        // and we wouldn't need to do this).

        listhead = &objectcache^.PartialSlabListHead[TRUE]
        vmprivileged = TRUE
    END

    // Take the lock and add the slab.

    ipl = KeAcquireLockExclusiveRaise ( &objectcache^.Lock )

    // It's possible someone else doing the same thing added a partial slab to
    // either the normal slab list head or the VM-privileged list head. Check
    // both (this redundantly checks the normal slab list head twice if that's
    // the one selected, but it's slower to add a branch to avoid this).

    IF NOT RtlEmptyList ( &objectcache^.PartialSlabListHead[FALSE] ) OR
        NOT RtlEmptyList ( listhead ) THEN

        // Someone else added a partial slab while we were trying to get one.
        // Free ours and retry everything.

        KeReleaseLockLower ( &objectcache^.Lock, ipl )

        MmFreeMappedPages (
            objectcache^.Node, // kenode
            object, // ptr
            objectcache^.SlabPages, // pages
            objectcache^.Pageable, // pageable
        )

        flags = saveflags

        GOTO Retry
    END

    vpe = MmpAddressToVpe ( mmnode, object )

    // Initialize the VPE to describe the slab.
    // Note that the SlabArena's import function already created the VPEs.

    vpe^.U.ObjectCache.InUseObjects = 1
    vpe^.U.ObjectCache.FreeListHead = NULLPTR
    vpe^.U.ObjectCache.Tag = 0xABABABAB

    RtlInsertAtTailList (
        listhead, // listhead
        &vpe^.U.ObjectCache.SlabListEntry, // listentry
    )

    // Initialize all VPEs of the slab to point to the first one as the
    // control VPE.

    othervpe := vpe
    max : UWORD = objectcache^.SlabPages
    i := 0

    WHILE i < max DO
        othervpe^.U.ObjectCache.SlabControl = vpe
        othervpe^.U.ObjectCache.PoolCacheIndex = objectcache^.PoolCacheIndex
        othervpe^.U.ObjectCache.VmPrivileged = vmprivileged

        othervpe += MMP_VPE_SIZE
        i += 1
    END

    // Put all the objects except the first one on the slab's free list.
    // We will return the first one.

    max = objectcache^.ObjectsPerSlab
    i = 1
    ptr : ^^VOID = object + objectsize

    WHILE i < max DO
        ptr^ = vpe^.U.ObjectCache.FreeListHead
        vpe^.U.ObjectCache.FreeListHead = ptr

        ptr += objectsize
        i += 1
    END

    KeReleaseLockLower ( &objectcache^.Lock, ipl )

    MmpInitializeSlabObject ( object, objectsize, tag )

    RETURN OS_STATUS_SUCCESS
END

FN (ExMagazineCacheFreeF) MmpFreeToObjectCache (
    IN context : ^VOID,
    IN ptr : ^VOID,
)

    // Free the object to the object cache. Bypass magazine layer.

    objectcache := CAST context TO ^MmpObjectCache

    mmnode := objectcache^.Node^.Mmp

    vpe := MmpAddressToVpe ( mmnode, ptr )

    // Find the control VPE for the slab in case this is in the middle of a
    // multi-page slab.

    vpe = vpe^.U.ObjectCache.SlabControl

    ipl := KeAcquireLockExclusiveRaise ( &objectcache^.Lock )

    inuse := vpe^.U.ObjectCache.InUseObjects

    KeAssert ( inuse > 0 )

    IF inuse != 1 THEN
        // There are still active objects inside the slab.

        vpe^.U.ObjectCache.InUseObjects = inuse - 1

        IF inuse == objectcache^.ObjectsPerSlab THEN
            // The slab went from completely in use to partial.
            // Put it on the head of the partial slab list since it's only
            // one object away from being completely in use again, so we want
            // to prioritize allocating from it to try to make that happen.

            KeAssert ( vpe^.U.ObjectCache.FreeListHead == NULLPTR )

            vmprivileged := vpe^.U.ObjectCache.VmPrivileged

            RtlInsertAtHeadList (
                &objectcache^.PartialSlabListHead[vmprivileged], // listhead
                &vpe^.U.ObjectCache.SlabListEntry, // listentry
            )
        END

        NOTHING (CAST ptr TO ^^VOID)^ = vpe^.U.ObjectCache.FreeListHead
        vpe^.U.ObjectCache.FreeListHead = ptr

        KeReleaseLockLower ( &objectcache^.Lock, ipl )

        LEAVE
    END

    // This slab is now empty and should be freed.

    RtlRemoveEntryList ( &vpe^.U.ObjectCache.SlabListEntry )

    KeReleaseLockLower ( &objectcache^.Lock, ipl )

    MmFreeMappedPages (
        objectcache^.Node, // kenode
        MmpVpeToAddress ( mmnode, vpe ), // address
        objectcache^.SlabPages, // pages
        objectcache^.Pageable, // pageable
    )
END

EXPORT FN MmFreeToObjectCache (
    IN objectcache : ^MmpObjectCache,
    IN object : ^VOID,
    IN tag : UWORD,
)

    // Free the object to the object cache.

    objecttag :=
        (CAST (object + objectcache^.ObjectSize - SIZEOF ULONG) TO ^ULONG)^

    IF objecttag != tag THEN
        KeCrash ( "MmFreeToObjectCache: incorrect tag (expected %x, saw %x\n",
            tag, objecttag )
    END

    IF objectcache^.MagazineCache THEN
        // There's a magazine cache so free the object to it.

        mmnode := objectcache^.Node^.Mmp

        vpe := MmpAddressToVpe ( mmnode, object )

        // Never free an object on a VM-privileged slab to the magazine cache,
        // they must not be allowed to get picked up by random threads. We also
        // want those slabs to get freed as quickly as possible and not linger
        // in caches.

        // XXX Is there a way to tell that it's on a VM-privileged slab without
        //     looking at the VPE? It's kind of a bummer to have to do that even
        //     in the magazine cached case.

        IF NOT vpe^.U.ObjectCache.VmPrivileged THEN
            ExFreeToMagazineCache (
                objectcache^.MagazineCache, // magazinecache
                object, // ptr
            )

            LEAVE
        END
    END

    MmpFreeToObjectCache (
        objectcache, // context
        object, // ptr
    )
END

#SECTION "PAGEtext"
FN MmpFreeObjectCache (
    IN objectcache : ^MmpObjectCache,
)

    // Free an object cache.

    mmnode := objectcache^.Node^.Mmp

    IF objectcache >= &mmnode^.PreallocatedObjectCaches[0] AND
objectcache < &mmnode^.PreallocatedObjectCaches[MMP_PREALLOCATED_CACHES] THEN

        // The object cache is preallocated so don't free it.

        LEAVE
    END

    MmFreeToObjectCache (
        mmnode^.ObjectCacheCache, // cache
        objectcache, // ptr
        'ObjC', // tag
    )
END

#SECTION "PAGEtext"
FN MmpCalculateGoodSlabSize (
    IN objectsize : UWORD,
) : UWORD

    // Calculate a number of pages for the slabt hat minimizes fragmentation
    // while still fitting at least two of the object.

    max : UWORD

    IF objectsize <= MMP_SMALL_OBJECT THEN
        max = MMP_MAXIMUM_SMALL_SLAB_PAGES

    ELSEIF objectsize <= MMP_MEDIUM_OBJECT THEN
        max = MMP_MAXIMUM_MEDIUM_SLAB_PAGES

    ELSE
        max = MMP_MAXIMUM_LARGE_SLAB_PAGES
    END

    i := ((objectsize * 2) + RTL_PAGE_SIZE - 1) >> RTL_PAGE_SHIFT
    bestpages := -1
    bestfragmentation := -1

    // Pick the smallest page count that achieves below 5% wastage.
    // If none do, then pick the best one.

    WHILE i <= max DO
        slabbytes := i * RTL_PAGE_SIZE

        slabobjects := slabbytes / objectsize

        wastebytes := slabbytes - (slabobjects * objectsize)

        percentwasted := (wastebytes * 100) / RTL_PAGE_SIZE

        IF percentwasted < 5 THEN
            bestpages = i

            BREAK
        END

        IF percentwasted < bestfragmentation THEN
            bestfragmentation = percentwasted
            bestpages = i
        END

        i += 1
    END

    RETURN bestpages
END

#SECTION "PAGEtext"
EXPORT FN MmCreateObjectCache (
    IN kenode : ^KeuNode,
    IN name : ^UBYTE,
    IN flags : UWORD,
    IN objectsize : UWORD,
    IN magazinecached : UWORD,
    IN pageable : UWORD,
    IN align : UWORD,
    OUT objectcache : ^MmpObjectCache,
) : OsStatus

    // Create an object cache.
    // Alignment must be a power of two.

    KeAssert ( objectsize < MMP_LARGE_OBJECT )
    KeAssert ( objectsize != 0 )

    IF align < RTL_ALIGN_BYTES THEN
        align = RTL_ALIGN_BYTES
    END

    // Make room for a tag at the end and align.

    objectsize = MmRealBlockSize ( objectsize, align )

    status : OsStatus

    mmnode := kenode^.Mmp

    objectcache = NULLPTR

    KeAcquireLockExclusive ( &mmnode^.ObjectCacheListLock )

    IF mmnode^.PreallocatedObjectCacheIndex < MMP_PREALLOCATED_CACHES THEN
        // There are still preallocated object caches, so take one.

        index := mmnode^.PreallocatedObjectCacheIndex

        objectcache = &mmnode^.PreallocatedObjectCaches[index]

        mmnode^.PreallocatedObjectCacheIndex = index + 1
    END

    KeReleaseLock ( &mmnode^.ObjectCacheListLock )

    IF NOT objectcache THEN
        // No more preallocated object caches left, so grab one from the
        // object cache cache.

        status = MmAllocateFromObjectCache (
            mmnode^.ObjectCacheCache, // cache
            flags, // flags
            'ObjC', // tag
            OUT objectcache, // ptr
        )

        IF OsError ( status ) THEN
            RETURN status
        END
    END

    objectcache^.Node = kenode
    objectcache^.MagazineCache = NULLPTR
    objectcache^.ObjectSize = objectsize

    RtlInitializeList ( &objectcache^.PartialSlabListHead[FALSE] )
    RtlInitializeList ( &objectcache^.PartialSlabListHead[TRUE] )

    objectcache^.SlabPages = MmpCalculateGoodSlabSize ( objectsize )

    objectcache^.ObjectsPerSlab =
        (objectcache^.SlabPages << RTL_PAGE_SHIFT) / objectsize

    KeAssert ( objectcache^.ObjectsPerSlab != 1 )

    objectcache^.Pageable = NOT NOT pageable

    KeInitializeLock ( &objectcache^.Lock, "ObjectCache" )

    IF magazinecached THEN
        // Initialize a magazine cache.

        status = ExCreateMagazineCache (
            kenode, // kenode
            name, // name
            flags, // flags
            pageable, // pageable
            &MmpFreeToObjectCache, // freefunc
            objectcache, // context
            OUT objectcache^.MagazineCache, // magazinecache
        )

        IF OsError ( status ) THEN
            MmpFreeObjectCache ( objectcache )

            RETURN status
        END
    END

    RETURN status
END

#SECTION "PAGEtext"
EXPORT FN MmDeleteObjectCache (
    IN objectcache : ^MmpObjectCache,
)

    // Delete an object cache.
    // All objects should have been freed.

    IF objectcache^.MagazineCache THEN
        ExDeleteMagazineCache ( objectcache^.MagazineCache )
    END

    KeAssert ( RtlEmptyList ( &objectcache^.PartialSlabListHead[FALSE] ) )
    KeAssert ( RtlEmptyList ( &objectcache^.PartialSlabListHead[TRUE] ) )

    MmpFreeObjectCache ( objectcache )
END

#SECTION "INITtext"
FN MmpInitializeObjectCaches (
    IN kenode : ^KeuNode,
)

    // Initialize the object cache package for all nodes.

    mmnode := kenode^.Mmp

    mmnode^.PreallocatedObjectCaches = KeuAllocateNodeSpace (
        kenode, // kenode
        SIZEOF MmpObjectCache * MMP_PREALLOCATED_CACHES, // bytes
    )

    KeAssert ( mmnode^.PreallocatedObjectCaches != NULLPTR )

    mmnode^.PreallocatedObjectCacheIndex = 0

    KeInitializeLock ( &mmnode^.ObjectCacheListLock, "ObjectCacheList" )

    // Create the object cache cache.

    status := MmCreateObjectCache (
        kenode, // kenode
        "ObjectCacheCache", // name
        0, // flags
        SIZEOF MmpObjectCache, // objectsize
        FALSE, // magazinecached
        FALSE, // pageable
        KE_CACHE_ALIGN, // align
        OUT mmnode^.ObjectCacheCache, // objectcache
    )

    KeAssert ( NOT OsError ( status ) )
END

#SECTION "INITtext"
FN MmpSetObjectCacheIndex (
    IN objectcache : ^MmpObjectCache,
    IN index : UWORD,
)

    // Set the indices that the object cache will store in its slab VPEs.
    // This is used by MmPool.

    objectcache^.PoolCacheIndex = index
END