//
// Mapped page allocator for the MINTIA executive.
//

#INCLUDE "Mmp.hjk"

FN (ExArenaImportF) MmpImportNonpageable (
    IN context : ^VOID,
    IN importarena : ^ExpArena,
    IN flags : UWORD,
    IN size : UWORD,
    OUT address : ^VOID,
) : OsStatus

    // Import into the nonpaged arena.

    mmnode := CAST context TO ^MmpNode

    pages := size >> RTL_PAGE_SHIFT

    // First charge commit for these pages.

    status := MmuChargeCommit (
        mmnode, // mmnode
        pages, // pages
        flags, // flags
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Now allocate the virtual addresses from the dynamic space arena.

    status = MmpAllocateDynamicPages (
        mmnode, // mmnode
        pages, // pages
        flags, // flags
        OUT address, // ptr
    )

    IF OsError ( status ) THEN
        GOTO Error1
    END

    // Create a range of VPEs for the pages in the span.

    status = MmpCreateVpes (
        mmnode, // mmnode
        (address - mmnode^.DynamicSpaceBase) >> RTL_PAGE_SHIFT, // vpn
        size >> RTL_PAGE_SHIFT, // pages
        flags, // flags
    )

    IF OsError ( status ) THEN
        GOTO Error2
    END

    i := 0
    pte := MmpPteAddress ( address )
    colorptr := address

    WHILE i < pages DO
        // Allocate a page frame to place here.

@Retry

        pfe := MmpAllocatePage (
            mmnode, // mmnode
            flags, // flags
            MmpVirtualAddressColor ( colorptr ), // color
        )

        IF NOT pfe THEN
            IF flags & MM_ALLOCATE_WAIT THEN
                // Caller said we should wait here for more pages.

                MmpWaitForPages (
                    mmnode, // mmnode
                    flags & MM_ALLOCATE_LOW, // low
                )

                GOTO Retry
            END

            // Free everything we just did.

#IF BLD_CHK
            colorptr = address
#END

            WHILE i DO
                i -= 1

                ptecontents := pte[i]

                KeAssert ( MmpIsPteValid ( ptecontents ) )

                pte[i] = MMP_INVALID_KERNEL_PTE

                MmpFreePage ( MmpPfnToPfe ( MmpPfnFromPte ( ptecontents ) ) )

#IF BLD_CHK
                KeuFlushMyTbAddress ( colorptr )

                colorptr += RTL_PAGE_SIZE
#END
            END

            status = OS_STATUS_NO_MEMORY

            GOTO Error3
        END

        // Map the page frame.
        // Note that no TB entry exists for this page in any CPU if we've been
        // given it by the dynamic space allocator.

        pte[i] = MmpBuildPoolPte ( MmpPfeToPfn ( pfe ) )

        i += 1
        colorptr += RTL_PAGE_SIZE
    END

    RETURN OS_STATUS_SUCCESS

@Error3

    MmpUnreferenceVpes (
        mmnode, // mmnode
        (address - mmnode^.DynamicSpaceBase) >> RTL_PAGE_SHIFT, // vpn
        pages, // pages
    )

@Error2

    MmpReleaseDynamicPages (
        mmnode, // mmnode
        address, // ptr
        pages, // pages
        FALSE, // flush
    )

@Error1

    MmuUnchargeCommit (
        mmnode, // mmnode
        pages, // pages
    )

    RETURN status
END

FN (ExArenaFreeF) MmpFreeNonpageable (
    IN context : ^VOID,
    IN importarena : ^ExpArena,
    IN address : ^VOID,
    IN size : UWORD,
)

    // Free a nonpageable slab.

    mmnode := CAST context TO ^MmpNode
    pages := size >> RTL_PAGE_SHIFT

    pte := MmpPteAddress ( address )
    i := 0

#IF BLD_CHK
    ptr := address
#END

    WHILE i < pages DO
        ptecontents := pte[i]

        KeAssert ( MmpIsPteValid ( ptecontents ) )

        pte[i] = MMP_INVALID_KERNEL_PTE

        MmpFreePage ( MmpPfnToPfe ( MmpPfnFromPte ( ptecontents ) ) )

#IF BLD_CHK
        KeuFlushMyTbAddress ( ptr )

        ptr += RTL_PAGE_SIZE
#END

        i += 1
    END

    MmpUnreferenceVpes (
        mmnode, // mmnode
        (address - mmnode^.DynamicSpaceBase) >> RTL_PAGE_SHIFT, // vpn
        pages, // pages
    )

    MmpReleaseDynamicPages (
        mmnode, // mmnode
        address, // ptr
        pages, // pages
        TRUE, // flush
    )

    MmuUnchargeCommit (
        mmnode, // mmnode
        pages, // pages
    )
END

FN (ExArenaLookupTagF) MmpLookupMappedArenaTag (
    IN context : ^VOID,
    IN address : ^VOID,
    IN remove : UWORD,
) : ^ExpArenaTag

    // Look up the slab arena tag.
    // Do nothing on removal since we unreference the VPE upon freeing the
    // underlying imported span.

    mmnode := CAST context TO ^MmpNode

    vpe := MmpFindVpe (
        mmnode, // mmnode
        (address - mmnode^.DynamicSpaceBase) >> RTL_PAGE_SHIFT, // vpn
    )

    tag := vpe^.MappedArenaTag

    IF remove THEN
        vpe^.MappedArenaTag = NULLPTR
    END

    RETURN tag
END

FN (ExArenaInsertTagF) MmpInsertMappedArenaTag (
    IN context : ^VOID,
    IN address : ^VOID,
    IN flags : UWORD,
    IN tag : ^ExpArenaTag,
) : OsStatus

    // Insert the slab arena tag.

    mmnode := CAST context TO ^MmpNode

    vpe := MmpFindVpe (
        mmnode, // mmnode
        (address - mmnode^.DynamicSpaceBase) >> RTL_PAGE_SHIFT, // vpn
    )

    vpe^.MappedArenaTag = tag

    RETURN OS_STATUS_SUCCESS
END

FN MmpInitializeMappedPages (
    IN kenode : ^KeuNode,
)

    // Initialize the mapped page allocator.

    mmnode := kenode^.Mmp

    // Create the two slab arenas, one for each type of pageability.

    tagcallbacks : ExArenaTagCallbacks
    tagcallbacks.Context = mmnode
    tagcallbacks.LookupTag = &MmpLookupMappedArenaTag
    tagcallbacks.InsertTag = &MmpInsertMappedArenaTag

    importcallbacks : ExArenaImportCallbacks
    importcallbacks.Context = mmnode
    importcallbacks.Import = &MmpImportNonpageable
    importcallbacks.Free = &MmpFreeNonpageable
    importcallbacks.ImportQuantumShift = RTL_PAGE_SHIFT + 3

    status := ExCreateArena (
        "NonpagedMappedArena", // name
        kenode, // kenode
        0, // flags
        &tagcallbacks, // tagcallbacks
        &importcallbacks, // importcallbacks
        0, // quantumcachemax
        FALSE, // pageable
        RTL_PAGE_SHIFT, // quantumshift
        mmnode^.DynamicSpaceArena, // importarena
        OUT mmnode^.MappedArenas[FALSE], // arena
    )

    KeAssert ( NOT OsError ( status ) )

    ExuRegisterPopulatorArena ( mmnode^.MappedArenas[FALSE] )

    // TEMP
#IF 0
    importcallbacks.Import = &MmpImportPageable
    importcallbacks.Free = &MmpFreePageable
    importcallbacks.ImportQuantumShift = RTL_PAGE_SHIFT + 4
#END

    status = ExCreateArena (
        "PagedMappedArena", // name
        kenode, // kenode
        0, // flags
        &tagcallbacks, // tagcallbacks
        &importcallbacks, // importcallbacks
        0, // quantumcachemax
        TRUE, // pageable
        RTL_PAGE_SHIFT, // quantumshift
        mmnode^.DynamicSpaceArena, // importarena
        OUT mmnode^.MappedArenas[TRUE], // arena
    )

    KeAssert ( NOT OsError ( status ) )
END

EXPORT FN MmAllocateMappedPages (
    IN kenode : ^KeuNode,
    IN flags : UWORD,
    IN pages : UWORD,
    IN pageable : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

    // Allocate a number of pages from the slab arena.

    RETURN ExAllocateFromArena (
        kenode^.Mmp^.MappedArenas[NOT NOT pageable], // arena
        flags, // flags
        pages << RTL_PAGE_SHIFT, // size
        OUT ptr, // address
    )
END

EXPORT FN MmFreeMappedPages (
    IN kenode : ^KeuNode,
    IN ptr : ^VOID,
    IN pages : UWORD,
    IN pageable : UWORD,
)

    // Free a number of pages to the slab arena.

    ExFreeToArena (
        kenode^.Mmp^.MappedArenas[NOT NOT pageable], // arena
        ptr, // address
        pages << RTL_PAGE_SHIFT, // size
    )
END