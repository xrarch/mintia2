//
// Management for available page frames in the MINTIA memory manager.
//
// Includes allocation of page frames and management of the available page
// count.
//

#INCLUDE "Mmp.hjk"

FN MmpMakeMorePages (
    IN mmnode : ^MmpNode,
)

    // Try to make free pages, asynchronously.

    IF mmnode^.LowMemoryEvent.Header.SignalCount == 0 THEN
        KeSignalEvent (
            &mmnode^.LowMemoryEvent, // event
            0, // priorityboost
        )
    END
END

#IF BLD_NUMA

FN MmpClaimAvailablePages (
    IN mmnode : ^MmpNode,
    IN pages : UWORD,
    IN flags : UWORD,
    IN timeout : ^RtlUquad,
    OUT actualnode : ^MmpNode,
) : OsStatus

    // Claim available pages from the closest node that has them to claim. If
    // none has them, then default to the original node. Returns the node that
    // it was taken from.

    actualnode = mmnode
    nodelist := mmnode^.KeNode^.DistanceList

    threshold := MMP_BLOCK_FOR_PAGES_THRESHOLD

    IF PsCurrentThread ()^.Tcb.VmPrivilegeBits AND
        flags & MM_ALLOCATE_NORMAL == 0 THEN

        // VM privileged threads get to tap the reserved pool, unless they
        // specifically asked not to.

        threshold = 0
    END

    avail := mmnode^.AvailablePageCount

    IF avail > mmnode^.LowPageCount AND
        (avail - pages) <= mmnode^.LowPageCount THEN

        // It was the home node and this request will make it low on pages, so
        // start the asynchronous page-making processes.

        // We do this now rather than when we're more sure we're taking it from
        // the home node because we only know that for sure after the CAS
        // succeeds, and by that time, a window has opened where people are
        // blocking for free pages but nobody has started the page-making
        // processes, which could lead to deadlock.

        MmpMakeMorePages ( mmnode )
    END

    WHILE TRUE DO
        WHILE avail < pages OR
            (avail - pages) <= threshold DO

            // Dang!!!!! Not enough pages on this node. Try skipping to one
            // that has pages and is on the same pagefile pool.

@NextNode

            IF NOT nodelist[0] OR
                flags & MM_ALLOCATE_NO_BORROW THEN

                // No more nodes left to check, or the caller is demanding that
                // we don't borrow from other nodes. Try blockingly from the
                // home node.

                IF flags & MM_ALLOCATE_WAIT == 0 THEN
                    // Nevermind, this won't help since we're not allowed to
                    // wait anyway.

                    RETURN OS_STATUS_NO_MEMORY
                END

                actualnode = mmnode

                RETURN KeuDecrementQuantityQueue (
                    &mmnode^.AvailablePageQuantityQueue, // queue
                    pages, // amount
                    KE_KERNEL_MODE, // waitmode
                    KE_UNALERTABLE, // alertable
                    timeout, // timeout
                    TRUE, // wait
                )
            END

            actualnode = nodelist[0]^.Mmp
            nodelist += SIZEOF ^KeuNode

            IF actualnode^.PagefileState != mmnode^.PagefileState THEN
                // This new node is not on the same pagefile pool as our home
                // node. This also means they don't share commit, so it's
                // illegal to borrow between them since that violates the
                // guarantees commit is meant to provide the system.

                // Try the next node instead.

                GOTO NextNode
            END

            // Grab the available page count of the new node.

            avail = actualnode^.AvailablePageCount

            // Don't borrow if a remote node is already below its low page
            // count. That would be rude and likely counterproductive.

            threshold = actualnode^.LowPageCount
        END

        // The currently selected actualnode appears to have enough pages to
        // satisfy our request, so try to yoink.

        new := KeCompareSwapPtr (
            &actualnode^.AvailablePageCount, // ptr
            avail - pages, // newvalue
            avail, // expectedvalue
        )

        IF new == avail THEN
            // Got it!

            IF actualnode != mmnode THEN
                // We're borrowing the page frames, so record that with a
                // saturating 16-bit counter. This does not need atomics since
                // its a hint, so a lost count isn't a big deal.

                oldvalue : UWORD = mmnode^.BorrowCounts[actualnode^.Id]

                oldvalue += pages

                IF oldvalue > 0xFFFF THEN
                    oldvalue = 0xFFFF
                END

                mmnode^.BorrowCounts[actualnode^.Id] = oldvalue
            END

            RETURN OS_STATUS_SUCCESS
        END

        // Our copy of the available page count became stale, so update it and
        // try again.

        avail = new
    END
END

#ELSE

FN MmpClaimAvailablePages (
    IN mmnode : ^MmpNode,
    IN pages : UWORD,
    IN flags : UWORD,
    IN timeout : ^RtlUquad,
    OUT actualnode : ^MmpNode,
) : OsStatus

    // Non-NUMA build so just claim directly from home node.

    actualnode = mmnode

    avail := mmnode^.AvailablePageCount

    IF avail > mmnode^.LowPageCount AND
        (avail - pages) <= mmnode^.LowPageCount THEN

        // It was the home node and this request will make it low on pages, so
        // start the asynchronous page-making processes.

        // We do this now rather than when we're more sure we're taking it from
        // the home node because we only know that for sure after the CAS
        // succeeds, and by that time, a window has opened where people are
        // blocking for free pages but nobody has started the page-making
        // processes, which could lead to deadlock.

        MmpMakeMorePages ( mmnode )
    END

    RETURN KeuDecrementQuantityQueue (
        &mmnode^.AvailablePageQuantityQueue, // queue
        pages, // amount
        KE_KERNEL_MODE, // waitmode
        KE_UNALERTABLE, // alertable
        timeout, // timeout
        flags & MM_ALLOCATE_WAIT, // wait
    )
END

#END

FN MmuAddPageReservation (
    IN minimum : UWORD,
    IN maximum : UWORD,
    IN flags : UWORD,
    OUT actual : UWORD,
) : OsStatus

    // Set the current thread's page reservation to at least the minimum
    // requested, ideally up to the maximum. Return the actual amount reserved.

    // This is intended to be used by various levels of an allocation stack.
    // It's designed to assume that MM_ALLOCATE_WAIT means it's at the top
    // level of an allocation stack, and a lack thereof means it is at a deeper
    // layer. If a failure occurs here and it's at a lower layer, then a Debt
    // is accrued, and an OS_STATUS_TRY_AGAIN is returned to eventually induce
    // the uppermost layer to call MmuFulfillPageReservation, at which point it
    // will try to reserve the entire debt at once.

    // This has the effect that if a wait is needed for pages in order
    // to satisfy a reservation, it is consolidated to the upper layer. This is
    // needed for locking reasons, but also good for page wait scheduling,
    // since waits will be for a quantity of pages that actually reflects what
    // the thread immediately needs to make its way through the allocation
    // stack.

    KeAssert ( maximum >= minimum )

    thread := PsCurrentThread ()
    reserve := &thread^.ReservedPages[thread^.Tcb.ExecutingKapc]

    saveflags := flags
    actual = maximum

    IF maximum != minimum THEN
        // Try the maximum with no waiting and with normal threshold.

        // The reason we're overriding any VM-privileged threshold here for the
        // first pass, is to try to cause VM-privileged threads to use the
        // minimum amount of the reserved pool of pages; if the first pass fails
        // then we remove this limitation at the same time we peel back the
        // attempt to the minimum, and that time it'll get the minimum out of
        // the reserved pool.

        flags &= ~MM_ALLOCATE_WAIT
        flags |= MM_ALLOCATE_NORMAL
    END

    mmnode := MmCurrentAffinityNode ()

#IF BLD_NUMA
    IF reserve^.Node THEN
        mmnode = reserve^.Node
        flags |= MM_ALLOCATE_NO_BORROW
    END
#END

    reserve^.Debt = 0
    credit := reserve^.Credit

@Retry

    IF credit >= actual THEN
        // Take from credit.

        reserve^.Credit = credit - actual

        RETURN OS_STATUS_SUCCESS
    END

    // Page reserve is commit-charged since any wait that occurs while charging
    // commit also should be accumulated to a top level.

    status := MmuChargeCommit (
        mmnode, // mmnode
        actual - credit, // pages
        flags, // flags
    )

    IF OsError ( status ) THEN
        GOTO Error
    END

    // Reserve actual available page count.

    timeout : RtlUquad
    RtlSetUquadToUlong ( &timeout, 1000 )

    status = MmpClaimAvailablePages (
        mmnode, // mmnode
        actual - credit, // pages
        flags, // flags
        &timeout, // timeout
        OUT: actualnode, // actualnode
    )

    IF OsError ( status ) THEN
        MmuUnchargeCommit (
            mmnode, // mmnode
            actual - credit, // pages
        )

        GOTO Error
    END

#IF BLD_NUMA
    reserve^.Node = actualnode
#END

    reserve^.Count += actual
    reserve^.Credit = 0

    RETURN OS_STATUS_SUCCESS

@Error

    IF actual != minimum THEN
        // Lower to the minimum and retry.

        flags = saveflags
        actual = minimum

        GOTO Retry
    END

    // Failed to get the minimum.

    IF flags & MM_ALLOCATE_WAIT == 0 OR
        status == OS_STATUS_WAIT_TIMEOUT THEN

        // We weren't able to wait, so add this as a debt and induce upper
        // layers to try again. 

        // We also do this in the event of a timeout to mitigate a class of
        // deadlocks where, for example, the entirety of physical memory may be
        // filled with pool pages, and pool blocks are being allocated and
        // freed, but no physical pages are ever freed. Instead of sitting here
        // forever, we should retry so we can grab one of those freed pool
        // blocks. This should be very rare.

        reserve^.Debt = minimum

        status = OS_STATUS_TRY_AGAIN
    END

    RETURN status
END

EXPORT FN MmReleasePageReserve ()

    // Release the remaining page reservation for the thread, if any.

    thread := PsCurrentThread ()

    reserve := &thread^.ReservedPages[thread^.Tcb.ExecutingKapc]

    count := reserve^.Count + reserve^.Credit

    IF count == 0 THEN
        // Nothing to release.

        LEAVE
    END

    // Set the reserve empty.

    reserve^.Count = 0
    reserve^.Credit = 0

    // Get the node the pages were reserved from.

#IF BLD_NUMA
    mmnode := reserve^.Node
    reserve^.Node = NULLPTR

    KeAssert ( mmnode != NULLPTR )
#ELSE
    mmnode := MmCurrentAffinityNode ()
#END

    // Increment the available page count.

    KeuIncrementQuantityQueue (
        &mmnode^.AvailablePageQuantityQueue, // queue
        count, // amount
    )

    // Uncharge the commit.

    MmuUnchargeCommit (
        mmnode, // mmnode
        count, // pages
    )

    // Convert to debt.

    reserve^.Debt += count
END

EXPORT FN MmFulfillPageReservation ()

    // Intended to be called by a top level of the allocation stack that
    // received OS_STATUS_TRY_AGAIN from a lower level and needs to fulfill
    // a debt. The caller is responsible for releasing any excess page
    // reservation.

    thread := PsCurrentThread ()

    reserve := &thread^.ReservedPages[thread^.Tcb.ExecutingKapc]

    KeAssert ( reserve^.Credit == 0 )
    KeAssert ( reserve^.Count == 0 )

    debt := reserve^.Debt

    MmuAddPageReservation (
        debt, // minimum
        debt, // maximum
        MM_ALLOCATE_WAIT, // flags
        OUT: junk, // actual
    )

    // Move the reservation to credit.

    reserve^.Credit = reserve^.Count
    reserve^.Count = 0
END

FN MmpInsertPageIntoList (
    IN list : ^MmpAvailablePageList,
    IN pfe : ^MmpPfe,
    IN head : UWORD,
) : UWORD

    // Insert the page into the specified list, into the correct color bucket.
    // Return the count of page frames on the list before this one was added.

    pfn := MmpPfeToPfn ( pfe )
    colorlist := &list^.Colors[MmpPfnColor ( pfn )]

    ipl := KeAcquireLockExclusiveRaise ( &colorlist^.Lock )

    IF head THEN
        RtlInsertAtHeadList (
            &colorlist^.Head, // head
            &pfe^.Entry, // entry
        )

    ELSE
        RtlInsertAtTailList (
            &colorlist^.Head, // head
            &pfe^.Entry, // entry
        )
    END

    oldcount := KeIncrementPtr (
        &list^.Count, // ptr
        1, // inc
    )

    KeReleaseLockLower ( &colorlist^.Lock, ipl )

    RETURN oldcount
END

FN MmpAllocatePageFromList (
    IN list : ^MmpAvailablePageList,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page, preferably with the given color, from the list.

    i := 0

    WHILE i < MMP_COLOR_COUNT DO
        colorlist := &list^.Colors[color]

        IF NOT RtlEmptyList ( &colorlist^.Head ) THEN
            ipl := KeAcquireLockExclusiveRaise ( &colorlist^.Lock )

            entry := colorlist^.Head.Next

            IF entry != &colorlist^.Head THEN
                // Found one. Pop it from the head.

                RtlRemoveEntryList ( entry )

                KeIncrementPtr (
                    &list^.Count, // ptr
                    -1, // inc
                )

                KeReleaseLockLower ( &colorlist^.Lock, ipl )

                RETURN CONTAINEROF entry TO MmpPfe.Entry
            END

            KeReleaseLockLower ( &colorlist^.Lock, ipl )
        END

        color = (color + 1) & (MMP_COLOR_COUNT - 1)
        i += 1
    END

    RETURN NULLPTR
END

FN MmpAllocatePageFromStandbyList (
    IN mmnode : ^MmpNode,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page from the given standby list.

    list := &mmnode^.StandbyList

    pfe : ^MmpPfe
    colorlist : ^MmpAvailablePageListColor
    ipl : UWORD
    object : ^MmuObject

    i := 0

    WHILE TRUE DO
        colorlist = &list^.Colors[color]

        IF NOT RtlEmptyList ( &colorlist^.Head ) THEN
            ipl = KeAcquireLockExclusiveRaise ( &colorlist^.Lock )

            entry := colorlist^.Head.Next

            IF entry != &colorlist^.Head THEN
                pfe = CONTAINEROF entry TO MmpPfe.Entry

                // Found a page on this list. Capture its object and
                // disassociate it by clearing the object pointer. If a page
                // lookup within the object finds this page before we lock the
                // object below and fully clear the tracking PTE, it will find
                // that the object pointer has been cleared and will know that
                // we're executing this path and will clear the tracking PTE
                // itself. It will also increment a refcount on the object so
                // that we don't hold a stale pointer to it.

                object = pfe^.Object
                pfe^.Object = NULLPTR

                RtlRemoveEntryList ( &pfe^.Entry )

                KeIncrementPtr (
                    &list^.Count, // ptr
                    -1, // inc
                )

                KeReleaseLock ( &colorlist^.Lock )

                BREAK
            END

            KeReleaseLockLower ( &colorlist^.Lock, ipl )
        END

        color = (color + 1) & (MMP_COLOR_COUNT - 1)
        i += 1

        IF i >= MMP_COLOR_COUNT THEN
            RETURN NULLPTR
        END
    END

    unrefobject := FALSE

    // No need to call this as APC-safe since we're already blocking out APCs
    // since we didn't lower IPL when we released the colorlist lock.

    KeAcquireLockExclusive ( &object^.StructureLock )

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    IF pfe^.TrackingTableEntry == NULLPTR THEN
        // A concurrent page lookup cleared the tracking table entry after
        // noticing that we were in the middle of stealing this page. It added a
        // reference to the object to stop our pointer to it from becoming
        // stale, which we will need to unreference below.

        unrefobject = TRUE

    ELSE
        MmpClearTrackingTableEntry (
            object, // object
            pfe, // pfe
        )
    END

    KeReleaseLockLower ( &object^.StructureLock, ipl )

    IF unrefobject THEN
        MmpUnreferenceObject (
            object, // object
            TRUE, // defer
        )
    END

    RETURN pfe
END

FN MmpReferencePage (
    IN pfe : ^MmpPfe,
)

    // Increment the reference count on the page. This must be a page
    // with a refcount that is already non-zero. Pages on the standby and
    // modified list are only taken off them by reclamation (standby only),
    // modified page writing (modified only), or object lookup (either).

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    KeAssert ( pfe^.References != 0 )

    KeIncrementUlong (
        &pfe^.References, // ptr
        1, // inc
    )
END

FN MmpUnreferencePage (
    IN pfe : ^MmpPfe,
)

    // Decrement the page's reference count.

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    refcount := pfe^.References

    KeAssert ( refcount != 0 )

    WHILE TRUE DO
        IF refcount == 1 THEN
            // If this is the last reference, then special handling is required
            // in order to place the page on a list.

            BREAK
        END

        new := KeCompareSwapUlong (
            &pfe^.References, // ptr
            refcount - 1, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            LEAVE
        END

        refcount = new
    END

    // Acquire the page lock to block out concurrent modifications of the packed
    // flags that may affect which list it is supposed to go to now.

    ipl := KeAcquireLockExclusiveRaise ( &pfe^.Lock )

    packed := pfe^.Packed

    IF MmpGetPackedFlag ( packed, MMP_DELETED_PFE_FLAG ) THEN
        // The page was deleted, so it must be freed now that the last reference
        // has gone away.

        KeReleaseLockLower ( &pfe^.Lock, ipl )

        MmpFreePage ( pfe )

        LEAVE
    END

    mmnode := KeNumaNodeById ( MmpGetPackedNodeId ( packed ) )^.Mmp

    IF MmpGetPackedFlag ( packed, MMP_MODIFIED_PFE_FLAG ) THEN
        // The page was modified, so it must be placed on the modified page
        // list for its home node.

        KeAcquireLockExclusive ( &mmnode^.ModifiedListLock )

        refcount = KeIncrementUlong (
            &pfe^.References, // ulong
            0xFFFFFFFF, // inc
        )

        IF refcount == 1 THEN
            RtlInsertAtTailList (
                &mmnode^.ModifiedListHead, // listhead
                &pfe^.Entry, // entry
            )

            mmnode^.ModifiedPageCount += 1
        END

        // The order of releasing the page lock and list lock is important
        // because we dropped our refcount, so it is no longer safe to touch
        // the page lock after we release the list lock.

        KeReleaseLock ( &pfe^.Lock )

        KeReleaseLockLower ( &mmnode^.ModifiedListLock, ipl )

        IF mmnode^.ModifiedPageCount >= mmnode^.ModifiedPageMaximum AND
            mmnode^.ModifiedPageEvent.Header.SignalCount == 0 THEN

            // The modified page list is longer than the limit, so signal the
            // modified page writer.

            KeSignalEvent (
                &mmnode^.ModifiedPageEvent, // event
                0, // priorityboost
            )
        END

        LEAVE
    END

    // The page was neither deleted nor modified, so put it on the standby list.

    color := MmpPfnColor ( MmpPfeToPfn ( pfe ) )
    colorlist := &mmnode^.StandbyList.Colors[color]

    KeAcquireLockExclusive ( &colorlist^.Lock )

    refcount = KeIncrementUlong (
        &pfe^.References, // ulong
        0xFFFFFFFF, // inc
    )

    IF refcount == 1 THEN
        RtlInsertAtTailList (
            &colorlist^.Head, // listhead
            &pfe^.Entry, // listentry
        )

        KeIncrementPtr (
            &mmnode^.StandbyList.Count, // ptr
            1, // inc
        )

        // The order of releasing the page lock and list lock is important
        // because we dropped our refcount, so it is no longer safe to touch
        // the page lock after we release the list lock.

        KeReleaseLock ( &pfe^.Lock )

        KeReleaseLockLower ( &colorlist^.Lock, ipl )

        KeuIncrementQuantityQueue (
            &mmnode^.AvailablePageQuantityQueue, // queue
            1, // amount
        )

        LEAVE
    END

    // The order of releasing the page lock and list lock is important
    // because we dropped our refcount, so it is no longer safe to touch
    // the page lock after we release the list lock.

    KeReleaseLock ( &pfe^.Lock )

    KeReleaseLockLower ( &colorlist^.Lock, ipl )
END

FN MmpAllocatePageReserved (
    IN mmnode : ^MmpNode,
    IN flags : UWORD,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page from the given node.
    // The caller has reserved an available page count from this node and there
    // is a guarantee that there is a page somewhere.

    color &= MMP_COLOR_COUNT - 1

    pfe : ^MmpPfe

    mustzero := FALSE

    IF flags & MM_ALLOCATE_ZERO THEN
        IF mmnode^.ZeroList.Count THEN
            pfe = MmpAllocatePageFromList (
                &mmnode^.ZeroList, // list
                color, // color
            )

        ELSE
            // Need to grab a free or standby page. Make sure to zero out the
            // page outside the list lock.

            mustzero = TRUE

            IF mmnode^.FreeList.Count THEN
                pfe = MmpAllocatePageFromList (
                    &mmnode^.FreeList, // list
                    color, // color
                )

            ELSE
                pfe = MmpAllocatePageFromStandbyList (
                    mmnode, // mmnode
                    color, // color
                )
            END
        END

    ELSEIF mmnode^.FreeList.Count THEN
        pfe = MmpAllocatePageFromList (
            &mmnode^.FreeList, // list
            color, // color
        )

    ELSEIF mmnode^.ZeroList.Count THEN
        pfe = MmpAllocatePageFromList (
            &mmnode^.ZeroList, // list
            color, // color
        )

    ELSE
        pfe = MmpAllocatePageFromStandbyList (
            mmnode, // mmnode
            color, // color
        )
    END

    // Should not be possible to fail to get a page since we have a guarantee
    // that there is a page on some list.

    KeAssert ( pfe != NULLPTR )

#IF BLD_CHK
    pfe^.Packed = MmpPackType ( pfe^.Packed, MMP_IN_USE_PFE_TYPE )
#END

    IF mustzero THEN
        MmZeroPage (
            MmpPfeToPfn ( pfe ), // pfn
            0, // offset
            RTL_PAGE_SIZE, // length
        )
    END

    RETURN pfe
END

FN MmpFreePage (
    IN pfe : ^MmpPfe,
)

    // Free the page.

    packed := pfe^.Packed

#IF BLD_CHK
    pfe^.Packed = MmpPackType ( packed, MMP_FREE_PFE_TYPE )
#END

    mmnode := KeNumaNodeById ( MmpGetPackedNodeId ( packed ) )^.Mmp

    // Insert at the head so that we reuse it more quickly (hot in cache).

    count := MmpInsertPageIntoList (
        &mmnode^.FreeList, // list
        pfe, // pfe
        TRUE, // head
    )

    KeuIncrementQuantityQueue (
        &mmnode^.AvailablePageQuantityQueue, // queue
        1, // amount
    )

    IF count > mmnode^.ZeroingThreshold AND
        mmnode^.ZeroPageEvent.Header.SignalCount == 0 THEN

        // Wake the zero page worker.

        KeSignalEvent (
            &mmnode^.ZeroPageEvent, // event
            0, // priorityboost
        )
    END
END

FN MmpAllocatePageFromReserve (
    IN flags : UWORD,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page from the thread's page reserve.
    // Returns NULLPTR if the thread ran out of page reserve.

    thread := PsCurrentThread ()
    reserve := &thread^.ReservedPages[thread^.Tcb.ExecutingKapc]
    count := reserve^.Count

    KeAssert ( count != 0 )

    reserve^.Count = count - 1

#IF BLD_NUMA
    mmnode := reserve^.Node

    IF count == 1 THEN
        // Count is now zero so clear the node to allow the next reserve to
        // reserve from any node.

        reserve^.Node = NULLPTR
    END
#ELSE
    mmnode := MmCurrentAffinityNode ()
#END

    RETURN MmpAllocatePageReserved (
        mmnode, // mmnode
        flags, // flags
        color, // color
    )
END

FN MmpAllocatePageUnreserved (
    IN mmnode : ^MmpNode,
    IN flags : UWORD,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page that has not yet been reserved.
    // Returns NULLPTR if reserving the page fails.

    status := MmpClaimAvailablePages (
        mmnode, // mmnode
        1, // pages
        flags, // flags
        NULLPTR, // timeout
        OUT mmnode, // actualnode
    )

    IF OsError ( status ) THEN
        // Failed to claim an available page.

        RETURN NULLPTR
    END

    // Got a count, so allocate the page.

    RETURN MmpAllocatePageReserved (
        mmnode, // mmnode
        flags, // flags
        color, // color
    )
END