#MACRO MmpAddressToDynamicSpaceVpn ( mmnode, address ) [
    (CAST ((address) - (mmnode)^.DynamicSpaceBase) >> RTL_PAGE_SHIFT TO UWORD)
]

#MACRO MmpAddressToVpe ( mmnode, address ) [
    (CAST (mmnode)^.VpnDbBase +
    (MmpAddressToDynamicSpaceVpn ( mmnode, address ) *
    MMP_VPE_SIZE) TO ^MmpVpe)
]

#MACRO MmpVpeToDynamicSpaceVpn ( mmnode, vpe ) [
    (CAST (vpe - (mmnode)^.VpnDbBase) / MMP_VPE_SIZE TO UWORD)
]

#MACRO MmpVpeToAddress ( mmnode, vpe ) [
    (CAST (MmpVpeToDynamicSpaceVpn ( mmnode, vpe ) << RTL_PAGE_SHIFT) +
        (mmnode)^.DynamicSpaceBase TO ^VOID)
]

STRUCT MmpVpeObjectConsumer
    SlabControl : ^MmpVpe,
    SlabListEntry : RtlListEntry,
    FreeListHead : ^^VOID,
    Tag : ULONG,
    InUseObjects : UINT,
    PoolCacheIndex1 : UBYTE,
    PoolCacheIndex2 : UBYTE,
END

UNION MmpVpeConsumerData
    ObjectCache : MmpVpeObjectConsumer,
END

STRUCT MmpVpe
    DynamicSpaceArenaTag : ^ExpArenaTag,
    MappedArenaTag : ^ExpArenaTag,
    U : MmpVpeConsumerData,
END

