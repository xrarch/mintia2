#MACRO MmpPfnColor ( pfn ) [
    ((pfn) & (MMP_COLOR_COUNT - 1))
]

#MACRO MmpVirtualAddressColor ( vaddr ) [
    ((vaddr >> RTL_PAGE_SHIFT) & (MMP_COLOR_COUNT - 1))
]

STRUCT MmpPagefileState
    CommitRemaining : WORD,
    CommitWishList : UWORD,

KE_CACHE_LINE_END

    CommitLimit : UWORD,
    CommitLimitGrowthLeft : UWORD,
    EmergencyCommitMinimum : UWORD,
    CommitRemainingMinimum : UWORD,
END

// 32, 64, 96, 160, 256, 384, 576, 864, 1312, 1984, 2976
#DEFINE MMP_NUMBER_POOL_BUCKETS 11

STRUCT MmpNode
    VpnDbLock : KeLock,

KE_CACHE_LINE_END

    VpnDbBase : ^VOID,
    VpnDbCounters : ^ULONG,
    VpnDbFilter : ^ULONG,
    VpnDbPages : UWORD,

KE_CACHE_LINE_END

    ModifiedListLock : KeLock,

KE_CACHE_LINE_END

    ModifiedListHead : RtlListEntry,
    ModifiedPageCount : UWORD,

KE_CACHE_LINE_END

    FreeList : MmpAvailablePageList,
    ZeroList : MmpAvailablePageList,
    StandbyList : MmpAvailablePageList,

KE_CACHE_LINE_END

    AvailablePageCount : WORD,

#IF BLD_MP

KE_CACHE_LINE_END

    DynamicPagesPendingFLush : UWORD,

#END

KE_CACHE_LINE_END

    BorrowCounts : ^UINT,

    DynamicSpaceBase : ^VOID,
    PagefileState : ^MmpPagefileState,
    MdlCache : ^MmpObjectCache,
    DynamicSpaceArena : ^ExpArena,
    MappedArenas : ^ExpArena[2],

    PoolCaches : ^MmpObjectCache[2][MMP_NUMBER_POOL_BUCKETS],

    QuickPteBase : ^MmpPte,

    QuickPteBlocks : ^MmpQuickPteBlock,

    KeNode : ^KeuNode,

    TotalPages : UWORD,

    LowPageCount : UWORD,
    SufficientPageCount : UWORD,
    ModifiedPageMaximum : UWORD,
    ZeroingThreshold : UWORD,

    FluidPageCount : UWORD,

    SizeLevel : UBYTE,
    Id : UBYTE,

KE_CACHE_LINE_END

    ObjectCacheListLock : KeLock,
    ObjectCacheCache : ^MmpObjectCache,
    PreallocatedObjectCaches : ^MmpObjectCache,
    PreallocatedObjectCacheIndex : UWORD,

KE_CACHE_LINE_END

    PgCacheAdjustItem : ExWorkItem,
    PgCacheAdjustActive : UBYTE,

KE_CACHE_LINE_END

    LowMemoryEvent : KE_CACHE_LINE KeEvent,
    PageAvailableEvent : KE_CACHE_LINE KeEvent,
    LowPageAvailableEvent : KE_CACHE_LINE KeEvent,
    ModifiedPageEvent : KE_CACHE_LINE KeEvent,
    ZeroPageEvent : KE_CACHE_LINE KeEvent,

KE_CACHE_LINE_END

    KernelStackPteListHead : ^MmpPte,
    KernelStackPteListLock : KeLock,
    KernelStacksOnList : ULONG,
    KernelStacksNeeded : ULONG,
END

