#MACRO MmpAcquireObjectExclusive ( object ) [
    KeAcquireLockExclusiveRaise ( &(object)^.Pushlock )
]

#MACRO MmpAcquireObjectShared ( object ) [
    KeAcquireLockSharedRaise ( &(object)^.Pushlock )
]

#MACRO MmpReleaseObject ( object, ipl ) [
    KeReleaseLockLower ( &(object)^.Pushlock, ipl )
]

