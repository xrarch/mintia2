#MACRO MmpNodeToProcess ( mmnode ) [
    ((mmnode)^.KeNode^.SystemProcess)
]

#MACRO MmpNodeToKeProcess ( mmnode ) [
    (&MmpNodeToProcess ( mmnode )^.Pcb)
]

#MACRO MmpKeProcessToNode ( process ) [
    ((process)^.Node^.Mmp)
]

// Number of times node A borrows page frames from node B that is significant
// enough to justify node B signaling node A to free up pages when it runs low.

#DEFINE MMP_SIGNIFICANT_BORROWS 300

// Layout of the Packed field of MmpPfe:
//
// 0-3: Type code
// 4-7: Various flags
// 20-31: NUMA node ID

#DEFINE MMP_PACKED_TYPE_MASK 0xF
#DEFINE MMP_PACKED_TYPE_SHIFT 0

#DEFINE MMP_PACKED_NODE_SHIFT 20
#DEFINE MMP_PACKED_NODE_MASK 0xFFF00000

#DEFINE MMP_UNINITIALIZED_PFE_TYPE 0
#DEFINE MMP_FREE_PFE_TYPE 1
#DEFINE MMP_IN_USE_PFE_TYPE 2

#DEFINE MMP_PACKED_FLAG_FIRST_BIT 4

#DEFINE MMP_MODIFIED_PFE_FLAG 1
#DEFINE MMP_DELETED_PFE_FLAG 2
#DEFINE MMP_PAGED_EXEC_PFE_FLAG 4

#MACRO MmpPackType ( packed, type ) [
    // Compute a 32-bit Packed value containing the specified type code.
    (((packed) & ~MMP_PACKED_TYPE_MASK) | (type << MMP_PACKED_TYPE_SHIFT))
]

#MACRO MmpGetPackedType ( packed ) [
    (((packed) & MMP_PACKED_TYPE_MASK) >> MMP_PACKED_TYPE_SHIFT)
]

#MACRO MmpSetPackedFlag ( packed, flag ) [
    ((packed) | ((flag) << MMP_PACKED_FLAG_FIRST_BIT))
]

#MACRO MmpClearPackedFlag ( packed, flag ) [
    ((packed) & ~((flag) << MMP_PACKED_FLAG_FIRST_BIT))
]

#MACRO MmpGetPackedFlag ( packed, flag ) [
    ((packed) & ((flag) << MMP_PACKED_FLAG_FIRST_BIT))
]

#MACRO MmpGetPackedNodeId ( packed ) [
    ((packed) >> MMP_PACKED_NODE_SHIFT)
]

#MACRO MmpPackNodeId ( packed, nodeid ) [
    (((packed) & ~MMP_PACKED_NODE_MASK) | ((nodeid) << MMP_PACKED_NODE_SHIFT))
]

STRUCT MmpPfe
    TrackingTableEntry : ^MmpPte,
    Object : ^MmuObject,
    OffsetInObject : RtlUquad,
    Backing : MmpPte,
    Entry : RtlListEntry,
    Lock : KeLock,

    References : ULONG,
    Packed : ULONG,
END

STRUCT MmpAvailablePageListColor
    Lock : KE_CACHE_LINE KeLock,
    Head : RtlListEntry,
END

STRUCT MmpAvailablePageList
    Colors : MmpAvailablePageListColor[MMP_COLOR_COUNT],
    Count : UWORD,
END

EXTERN FN MmpIncrementAvailablePages (
    IN mmnode : ^MmpNode,
    IN increment : UWORD,
) : WORD

EXTERN MmpSystemSize : UWORD

#MACRO MmpFindPfnDatabase () [
    (KeCurrentVolatileNode ()^.PfnDatabase)
]

#MACRO MmpPfnToPfe ( pfn ) [
    (CAST ((pfn) * MMP_PFE_SIZE) + MmpFindPfnDatabase() TO ^MmpPfe)
]

#MACRO MmpPfeToPfn ( pfe ) [
    (CAST (((pfe) - MmpFindPfnDatabase()) / MMP_PFE_SIZE) TO UWORD)
]

