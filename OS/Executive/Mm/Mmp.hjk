END

STRUCT MmpNode
    DynamicSpaceLock : KeLock,

KE_CACHE_LINE_END

    DynamicSpaceBitmap : RtlBitmapHeader,
    DynamicSpaceHint : UWORD,
    DynamicSpaceBase : ^VOID,

KE_CACHE_LINE_END

    DynamicSpaceTreeLock : KeLock,

KE_CACHE_LINE_END

    DynamicSpaceRoot : RtlAvlNode,

KE_CACHE_LINE_END

    ModifiedListLock : KeLock,

KE_CACHE_LINE_END

    ModifiedListHead : RtlListEntry,
    ModifiedPageCount : UWORD,

KE_CACHE_LINE_END

    FreeList : MmpAvailablePageList,
    ZeroList : MmpAvailablePageList,
    StandbyList : MmpAvailablePageList,

KE_CACHE_LINE_END

    AvailablePageCount : WORD,

KE_CACHE_LINE_END

    BorrowCounts : ^UINT,

    PagefileState : ^MmpPagefileState,
    SpaceNodeCache : ^MmpPoolCache,
    MdlCache : ^MmpPoolCache,

    PoolTable : ^MmpPool[MM_MAXIMUM_POOL],

    QuickPteBase : ^MmpPte,

    QuickPteBlocks : ^MmpQuickPteBlock,

    KeNode : ^KeuNode,

    TotalPages : UWORD,

    LowPageCount : UWORD,
    SufficientPageCount : UWORD,
    ModifiedPageMaximum : UWORD,
    ZeroingThreshold : UWORD,

    FluidPageCount : UWORD,

    MagazineTypeTable : MmpMagazineType[MMP_MAGAZINE_MAX],

    SizeLevel : UBYTE,
    Id : UBYTE,

KE_CACHE_LINE_END

    PgPoolCacheAdjustItem : ExWorkItem,

    PgPoolCacheAdjustActive : UBYTE,
    CacheSpaceChunkPages : UBYTE,

KE_CACHE_LINE_END

    LowMemoryEvent : KE_CACHE_LINE KeEvent,
    PageAvailableEvent : KE_CACHE_LINE KeEvent,
    LowPageAvailableEvent : KE_CACHE_LINE KeEvent,
    ModifiedPageEvent : KE_CACHE_LINE KeEvent,
    ZeroPageEvent : KE_CACHE_LINE KeEvent,

KE_CACHE_LINE_END

    PoolSpace : KE_CACHE_LINE MmpChunkSpace,
    CacheSpace : KE_CACHE_LINE MmpChunkSpace,

KE_CACHE_LINE_END

    KernelStackPteListHead : ^MmpPte,
    KernelStackPteListLock : KeLock,
    KernelStacksOnList : ULONG,
    KernelStacksNeeded : ULONG,

KE_CACHE_LINE_END

    PoolRecords : MmpPool[MM_MAXIMUM_POOL],

    PoolCacheSlabs : MmpSlabCache,
    SlabCacheSlabs : MmpSlabCache,

    NpPoolCacheList : MmpPoolCacheList,
    PgPoolCacheList : MmpPoolCacheList,

#IF BLD_MP
    BatchedShootdowns : ^MmpBatchedShootdownTable,
    AlternateBatchedShootdowns : ^MmpBatchedShootdownTable,
    FlushShootdownLock : KeLock,
    HasPendingFlushes : UBYTE,
#END

END

