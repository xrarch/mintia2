//
// Implements the virtual page number database (VPNDB) for the MINTIA memory
// manager. This is a virtually linear and sparse array of metadata structures,
// indexed by VPN within dynamic space and containing information about that
// page of pool (such as used entry counts for tables contained therein, or slab
// cache information).
//
// An entry is called a virtual page entry or VPE.
//

#INCLUDE "Mmp.hjk"

#MACRO MmpVpnDbHash ( vpn ) [
    ((((vpn) >> 15) $ ((vpn) >> 10) $ ((vpn) >> 5) $ (vpn)) & 31)
]

#SECTION "INITtext"
FN MmpInitializeVpnDb (
    IN kenode : ^KeuNode,
)

    // Initialize the virtual page number database.

    mmnode := kenode^.Mmp

    mmnode^.VpnDbBase = kenode + KE_VPN_DB_OFFSET
    mmnode^.VpnDbCounters = kenode^.VpnDbCounters

    i := 0

    WHILE i < MMP_VPN_DB_RECLAIM_BUCKETS DO
        KeInitializeLock (
            &mmnode^.VpnDbReclaimBuckets[i].Lock, // lock
            "VpnDbReclaimBucket", // name
        )

        RtlInitializeList ( &mmnode^.VpnDbReclaimBuckets[i].ListHead )

        i += 1
    END
END

FN MmpReferenceVpnDbPage (
    IN mmnode : ^MmpNode,
    IN vpndbpage : UWORD,
    IN count : UWORD,
    IN flags : UWORD,
) : OsStatus

    // Reference the specified vpndb page with the specified count of VPEs.

    vpe := CAST mmnode^.VpnDbBase + (vpndbpage << RTL_PAGE_SHIFT) TO ^MmpVpe
    counter := &mmnode^.VpnDbCounters[vpndbpage]

    refcount := counter^

@Retry

    WHILE TRUE DO
        IF refcount <= 1 THEN
            // A reference count of 0 means there is no physical page backing
            // this VPNDB page.
            //
            // A reference count of 1 means it is reclaimable and we need to
            // remove it from the reclaimable list first.
            // 
            // In either case, break out and do it under the bucket lock.

            BREAK
        END

        // Try to atomically increment the refcount.

        new := KeCompareSwapUlong (
            counter, // ptr
            refcount + count, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            RETURN OS_STATUS_SUCCESS
        END

        // Something changed, so retry.

        refcount = new
    END

    ipl : UWORD
    pfe : ^MmpPfe
    bucket := &mmnode^.VpnDbReclaimBuckets[MmpVpnDbHash ( vpndbpage )]
    pteaddr := MmpPteAddress ( vpe )

    IF refcount == 1 THEN
        // Try to remove the page from the reclaimable list.

        ipl = KeAcquireLockExclusiveRaise ( &bucket^.Lock )

        IF counter^ != 1 THEN
            // Something changed, so retry.

            KeReleaseLockLower ( &bucket^.Lock, ipl )

            GOTO Retry
        END

        // Find the PFE.

        ptecontents := pteaddr^

        KeAssert ( MmpIsPteValid ( ptecontents ) )

        pfe = MmpPfnToPfe ( MmpPfnFromPte ( ptecontents ) )

        // Remove it from the reclaimable list.

        RtlRemoveEntryList ( &pfe^.Entry )

        // Increment the counter to 2 to reflect one VPE.

        counter^ = 2

        KeReleaseLockLower ( &bucket^.Lock, ipl )

        RETURN OS_STATUS_SUCCESS
    END

    // The refcount was 0, so we need to create a new VPNDB page.
    // Charge commit for the new VPNDB page.

    status := MmuAddPageReservation (
        1, // minimum
        1, // maximum
        flags, // flags
        OUT: junk, // actual
    )

    IF OsError ( status ) THEN
        // Failed to reserve.

        RETURN status
    END

    pfe = MmpAllocatePageFromReserve (
        flags, // flags
        MmpVirtualAddressColor ( vpe ), // color
    )

@RetryAcquire

    ipl = KeAcquireLockExclusiveRaise ( &bucket^.Lock )

    IF counter^ != 0 THEN
        // The value of the counter changed, so retry.

        KeReleaseLockLower ( &bucket^.Lock, ipl )

        MmpFreePage ( pfe )

        MmuUnchargeCommit (
            mmnode, // mmnode
            1, // pages
        )

        GOTO Retry
    END

#IF BLD_MP
    IF pteaddr^ == MMP_PENDING_FLUSH_PTE THEN
        // The PTE is still pending flush, so flush it now.

        KeReleaseLockLower ( &bucket^.Lock, ipl )

        KeuFlushShootdowns ( MmpNodeToKeProcess ( mmnode ) )

        GOTO RetryAcquire
    END
#END

    KeAssert ( pteaddr^ == MMP_INVALID_KERNEL_PTE )

    pfe^.U.VpnDb.VirtualAddress = vpe & RTL_PAGE_NUMBER_MASK

    pteaddr^ = MmpBuildPoolPte ( MmpPfeToPfn ( pfe ) )

    // Write memory barrier to ensure that the VPN DB page mapping is visible
    // to other processors before we publish it by setting the counter to 2.

    KeWriteMemoryBarrier ()

    // Set the refcount to 1 + count.
    // 1 for existence of the physical page, plus the existence of each VPE.

    counter^ = 1 + count

    KeReleaseLockLower ( &bucket^.Lock, ipl )

    RETURN OS_STATUS_SUCCESS
END

FN MmpReferenceVpe (
    IN vpe : ^MmpVpe,
)

    // Increment the refcount of a VPE whose containing page is known to exist.

    mmnode := KeNumaNodeFromSpacePointer ( vpe )^.Mmp

    oldcount := KeIncrementUlong (
        &mmnode^.VpnDbCounters[(vpe - mmnode^.VpnDbBase) >> RTL_PAGE_SHIFT],
        1, // inc
    )

    KeAssert ( oldcount >= 2 )
END

FN MmpUnreferenceVpnDbPage (
    IN mmnode : ^MmpNode,
    IN vpndbpage : UWORD,
    IN count : UWORD,
)

    // Unreference a VPN DB page.

    counter := &mmnode^.VpnDbCounters[vpndbpage]

    refcount := counter^

    WHILE TRUE DO
        // This operation should leave at least 1 reference, since there's a
        // physical page.

        KeAssert ( refcount != 0 )
        KeAssert ( count <= refcount - 1 )

        IF refcount - count == 1 THEN
            // We're about to drop the reference count to 1, so we will need to
            // put the page on the reclaimable bucket.

            BREAK
        END

        // Try to atomically decrement the refcount.

        new := KeCompareSwapUlong (
            counter, // ptr
            refcount - count, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            LEAVE
        END

        // Something changed, so retry.

        refcount = new
    END

    bucket := &mmnode^.VpnDbReclaimBuckets[MmpVpnDbHash ( vpndbpage )]

    vpe := CAST mmnode^.VpnDbBase + (vpndbpage << RTL_PAGE_SHIFT) TO ^MmpVpe
    pteaddr := MmpPteAddress ( vpe )

    ipl := KeAcquireLockExclusiveRaise ( &bucket^.Lock )

    // Decrement under the lock.

    oldcount := KeIncrementUlong (
        counter, // ptr
        -count, // inc
    )

    IF oldcount == refcount THEN
        // Nobody incremented the reference count in the time it took us to take
        // the lock, so we should put the page on the reclaim list.

        ptecontents := pteaddr^

        KeAssert ( MmpIsPteValid ( ptecontents ) )

        pfe := MmpPfnToPfe ( MmpPfnFromPte ( ptecontents ) )

        RtlInsertAtTailList (
            &bucket^.ListHead, // listhead
            &pfe^.Entry, // listentry
        )
    END

    KeReleaseLockLower ( &bucket^.Lock, ipl )
END

FN MmpUnreferenceVpes (
    IN mmnode : ^MmpNode,
    IN address : ^VOID,
    IN pages : UWORD,
) : OsStatus

    // Unreference the specified number of VPEs.
    // We want to reduce the number of CAS operations on the VPNDB reference
    // counter, so we allow unreferencing ranges of VPEs at a time here.

    vpn := MmpAddressToDynamicSpaceVpn ( mmnode, address )

    KeAssert ( vpn < mmnode^.KeNode^.DynamicSpaceSize )
    KeAssert ( vpn + pages < mmnode^.KeNode^.DynamicSpaceSize )

    WHILE pages DO
        vpndbpage := (vpn * MMP_VPE_SIZE) >> RTL_PAGE_SHIFT

        max := (RTL_PAGE_SIZE / MMP_VPE_SIZE) -
            (vpn & ((RTL_PAGE_SIZE / MMP_VPE_SIZE) - 1))

        IF max > pages THEN
            max = pages
        END

        MmpUnreferenceVpnDbPage (
            mmnode, // mmnode
            vpndbpage, // vpndbpage
            max, // count
        )

        vpn += max
        pages -= max
    END
END

FN MmpUnreferenceVpe (
    IN vpe : ^MmpVpe,
)

    // Decrement the refcount of a VPE whose containing page is known to exist.

    // If this drops the refcount of the containing VPNDB page to 1, then it is
    // eligible for garbage collection on the next scan.

    mmnode := KeNumaNodeFromSpacePointer ( vpe )^.Mmp
    vpn := MmpVpeToDynamicSpaceVpn ( mmnode, vpe )

    MmpUnreferenceVpnDbPage (
        mmnode, // mmnode
        (vpn * MMP_VPE_SIZE) >> RTL_PAGE_SHIFT, // vpndbpage
        1, // count
    )
END

FN MmpCreateVpes (
    IN mmnode : ^MmpNode,
    IN address : ^VOID,
    IN pages : UWORD,
    IN flags : UWORD,
) : OsStatus

    // Create the specified number of VPEs.
    // We want to reduce the number of CAS operations on the VPNDB reference
    // counter, so we allow creating ranges of VPEs at a time here.

    vpn := MmpAddressToDynamicSpaceVpn ( mmnode, address )

    KeAssert ( vpn < mmnode^.KeNode^.DynamicSpaceSize )
    KeAssert ( vpn + pages < mmnode^.KeNode^.DynamicSpaceSize )

    curvpn := vpn
    i := 0

    WHILE i < pages DO
        vpndbpage := (curvpn * MMP_VPE_SIZE) >> RTL_PAGE_SHIFT

        max := (RTL_PAGE_SIZE / MMP_VPE_SIZE) -
            (curvpn & ((RTL_PAGE_SIZE / MMP_VPE_SIZE) - 1))

        IF max > pages - i THEN
            max = pages - i
        END

        status := MmpReferenceVpnDbPage (
            mmnode, // mmnode
            vpndbpage, // vpndbpage
            max, // count
            flags, // flags
        )

        IF OsError ( status ) THEN
            // Failed to create, so back out and undo the increments we
            // already did.

            IF i THEN
                MmpUnreferenceVpes (
                    mmnode, // mmnode
                    address, // address
                    i, // pages
                )
            END

            RETURN status
        END

        curvpn += max
        i += max
    END

    RETURN OS_STATUS_SUCCESS
END

FN MmpCreateVpe (
    IN mmnode : ^MmpNode,
    IN address : ^VOID,
    IN flags : UWORD,
) : OsStatus

    // Create a single VPE.

    vpn := MmpAddressToDynamicSpaceVpn ( mmnode, address )

    RETURN MmpReferenceVpnDbPage (
        mmnode, // mmnode
        (vpn * MMP_VPE_SIZE) >> RTL_PAGE_SHIFT, // vpndbpage
        1, // count
        flags, // flags
    )
END

#IF BLD_MP

FN (KeuAfterShootdownF) MmpFlushVpnDb (
    IN process : ^KeuProcess,
    IN context : ^VOID,
    IN ptr : ^VOID,
    IN pages : UWORD,
)

    // Perform work required after a batched shootdown occurred that shot down
    // a range of VPN DB pages.

    pteaddr := MmpPteAddress ( ptr )
    i := 0

    WHILE i < pages DO
        ptecontents := pteaddr[i]

        KeAssert ( ptecontents == MMP_PENDING_FLUSH_PTE )

        pteaddr[i] = MMP_INVALID_KERNEL_PTE

        i += 1
    END
END

#END

FN MmpGarbageCollectVpnDb (
    IN mmnode : ^MmpNode,
)

    // Garbage collect unused pages in the VPN DB. This is done lazily rather
    // than reclaiming the pages eagerly in order to minimize TB shootdowns.

    // This process involves scanning each of 32 reclamation buckets and freeing
    // any VPN DB pages found on each of them.

    counters := mmnode^.VpnDbCounters

    base := mmnode^.VpnDbBase

    ptes := MmpPteAddress ( base )

    pages := ((mmnode^.KeNode^.DynamicSpaceSize * MMP_VPE_SIZE) +
        RTL_PAGE_SIZE - 1) >> RTL_PAGE_SHIFT

    i := 0

    WHILE i < MMP_VPN_DB_RECLAIM_BUCKETS DO
        bucket := &mmnode^.VpnDbReclaimBuckets[i]
        listhead := &bucket^.ListHead

        WHILE NOT RtlEmptyList ( listhead ) DO
            // This bucket appears to have reclaimable pages on it, so lock it
            // and reclaim one.

@Retry

            ipl := KeAcquireLockExclusiveRaise ( &bucket^.Lock )

            IF RtlEmptyList ( listhead ) THEN
                // Nevermind.

                GOTO NextBucket
            END

            pfe := CONTAINEROF listhead^.Next TO MmpPfe.Entry

            vaddr := pfe^.U.VpnDb.VirtualAddress
            page := (vaddr - base) >> RTL_PAGE_SHIFT

            // This page of VPN DB is reclaimable, so its counter should be
            // 1. This means that it still has a physical page mapped to it
            // but has no outstanding entries inside of it.

            KeAssert ( counters[page] == 1 )

            counters[page] = 0

            // Decremented the count to zero, so now we can reclaim.

            ptecontents := ptes[page]

            KeAssert ( MmpIsPteValid ( ptecontents ) )

#IF BLD_MP
            // Set the PTE to indicate the flushing of this VPN from the TB
            // is currently in a deferred batch.

            ptes[page] = MMP_PENDING_FLUSH_PTE

            IF NOT KeuBatchShootdown (
                MmpNodeToKeProcess ( mmnode ), // process
                NULLPTR, // context
                vaddr, // ptr
                1, // pages
                &MmpFlushVpnDb, // callback
                FALSE, // canflush
            ) THEN

                // Oops, nevermind. We ran out of batched shootdown slots
                // and don't want to flush them while holding the bucket
                // lock, so we have to undo what we just did and then flush
                // manually while outside of it.

                ptes[page] = ptecontents

                counters[page] = 1

                KeReleaseLockLower ( &bucket^.Lock, ipl )

                KeuFlushShootdowns ( MmpNodeToKeProcess ( mmnode ) )

                GOTO Retry
            END
#ELSE
            // Clear the PTE and flush the virtual page.

            ptes[page] = MMP_INVALID_KERNEL_PTE

            KeuFlushMyTbAddress ( vaddr )
#END

            // Remove the PFE from the reclaimable list.

            RtlRemoveEntryList ( &pfe^.Entry )

@NextBucket

            KeReleaseLockLower ( &bucket^.Lock, ipl )
        END

        i += 1
    END
END
