//
// Implements the virtual page number database (VPNDB) for the MINTIA memory
// manager. This is a virtually linear and sparse array of metadata structures,
// indexed by VPN within dynamic space and containing information about that
// page of pool (such as used entry counts for tables contained therein, or slab
// cache information).
//
// An entry is called a virtual page entry or VPE.
//

#INCLUDE "Mmp.hjk"

#SECTION "INITtext"
FN MmpInitializeVpnDb (
    IN kenode : ^KeuNode,
)

    // Initialize the virtual page number database.

    mmnode := kenode^.Mmp

    KeInitializeLock ( &mmnode^.VpnDbLock )

    mmnode^.VpnDbBase = kenode + KE_VPN_DB_OFFSET
    mmnode^.VpnDbCounters = kenode^.VpnDbCounters
    mmnode^.VpnDbFilter = kenode^.VpnDbFilter
END

FN MmpCreateVpe (
    IN mmnode : ^MmpNode,
    IN vpn : UWORD,
    IN flags : UWORD,
    OUT vpe : ^MmpVpe,
) : OsStatus

    // Return a pointer to the VPE for the given VPN within the given node's
    // dynamic space.

    KeAssert ( vpn < (KE_DYNAMIC_SPACE_SIZE >> RTL_PAGE_SHIFT) )

    vpe = MmpFindVpe ( mmnode, vpn )

    counter := &mmnode^.VpnDbCounters[vpn]

    refcount := counter^

@Retry

    WHILE TRUE DO
        IF refcount == 0 THEN
            // A reference count of 0 means there is no physical page backing
            // this VPNDB page. We need to break out and create one under a
            // lock.

            BREAK
        END

        // Try to atomically increment the refcount.

        new: = KeCompareSwapUlong (
            counter, // ptr
            refcount + 1, // newvalue
            refcount, // expectedvalue
        )

        IF new != refcount THEN
            // Something changed, so retry.

            refcount = new

            CONTINUE
        END

        IF refcount == 1 THEN
            // Old refcount was 1, and now its 2, so we are responsible for
            // decrementing the count in the filter. Note that this can
            // race but this is self-correcting as the racing threads leave,
            // and not a functional hazard as the filter is only used as
            // a hint by the garbage collection process.

            KeIncrementUlong (
                &mmnode^.VpnDbFilter[vpn / MMP_VPNDB_PER_FILTER], // ptr
                0xFFFFFFFF, // inc
            )
        END

        RETURN OS_STATUS_SUCCESS
    END

    // Charge commit for the new VPNDB page.

    status := MmuChargeCommit (
        mmnode, // mmnode
        1, // pages
        flags, // flags
    )

    IF OsError ( status ) THEN
        RETURN status
    END

@RetryCharged

    pfe := MmpAllocatePage (
        mmnode, // mmnode
        flags, // flags
        MmpVirtualAddressColor ( vpe ), // color
    )

    IF NOT pfe THEN
        // Failed to immediately allocate a page frame.

        IF flags & MM_ALLOCATE_WAIT THEN
            // Caller asked us to wait for a page if needed.

            MmpWaitForPages (
                mmnode, // mmnode
                flags & MM_ALLOCATE_LOW, // low
            )

            GOTO RetryCharged
        END

        MmuUnchargeCommit (
            mmnode, // mmnode
            1, // pages
        )

        RETURN OS_STATUS_NO_MEMORY
    END

@RetryAcquire

    ipl := KeAcquireLockExclusiveRaise ( &mmnode^.VpnDbLock )

    IF counter^ != 0 THEN
        // The value of the counter changed, so retry.

        KeReleaseLockLower ( &mmnode^.VpnDbLock, ipl )

        MmpFreePage ( pfe )

        MmuUnchargeCommit (
            mmnode, // mmnode
            1, // pages
        )

        GOTO Retry
    END

    pteaddr := MmpPteAddress ( vpe )

#IF BLD_MP
    IF pteaddr^ == MMP_PENDING_FLUSH_PTE THEN
        // The PTE is still pending flush, so flush it now.

        KeReleaseLockLower ( &mmnode^.VpnDbLock, ipl )

        MmpFlushShootdowns ( mmnode )

        GOTO RetryAcquire
    END
#END

    pteaddr^ = MmpBuildPoolPte ( MmpPfeToPfn ( pfe ) )

    // Write memory barrier to ensure that the VPN DB page mapping is visible
    // to other processors before we publish it by setting the counter to 2.

    KeWriteMemoryBarrier ()

    // Set the refcount to 2.
    // 1 for existence of the physical page, plus 1 for existence of our VPE.

    counter^ = 2

    KeReleaseLockLower ( &mmnode^.VpnDbLock, ipl )

    RETURN OS_STATUS_SUCCESS
END

FN MmpReferenceVpe (
    IN vpe : ^MmpVpe,
)

    // Increment the refcount of a VPE whose containing page is known to exist.

    mmnode := KeNumaNodeFromSpacePointer ( vpe )^.Mmp

    oldcount := KeIncrementUlong (
        &mmnode^.VpnDbCounters[(vpe - mmnode^.VpnDbBase) >> RTL_PAGE_SHIFT],
        1, // inc
    )

    KeAssert ( oldcount >= 2 )
END

FN MmpUnreferenceVpe (
    IN vpe : ^MmpVpe,
)

    // Decrement the refcount of a VPE whose containing page is known to exist.

    // If this drops the refcount of the containing VPNDB page to 1, then it is
    // eligible for garbage collection on the next scan.

    mmnode := KeNumaNodeFromSpacePointer ( vpe )^.Mmp
    vpn := (vpe - mmnode^.VpnDbBase) >> RTL_PAGE_SHIFT

    oldcount := KeIncrementUlong (
        &mmnode^.VpnDbCounters[vpn],
        0xFFFFFFFF, // inc
    )

    KeAssert ( oldcount >= 2 )

    IF oldcount == 2 THEN
        // Old refcount was 2, and now its 1, so we are responsible for
        // incrementing the count in the filter. Note that this can
        // race and make the count underflow or otherwise be goofy but this
        // is self-correcting as the racing threads leave, and not a
        // functional hazard as the filter is only used as a hint by
        // the garbage collection process.

        KeIncrementUlong (
            &mmnode^.VpnDbFilter[vpn / MMP_VPNDB_PER_FILTER], // ptr
            1, // inc
        )
    END
END

#IF BLD_MP

FN (MmpAfterShootdownF) MmpFlushVpnDb (
    IN mmnode : ^MmpNode,
    IN context : ^VOID,
    IN ptr : ^VOID,
    IN pages : UWORD,
)

    // Perform work required after a batched shootdown occurred that shot down
    // a range of VPN DB pages.

    pteaddr := MmpPteAddress ( ptr )
    i := 0

    WHILE i < pages DO
        ptecontents := pteaddr[i]

        KeAssert ( ptecontents == MMP_PENDING_FLUSH_PTE )

        pteaddr[i] = MMP_INVALID_KERNEL_PTE

        i += 1
    END
END

#END

FN MmpGarbageCollectVpnDb (
    IN mmnode : ^MmpNode,
)

    // Garbage collect unused pages in the VPN DB. This is done lazily rather
    // than reclaiming the pages eagerly in order to minimize TB shootdowns
    // and avoid excessive contention on the VpnDbLock.

    // This process involves scanning and is optimized by scanning a
    // filter as the first level. The filter consists of an array of
    // 32-bit counts of VPN DB pages that lie within a particular range, which
    // are reclaimable (refcount==1).

    counters := mmnode^.VpnDbCounters
    filter := mmnode^.VpnDbFilter

    base := mmnode^.VpnDbBase

    ptes := MmpPteAddress ( base )

    i := 0
    pages := mmnode^.KeNode^.DynamicSpaceSize

    WHILE i < pages DO
        IF filter[i / MMP_VPNDB_PER_FILTER] == 0 THEN
            // No reclaimable pages in this range.

            i += MMP_VPNDB_PER_FILTER

            CONTINUE
        END

        // There may be at least one reclaimable page in this range.

        max := i + MMP_VPNDB_PER_FILTER

        IF max > pages THEN
            max = pages
        END

        WHILE i < max DO
            IF counters[i] != 1 THEN
                // Not reclaimable.

                i += 1

                CONTINUE
            END

@Retry

            // This page of VPN DB is reclaimable.
            // Try to atomically change the refcount to 0 to represent that we
            // have reclaimed the underlying physical page.

            ipl := KeAcquireLockExclusiveRaise ( &mmnode^.VpnDbLock )

            value := KeCompareSwapUlong (
                &counters[i], // ptr
                0, // newvalue
                1, // expectedvalue
            )

            IF value != 1 THEN
                // Something changed, so just ignore this page.

                KeReleaseLockLower ( &mmnode^.VpnDbLock, ipl )

                i += 1

                CONTINUE
            END

            // Decremented the count to zero, so now we can reclaim.

            ptecontents := ptes[i]

            KeAssert ( MmpIsPteValid ( ptecontents ) )

#IF BLD_MP
            // Set the PTE to indicate the flushing of this VPN from the TB
            // is currently in a deferred batch.

            ptes[i] = MMP_PENDING_FLUSH_PTE

            IF NOT MmpBatchShootdown (
                mmnode, // mmnode
                NULLPTR, // context
                base + (i << RTL_PAGE_SHIFT), // ptr
                1, // pages
                &MmpFlushVpnDb, // callback
                FALSE, // canflush
            ) THEN

                // Oops, nevermind. We ran out of batched shootdown slots and
                // don't want to flush them while holding the VpnDbLock, so we
                // have to undo what we just did and then flush manually
                // while outside of it.

                ptes[i] = ptecontents

                KeWriteMemoryBarrier ()

                counters[i] = 1

                KeReleaseLockLower ( &mmnode^.VpnDbLock, ipl )

                MmpFlushShootdowns ( mmnode )

                GOTO Retry
            END
#ELSE
            // Clear the PTE and flush the virtual page.

            ptes[i] = MMP_INVALID_KERNEL_PTE

            KeuFlushMyTbAddress ( base + (i << RTL_PAGE_SHIFT) )
#END

            KeReleaseLockLower ( &mmnode^.VpnDbLock, ipl )

            // Decrement the number of VPN DB pages in this range that have a
            // refcount of 1, since we just changed one to 0.

            KeIncrementUlong (
                &filter[i / MMP_VPNDB_PER_FILTER], // ptr
                0xFFFFFFFF, // inc
            )

            // Free the page frame.

            MmpFreePage ( MmpPfnToPfe ( MmpPfnFromPte ( ptecontents ) ) )

            i += 1
        END
    END
END