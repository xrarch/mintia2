//
// Implements commit tracking for the MINTIA memory manager.
//
// This is used to strictly account for the available space in physical memory
// plus pagefiles, to avoid promising processes more memory than can really be
// provided.
//

#INCLUDE "Mmp.hjk"

FN MmuChargeCommit (
    IN mmnode : ^MmpNode,
    IN pages : UWORD,
    IN flags : UWORD,
) : OsStatus

    // Attempt to charge the specified commit to the memory node.
    // It would be unwise to page this routine as it can be called during
    // nonpaged pool allocation.

    IF PsCurrentThread()^.Tcb.VmPrivilegeBits THEN
        flags |= MM_ALLOCATE_FORCE_COMMIT
    END

    IF pages > RTL_MACHINE_WORD_MAX_S THEN
        // Page count overflows and is negative.

        KeAssert ( flags & MM_ALLOCATE_FORCE_COMMIT == 0 )

        RETURN OS_STATUS_COMMIT_EXCEEDED
    END

    status : OsStatus

    pfs := mmnode^.PagefileState

    remaining := pfs^.CommitRemaining

    WHILE TRUE DO
        IF remaining < RTL_MACHINE_WORD_MIN_S + pages THEN
            // Underflow would result from this subtraction.

            KeAssert ( flags & MM_ALLOCATE_FORCE_COMMIT == 0 )

            RETURN OS_STATUS_COMMIT_EXCEEDED
        END

        IF flags & MM_ALLOCATE_FORCE_COMMIT == 0 THEN
            IF remaining - pages < pfs^.EmergencyCommitMinimum THEN
                // This charge would bring the remaining commit below the
                // emergency minimum, so try to add it to the pagefile
                // expansion wish list first. Don't bother if we can't wait for
                // this to complete though.

                IF remaining - pages < 0 AND
                    -(remaining - pages) > pfs^.CommitLimitGrowthLeft THEN

                    // Don't even bother trying, there's no way to extend the
                    // pagefiles to accommodate this because the theoretical
                    // commit limit represents what we could theoretically
                    // increase the commit limit to if we were to extend all of
                    // the pagefiles to their maximum size.

                    RETURN OS_STATUS_COMMIT_EXCEEDED
                END

                status = OS_STATUS_COMMIT_EXCEEDED

                IF flags & MM_ALLOCATE_WAIT THEN
                    KeIncrementPtr (
                        &pfs^.CommitWishList, // ptr
                        pages, // pages
                    )

                    status = MmpExpandPagefiles (
                        pfs, // pagefilestate
                        flags, // flags
                        FALSE, // full
                    )

                    // No need to remove our requested charge from the wish list
                    // counter, it has already been reset to zero by the
                    // pagefile expansion worker.
                END

                IF OsError ( status ) AND
                    remaining - pages < 0 THEN

                    // Expanding the pagefiles failed and this charge would make
                    // commit actually go negative, so bail out.

                    RETURN status
                END
            END
        END

        new := CAST KeCompareSwapPtr (
            &pfs^.CommitRemaining, // ptr
            remaining - pages, // newvalue
            remaining, // expectedvalue
        ) TO WORD

        IF new == remaining THEN
            BREAK
        END

        remaining = new
    END

    IF remaining - pages >= pfs^.CommitRemainingMinimum THEN
        // Plenty of commit left after charging.

        RETURN OS_STATUS_SUCCESS
    END

    // Not much commit left, so we're responsible for signaling pagefile
    // expansion.

    status = MmpExpandPagefiles (
        pfs, // pagefilestate
        flags, // flags
        FALSE, // full
    )

    IF flags & MM_ALLOCATE_FORCE_COMMIT THEN
        // Proceed immediately with a successful status no matter what.

        RETURN OS_STATUS_SUCCESS
    END

    IF OsError ( status ) AND
        remaining - pages < pfs^.EmergencyCommitMinimum THEN

        // Failed to increase commit limit.
        // Remove the commit charge.

        KeIncrementPtr (
            &pfs^.CommitRemaining, // ptr
            pages, // inc
        )

        RETURN status
    END

    RETURN OS_STATUS_SUCCESS
END

FN MmuUnchargeCommit (
    IN mmnode : ^MmpNode,
    IN pages : UWORD,
)

    // Remove the specified commit charge from the node.
    // If pagefiles can now be contracted, that will be noticed at the next tick
    // of the responsible worker thread.

    pfs := mmnode^.PagefileState

    KeIncrementPtr (
        &pfs^.CommitRemaining, // ptr
        pages, // inc
    )
END