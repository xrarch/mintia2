//
// Implements kernel stack management for the memory manager.
//

#INCLUDE "Mmp.hjk"

FN MmuChargeKernelStack (
    IN kenode : ^KeuNode,
    IN process : ^PsuProcess,
) : OsStatus

    // Charge commit for a kernel stack. This guarantees that a physical page
    // will be acquirable for this kernel stack. We also pre-allocate virtual
    // space for the kernel stack here.
    //
    // Nonpaged because we take the KernelStackPteListLock, also taken from a
    // batched shootdown callback.

    mmnode := kenode^.Mmp

    quotablock := PsuQuotaBlock ( process )

    // Charge the process's virtual memory quota for the kernel stack.

    status := MmuChargeVmQuota (
        mmnode, // mmnode
        quotablock, // quotablock
        KEU_STACK_PAGES, // pages
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Pre-allocate virtual space for the kernel stack to ensure
    // infallibility of the kernel stack allocation worker.

    kstack : ^VOID

    status = MmpAllocateDynamicPages (
        mmnode, // mmnode
        KEU_STACK_PAGES + 1, // pages
        OUT kstack, // ptr
    )

    IF OsError ( status ) THEN
        // Couldn't allocate system space.

        MmuUnchargeVmQuota (
            mmnode, // mmnode
            quotablock, // quotablock
            KEU_STACK_PAGES, // pages
        )

        RETURN status
    END

    KeAcquireLockExclusive ( &mmnode^.KernelStackPteListLock )

    pte := MmpPteAddress ( kstack )

    pte[0] = CAST mmnode^.KernelStackPteListHead TO UWORD
    mmnode^.KernelStackPteListHead = pte

    mmnode^.KernelStacksOnList += 1
    mmnode^.KernelStacksNeeded += 1

    KeReleaseLock ( &mmnode^.KernelStackPteListLock )

    RETURN OS_STATUS_SUCCESS
END

FN MmuUnchargeKernelStack (
    IN kenode : ^KeuNode,
    IN process : ^PsuProcess,
)

    // Uncharge for a kernel stack.
    //
    // Nonpaged because we take the KernelStackPteListLock, also taken from a
    // batched shootdown callback.

    mmnode := kenode^.Mmp

    // Decrement the number of needed kernel stack areas.
    // This may result in needing to free one.

    kstack := NULLPTR

    KeAcquireLockExclusive ( &mmnode^.KernelStackPteListLock )

    KeAssert ( mmnode^.KernelStacksNeeded != 0 )

    needed := mmnode^.KernelStacksNeeded - 1
    mmnode^.KernelStacksNeeded = needed

    IF needed < mmnode^.KernelStacksOnList THEN
        // We now need fewer kernel stack virtual areas than are on the list,
        // so free one.

        KeAssert ( needed == mmnode^.KernelStacksOnList - 1 )

        pte := mmnode^.KernelStackPteListHead
        mmnode^.KernelStackPteListHead = CAST pte[0] TO ^VOID

        kstack = MmpVirtualAddress ( pte )

        mmnode^.KernelStacksOnList -= 1
    END

    KeReleaseLock ( &mmnode^.KernelStackPteListLock )

    // Free it outside the lock.

    IF kstack THEN
        MmpReleaseDynamicPages (
            mmnode, // mmnode
            kstack, // ptr
            KEU_STACK_PAGES + 1, // pages
            FALSE, // flush
        )
    END

    // Uncharge the virtual memory quota consumed by the kernel stack.

    MmuUnchargeVmQuota (
        mmnode, // mmnode
        PsuQuotaBlock ( process ), // quotablock
        KEU_STACK_PAGES, // pages
    )
END

FN MmpAllocateKernelStackVa (
    IN mmnode : ^MmpNode,
) : ^VOID

    // Allocate virtual space for a kernel stack. This should be (eventually)
    // infallible since we pre-allocated them.

    KeAcquireLockExclusive ( &mmnode^.KernelStackPteListLock )

    pte := mmnode^.KernelStackPteListHead

#IF BLD_MP
    IF NOT pte THEN
        // This can happen if the pre-allocated kernel stacks are all on the
        // batched shootdown queue, so flush it and allow the caller to do a
        // full retry.

        KeReleaseLock ( &mmnode^.KernelStackPteListLock )

        MmpFlushShootdowns ( mmnode )

        RETURN NULLPTR
    END

#ELSE
    KeAssert ( pte != NULLPTR )
#END

    KeAssert ( mmnode^.KernelStacksOnList != 0 )

    // Decrememt number of stack areas on the list.

    mmnode^.KernelStacksOnList -= 1

    // Pop the stack area.

    mmnode^.KernelStackPteListHead = CAST pte[0] TO ^VOID

    kstack := MmpVirtualAddress ( pte )

    KeReleaseLock ( &mmnode^.KernelStackPteListLock )

    RETURN kstack
END

FN (MmpAfterShootdownF) MmpFreeKernelStackVa (
    IN mmnode : ^MmpNode,
    IN context : ^VOID,
    IN ptr : ^VOID,
    IN pages : UWORD,
)

    // Free the virtual space for a kernel stack.

    WHILE pages DO
        KeAcquireLockExclusive ( &mmnode^.KernelStackPteListLock )

        onlist := mmnode^.KernelStacksOnList

        IF onlist == mmnode^.KernelStacksNeeded THEN
            // We already have all the kernel stacks we need on the list, so
            // just free this one. This can occur primarily when stacks were
            // uncharged while this stack was on the batched shootdown queue.

            KeReleaseLock ( &mmnode^.KernelStackPteListLock )

            MmpReleaseDynamicPages (
                mmnode, // mmnode
                ptr, // ptr
                KEU_STACK_PAGES + 1, // pages
                FALSE, // flush
            )
        
        ELSE
            // We have fewer than the needed number of kernel stack areas, so
            // add this one to the list.

            pte := MmpPteAddress ( ptr )

            pte[0] = CAST mmnode^.KernelStackPteListHead TO UWORD
            mmnode^.KernelStackPteListHead = pte

            mmnode^.KernelStacksOnList = onlist + 1

            KeReleaseLock ( &mmnode^.KernelStackPteListLock )
        END

        pages -= KEU_STACK_PAGES + 1
        ptr += (KEU_STACK_PAGES + 1) * RTL_PAGE_SIZE
    END
END

FN MmuAllocateKernelStack (
    IN kenode : ^KeuNode,
) : ^VOID
    
    // Allocate a new kernel stack.
    // This should be infallible, it was charged for earlier.

@Retry

    kstack := KeuPopKernelStack ( kenode )

    IF kstack THEN
        RETURN kstack
    END

    mmnode := kenode^.Mmp

    // Allocate the required system space.

    kstack = MmpAllocateKernelStackVa ( mmnode )

#IF BLD_MP
    IF NOT kstack THEN
        GOTO Retry
    END

#ELSE
    KeAssert ( kstack != NULLPTR )
#END

    pfes : ^MmpPfe[KEU_STACK_PAGES]

    i := 0
    ptr := kstack + RTL_PAGE_SIZE

    WHILE i < KEU_STACK_PAGES DO
        // Allocate a physical page.

        pfes[i] = MmpAllocatePage (
            mmnode, // mmnode
            0, // flags
            MmpVirtualAddressColor ( ptr ), // color
        )

        IF NOT pfes[i] THEN
            // Failed to allocate this page frame.
            // Deallocate the ones we did allocate and return the appropriate
            // status.

            MmpFreeKernelStackVa (
                mmnode, // mmnode
                NULLPTR, // context
                kstack, // ptr
                KEU_STACK_PAGES + 1, // pages
            )

            // Wait for a page frame BEFORE releasing the ones we already
            // allocated, so that we wait for a free frame IN ADDITION TO
            // those, otherwise we might inf loop here.

            MmpWaitForPages (
                mmnode, // mmnode
                FALSE, // low
            )

            WHILE i DO
                i -= 1

                MmpFreePage ( pfes[i] )
            END

            GOTO Retry
        END

        i += 1
        ptr += RTL_PAGE_SIZE
    END

    // Acquire a pointer to the first PTE for this region.

    pte := MmpPteAddress ( kstack )

    // Set the guard page invalid.

    pte[0] = MMP_INVALID_KERNEL_PTE

    // Skip to the first real stack page.

    pte = &pte[1]

    // Map the stack pages.

    i = 0

    WHILE i < KEU_STACK_PAGES DO
        pte[i] = MmpBuildPoolPte ( MmpPfeToPfn ( pfes[i]) )

        i += 1
    END

    RETURN kstack + RTL_PAGE_SIZE + (KEU_STACK_PAGES << RTL_PAGE_SHIFT)
END

FN MmuDeleteKernelStack (
    IN kenode : ^KeuNode,
    IN kstack : ^VOID,
)

    // Delete a kernel stack.

    mmnode := kenode^.Mmp

    kstack -= KEU_STACK_PAGES << RTL_PAGE_SHIFT

    // Acquire a pointer to the first PTE for this region.

    pte := MmpPteAddress ( kstack )

    // Free the kernel stack pages.

    i := 0

    WHILE i < KEU_STACK_PAGES DO
        // Load the PTE for this page.

        ptecontents := pte[i]

        KeAssert ( MmpIsPteValid ( ptecontents ) )

        // Clear the PTE, makes it more likely we'll see it if a bad pointer
        // within this space is used later. Due to the TB it's not 100% though.

        pte[i] = MMP_INVALID_KERNEL_PTE

        // Free the page frame.

        MmpFreePage ( MmpPfnToPfe ( MmpPfnFromPte ( ptecontents ) ) )

        i += 1
    END

    // Release the system space containing the stack.

    kstack -= RTL_PAGE_SIZE

#IF BLD_MP
    MmpBatchShootdown (
        mmnode, // mmnode
        NULLPTR, // context
        kstack, // ptr
        KEU_STACK_PAGES + 1, // pages
        &MmpFreeKernelStackVa, // callback
    )

#ELSE
    KeuFlushRangeTb (
        kstack, // ptr
        KEU_STACK_PAGES + 1, // pagecount
        FALSE, // keepglobal
    )

    MmpFreeKernelStackVa (
        mmnode, // mmnode
        NULLPTR, // context
        kstack, // ptr
        KEU_STACK_PAGES + 1, // pages
    )
#END

END