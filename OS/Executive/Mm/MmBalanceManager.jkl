//
// Implements the Balance Manager for the MINTIA Executive.
//

#INCLUDE "Mmp.hjk"

#INCLUDE "<ll>/System/OsProcess.hjk"

#DEFINE MMP_BALANCE_MANAGER_INTERVAL_MS 1000
#DEFINE MMP_BALANCE_MANAGER_WAIT_FOR_WORK_MS 500

#DEFINE MMP_POOL_ADJUSTMENT_SHORT_INTERVAL_MS 1000
#DEFINE MMP_POOL_ADJUSTMENT_INTERVAL_MS 5000

#DEFINE MMP_VPN_DB_SCAN_INTERVAL_MS 7000

FN (ExWorkItemF) MmpAdjustPagedCacheWorker (
    IN context1 : UWORD,
    IN context2 : UWORD,
)

    // Called from the context of a worker thread to perform periodic adjustment
    // work that is unsafe to perform in the context of the balance manager.

    mmnode := CAST context1 TO ^MmpNode
    kenode := mmnode^.KeNode

    mmnode^.PgCacheAdjustActive = FALSE

    empty := mmnode^.AvailablePageCount < mmnode^.LowPageCount

    IF empty THEN
        // Perform all deferred asynchronous deletions now, before adjusting
        // pool caches, so that they are all freed to the pool caches and we
        // can free up as much as possible.

        PsuReaperWorker (
            kenode, // context1
            0, // context2
        )

        ObuDeferredDeletionWorker (
            kenode, // context1
            0, // context2
        )
    END

    IF kenode^.Id == 0 THEN
        // Boot node also reaps libraries.

        ExuReapLibraries ( empty )
    END

    ExuAdjustMagazineCaches (
        kenode, // kenode
        TRUE, // paged
        empty, // empty
    )
END

FN MmpAdjustAllCachesSafely (
    IN mmnode : ^MmpNode,
    IN empty : UWORD,
)

    // Adjust all of the pool caches. Called by the balance manager.
    // To be safe, we need to dispatch paged pool cache adjustment to a worker
    // thread because the balance manager cannot safely take page faults as it
    // is a critical memory-making thread.

    IF NOT mmnode^.PgCacheAdjustActive THEN
        mmnode^.PgCacheAdjustActive = TRUE

        ExEnqueueWorkItem (
            &mmnode^.PgCacheAdjustItem, // item
            EX_HIGH_WORK_PRIORITY, // priority
            empty, // head
            CAST mmnode TO UWORD, // context1
            0, // context2
        )
    END

    kstacktoreap : ^KeuCachedStack = NULLPTR

    kenode := mmnode^.KeNode

    IF empty THEN
        kstacktoreap = KeuFlushStackCache ( kenode )
    ELSE
        kstacktoreap = KeuReapStackCache ( kenode )
    END

    WHILE kstacktoreap DO
        next := kstacktoreap^.Next

        MmuDeleteKernelStack (
            kenode, // kenode
            kstacktoreap + SIZEOF KeuCachedStack, // kstack
        )

        kstacktoreap = next
    END

    // Immediately chuck the nonpaged magazine caches from the context
    // of this thread.

    ExuAdjustMagazineCaches (
        kenode, // kenode
        FALSE, // paged
        empty, // empty
    )
END

FN (KeContinuationF) MmuBalanceManager (
    IN continuation : ^KeContinuation,
    IN waitstatus : OsStatus,
)

    // Responsible for:
    // o Process swapping.
    // o Working set trimming.
    // o Pool cache adjustment.

    thread := PsCurrentThread ()

    KeSetBasePriorityThread (
        &thread^.Tcb, // thread
        OS_PRIORITY_MED_REALTIME, // priority
        TRUE, // setcurrentpriority
    )

    mmnode := MmCurrentAffinityNode ()

    mmnode^.PgCacheAdjustActive = FALSE

    ExInitializeWorkItem (
        &mmnode^.PgCacheAdjustItem, // item
        &MmpAdjustPagedCacheWorker, // routine
    )

    ms := 0
    mssinceadjust := 0
    mssincevpndbcollect := 0

    timer : KeTimer

    interval : RtlUquad

    RtlSetUquadToUlong (
        &interval, // uquad
        MMP_BALANCE_MANAGER_INTERVAL_MS, // ms
    )

    KeInitializeTimer (
        &timer, // timer
        NULLPTR, // dpc
        "ExuBalanceManagerTimer", // name
    )

    waittable : KeWaitEntry[3]
    waittable[0].Object = &timer
    waittable[1].Object = &mmnode^.LowMemoryEvent

    objectcount := 2

#IF BLD_NUMA
    waittable[2].Object = &mmnode^.RemoteReclaimEvent
    objectcount = 3
#END

    status : OsStatus = 0

    WHILE TRUE DO
        IF status == 0 THEN
            // The timer expired so we have to re-enqueue it.

            KeEnqueueTimer (
                &timer, // timer
                &interval, // interval
                0, // context1
                0, // context2
            )
        END

@ImACatWhoLovesToSnooze

        status = KeWaitForObjects (
            KE_KERNEL_MODE, // waitmode
            KE_UNALERTABLE, // alertable
            NULLPTR, // timeout
            objectcount, // objectcount
            &waittable[0], // objecttable
            NULLPTR, // waitblocktable
            NULLPTR, // continuation
        )

        KeAssert ( NOT OsError ( status ) )

        IF status == 0 THEN
            // The timer expired.
            // Perform periodic adjustment work.

            ms += MMP_BALANCE_MANAGER_INTERVAL_MS
            dt := ms - mssinceadjust

            IF dt >= MMP_POOL_ADJUSTMENT_INTERVAL_MS OR
                (mmnode^.AvailablePageCount < mmnode^.LowPageCount AND
                dt >= MMP_POOL_ADJUSTMENT_SHORT_INTERVAL_MS) THEN

                // Adjust pool caches.

                mssinceadjust = ms

                MmpAdjustAllCachesSafely (
                    mmnode, // mmnode
                    mmnode^.AvailablePageCount <
                        mmnode^.LowPageCount, // empty
                )
            END

            IF ms - mssincevpndbcollect >= MMP_VPN_DB_SCAN_INTERVAL_MS THEN
                // Garbage collect the VPN DB.

                mssincevpndbcollect = ms

                MmpGarbageCollectVpnDb ( mmnode )
            END

            CONTINUE
        END

        // The low memory event was set.

        // Try to free up page frames in a hurry. We can't go back to sleep
        // until we observe the available page count above the low page
        // threshold or system deadlock could result, since we are only
        // signaled when it drops below that (for performance reasons).
        // We ideally want to get up to the sufficient page count but we're
        // allowed to go back to sleep before we get there.

        tries := 0
        threshold := mmnode^.SufficientPageCount

#IF BLD_NUMA
        IF status == 2 THEN
            // We were asked by a remote node to free up lots of pages for it
            // so set the threshold to basically infinity so we don't early
            // exit before doing all the stuff.

            threshold = RTL_MACHINE_WORD_MAX
        END
#END

        // Do the lowest effort stuff first and get increasingly desperate.

@TryAgain

        // First dump all the object caches.

        MmpAdjustAllCachesSafely (
            mmnode, // mmnode
            TRUE, // empty
        )

        IF mmnode^.AvailablePageCount > threshold THEN
            GOTO ImACatWhoLovesToSnooze
        END

        MmpGarbageCollectVpnDb ( mmnode )

        IF mmnode^.AvailablePageCount > threshold THEN
            GOTO ImACatWhoLovesToSnooze
        END

        // Trim working sets.

        // MmpTrimWorkingSets ( mmnode )

        IF mmnode^.AvailablePageCount > threshold THEN
            GOTO ImACatWhoLovesToSnooze
        END

        // The synchronous stuff didn't work so we're out of hope and need
        // to set off a bunch of asynchronous work to see if that'll help.

        // Kick off the modified page writer.

        // MmpFlushModifiedPageList ( mmnode )

#IF BLD_NUMA
        IF tries >= 4 AND
            status == 1 THEN

            // We've been trying to get memory for a long time but nothing has
            // worked.

            // While the modified page writer works, scan neighboring nodes to
            // see if any of them borrowed a substantial number of page frames
            // from me. If so, signal them too.

            nodelist := mmnode^.KeNode^.DistanceList

            WHILE nodelist[0] DO
                othernode := nodelist[0]^.Mmp

                IF othernode^.BorrowCounts[mmnode^.Id] >=
                    MMP_SIGNIFICANT_BORROWS THEN

                    IF othernode^.RemoteReclaimEvent.
                        Header.SignalCount == 0 THEN

                        // Signal its remote reclaim event to get our page
                        // frames back.

                        KeSignalEvent (
                            &othernode^.RemoteReclaimEvent, // event
                            0, // priorityboost
                        )
                    END
                END

                nodelist += SIZEOF ^KeuNode
            END
        END
#END

        // Sleep for awhile to see if the asynchronous work helps.

        waitinterval : RtlUquad

        RtlSetUquadToUlong (
            &waitinterval, // uquad
            MMP_BALANCE_MANAGER_WAIT_FOR_WORK_MS, // ms
        )

        KeSleep (
            &waitinterval, // interval
            KE_KERNEL_MODE, // waitmode
            KE_UNALERTABLE, // alertable
            NULLPTR, // continuation
        )

        IF mmnode^.AvailablePageCount <= mmnode^.LowPageCount THEN
            // We did not make it out of the low page count, so we have to try
            // again.

            tries += 1

            GOTO TryAgain
        END

        // We may or may not have made it up to the sufficient page count,
        // but we at least made it up to the low page count, which is good
        // enough to go back to sleep. We can hope that the async work will
        // get us the rest of the way but for now we don't want to spam all of
        // this again.
    END
END