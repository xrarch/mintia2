//
// Pool allocation for the MINTIA executive.
//

#INCLUDE "Mmp.hjk"

// Cache align the object size array so that an extra miss as a result of
// cache line crossing won't occur.

// Also, subtract SIZEOF ULONG from each one to account for the 4 byte tag
// added by MmObjectCache to each one and avoid it rounding up and wasting
// space.

#SECTION "text"
MmpObjectSizes : KE_CACHE_LINE UINT[] = {
    MmUsableSpaceOfBlock ( 32, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 48, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 80, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 128, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 192, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 288, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 432, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 656, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 992, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 1472, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 2208, RTL_ALIGN_BYTES ),
}

#MACRO MmpMakePoolContext ( pageable, index ) [
    (((pageable) << 6) | (index))
]

#MACRO MmpPoolContextPageable ( poolcontext ) [
    (((poolcontext) >> 6) & 1)
]

#MACRO MmpPoolContextIndex ( poolcontext ) [
    ((poolcontext) & 0x3F)
]

#SECTION "INITtext"
FN MmpInitializePool (
    IN kenode : ^KeuNode,
)

    // Initialize the generic allocator.

    mmnode := kenode^.Mmp

    i := 0

    WHILE i < 2 DO
        j := 0

        WHILE j < MMP_NUMBER_POOL_BUCKETS DO
            status := MmCreateObjectCache (
                kenode, // kenode
                "Pool", // name
                0, // flags
                MmpObjectSizes[j], // objectsize
                TRUE, // magazinecached
                i, // pageable
                RTL_ALIGN_BYTES, // align
                OUT mmnode^.PoolCaches[i][j], // objectcache
            )

            KeAssert ( NOT OsError ( status ) )

            MmpSetObjectCacheContext (
                mmnode^.PoolCaches[i][j], // objectcache
                MmpMakePoolContext ( i, j ), // context
            )

            j += 1
        END

        i += 1
    END
END

FN MmAllocatePoolEx (
    IN kenode : ^KeuNode,
    IN pageable : UWORD,
    IN bytes : UWORD,
    IN tag : UWORD,
    IN flags : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

    // Allocate pool.

    IF NOT kenode THEN
        kenode = KeCurrentAffinityNode ()
    END

    // Make sure pageable is 0 or 1.

    pageable = NOT NOT pageable

    status : OsStatus

    mmnode := kenode^.Mmp

    IF bytes > MmpObjectSizes[MMP_NUMBER_POOL_BUCKETS - 1] THEN
        // Page-aligned allocation.

        bytes = (bytes + RTL_PAGE_SIZE - 1) >> RTL_PAGE_SHIFT

@Retry

        status = MmAllocateMappedPages (
            mmnode, // mmnode
            flags, // flags
            bytes, // pages
            pageable, // pageable
            OUT ptr, // ptr
        )

        IF OsError ( status ) THEN
            IF status == OS_STATUS_TRY_AGAIN AND
                flags & MM_ALLOCATE_WAIT THEN

                // We're the top level and the mapped page arena said to try
                // again, so do it.

                GOTO Retry
            END

            RETURN status
        END

        vpe := MmpAddressToVpe ( mmnode, ptr )

        // Indicate page-aligned.

        vpe^.U.PageAlignedPool.SlabControl = 0xFFFFFFFF
        vpe^.U.PageAlignedPool.Pages = bytes
        vpe^.U.PageAlignedPool.Tag = tag
        vpe^.U.PageAlignedPool.Pageable = pageable

        RETURN status
    END

    // Small allocation.

    l : WORD = 0
    r : WORD = MMP_NUMBER_POOL_BUCKETS - 1
    index : WORD

    // Binary search to find the right bucket.

    WHILE l <= r DO
        m := CAST l + (r - l) / 2 TO WORD

        IF MmpObjectSizes[m] >= bytes THEN
            index = m

            IF MmpObjectSizes[m] == bytes THEN
                BREAK
            END

            r = m - 1

        ELSE
            l = m + 1
        END
    END

    RETURN MmAllocateFromObjectCache (
        mmnode^.PoolCaches[pageable][index], // objectcache
        flags, // flags
        tag, // tag
        OUT ptr, // ptr
    )
END

FN MmFreePool (
    IN ptr : ^VOID,
    IN tag : UWORD,
)

    // Free a block to pool.

    kenode := KeNumaNodeFromSpacePointer ( ptr )
    mmnode := kenode^.Mmp

    vpe := MmpAddressToVpe ( mmnode, ptr )

    slabctrl := vpe^.U.ObjectCache.SlabControl

    IF slabctrl == 0xFFFFFFFF THEN
        // Page aligned.

        IF vpe^.U.PageAlignedPool.Tag != tag THEN
            KeCrash ( "MmFreePool: incorrect tag (expected %x, saw %x)\n",
                tag, vpe^.U.PageAlignedPool.Tag )
        END

        MmFreeMappedPages (
            mmnode, // mmnode
            ptr, // ptr
            vpe^.U.PageAlignedPool.Pages, // pages
            vpe^.U.PageAlignedPool.Pageable, // pageable
        )

        LEAVE
    END

    // Smaller.

    poolcontext := MmpSlabPoolContext ( slabctrl )

    pageable := MmpPoolContextPageable ( poolcontext )
    index := MmpPoolContextIndex ( poolcontext )

    MmFreeToObjectCache (
        mmnode^.PoolCaches[pageable][index], // objectcache
        ptr, // ptr
        tag, // tag
    )
END

#SECTION "PAGEtext"
FN MmGetOverheadOfBytes (
    IN bytes : UWORD,
) : UWORD

    // Calculate the total overhead in bytes that the pool allocation for the
    // given number of bytes would consume.

    IF bytes == 0 THEN
        RETURN 0
    END

    oldbytes := bytes

    IF bytes > MmpObjectSizes[MMP_NUMBER_POOL_BUCKETS - 1] THEN
        // Page-aligned charge.

        bytes = (bytes + RTL_PAGE_OFFSET_MASK) & RTL_PAGE_NUMBER_MASK

    ELSE
        // Small block charge.

        bytes = (bytes + RTL_ALIGN_BYTES + RTL_ALIGN_BYTES - 1) &
            -RTL_ALIGN_BYTES
    END

    IF bytes < oldbytes THEN
        // An overflow has occurred which isn't good.
        // Return the unsigned maximum.

        bytes = RTL_MACHINE_WORD_MAX
    END

    RETURN bytes
END
