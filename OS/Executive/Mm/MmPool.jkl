//
// Pool allocation for the MINTIA executive.
//

#INCLUDE "Mmp.hjk"

// Cache align the object size array so that an extra miss as a result of
// cache line crossing won't occur.

// Also, subtract SIZEOF ULONG from each one to account for the 4 byte tag
// added by MmObjectCache to each one and avoid it rounding up and wasting
// space.

#SECTION "text"
MmpObjectSizes : KE_CACHE_LINE UINT[] = {
    MmUsableSpaceOfBlock ( 32, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 48, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 80, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 128, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 192, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 288, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 432, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 656, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 992, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 1472, RTL_ALIGN_BYTES ),
    MmUsableSpaceOfBlock ( 2208, RTL_ALIGN_BYTES ),
}

#SECTION "INITtext"
FN MmpInitializePool (
    IN kenode : ^KeuNode,
)

    // Initialize the generic allocator.

    mmnode := kenode^.Mmp

    i := 0

    WHILE i < 2 DO
        j := 0

        WHILE j < MMP_NUMBER_POOL_BUCKETS DO
            status := MmCreateObjectCache (
                kenode, // kenode
                "Pool", // name
                0, // flags
                MmpObjectSizes[j], // objectsize
                TRUE, // magazinecached
                i, // pageable
                RTL_ALIGN_BYTES, // align
                OUT mmnode^.PoolCaches[i][j], // objectcache
            )

            KeAssert ( NOT OsError ( status ) )

            MmpSetObjectCacheIndex (
                mmnode^.PoolCaches[i][j], // objectcache
                i, // index1
                j, // index2
            )

            j += 1
        END

        i += 1
    END
END

FN MmAllocatePoolEx (
    IN kenode : ^KeuNode,
    IN pageable : UWORD,
    IN bytes : UWORD,
    IN tag : UWORD,
    IN flags : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

    // Allocate pool.

    IF NOT kenode THEN
        kenode = KeCurrentAffinityNode ()
    END

    status : OsStatus

    mmnode := kenode^.Mmp

    IF bytes > MmpObjectSizes[MMP_NUMBER_POOL_BUCKETS - 1] THEN
        // Page-aligned allocation.

        bytes = (bytes + RTL_PAGE_SIZE - 1) >> RTL_PAGE_SHIFT

@Retry

        status = MmAllocateMappedPages (
            kenode, // kenode
            flags, // flags
            bytes, // pages
            pageable, // pageable
            OUT ptr, // ptr
        )

        IF OsError ( status ) THEN
            IF status == OS_STATUS_TRY_AGAIN AND
                flags & MM_ALLOCATE_WAIT THEN

                // We're the top level and the mapped page arena said to try
                // again, so do it.

                GOTO Retry
            END

            RETURN status
        END

        vpe := MmpAddressToVpe ( mmnode, ptr )

        // Indicate page-aligned.

        vpe^.U.ObjectCache.PoolCacheIndex1 = NOT NOT pageable
        vpe^.U.ObjectCache.PoolCacheIndex2 = 0xFF

        // Stash length in slab control pointer.

        vpe^.U.ObjectCache.SlabControl = CAST bytes TO ^VOID

        vpe^.U.ObjectCache.Tag = tag

        RETURN status
    END

    // Small allocation.

    l : WORD = 0
    r : WORD = MMP_NUMBER_POOL_BUCKETS - 1
    index : WORD

    // Binary search to find the right bucket.

    WHILE l <= r DO
        m := CAST l + (r - l) / 2 TO WORD

        IF MmpObjectSizes[m] >= bytes THEN
            index = m

            IF MmpObjectSizes[m] == bytes THEN
                BREAK
            END

            r = m - 1

        ELSE
            l = m + 1
        END
    END

    RETURN MmAllocateFromObjectCache (
        mmnode^.PoolCaches[NOT NOT pageable][index], // objectcache
        flags, // flags
        tag, // tag
        OUT ptr, // ptr
    )
END

FN MmFreePool (
    IN ptr : ^VOID,
    IN tag : UWORD,
)

    // Free a block to pool.

    kenode := KeNumaNodeFromSpacePointer ( ptr )
    mmnode := kenode^.Mmp

    vpe := MmpAddressToVpe ( mmnode, ptr )

    pageable := vpe^.U.ObjectCache.PoolCacheIndex1
    index := vpe^.U.ObjectCache.PoolCacheIndex2

    IF index == 0xFF THEN
        // Page aligned.

        IF vpe^.U.ObjectCache.Tag != tag THEN
            KeCrash ( "MmFreePool: incorrect tag (expected %x, saw %x)\n",
                tag, vpe^.U.ObjectCache.Tag )
        END

        MmFreeMappedPages (
            kenode, // kenode
            ptr, // ptr
            CAST vpe^.U.ObjectCache.SlabControl TO UWORD, // pages
            pageable, // pageable
        )

        LEAVE
    END

    // Smaller.

    MmFreeToObjectCache (
        mmnode^.PoolCaches[pageable][index], // objectcache
        ptr, // ptr
        tag, // tag
    )
END

#SECTION "PAGEtext"
FN MmGetOverheadOfBytes (
    IN bytes : UWORD,
) : UWORD

    // Calculate the total overhead in bytes that the pool allocation for the
    // given number of bytes would consume.

    IF bytes == 0 THEN
        RETURN 0
    END

    IF bytes > MmpObjectSizes[MMP_NUMBER_POOL_BUCKETS - 1] THEN
        // Page-aligned charge.

        RETURN (bytes + RTL_PAGE_OFFSET_MASK) & RTL_PAGE_NUMBER_MASK
    END

    // Small block charge.

    RETURN (bytes + RTL_ALIGN_BYTES + RTL_ALIGN_BYTES - 1) & -RTL_ALIGN_BYTES
END
