//
// Implements books, which are containers for virtual pages that are looked up
// by page number. A page in a book is virtual and may be present in memory
// (cached in a physical page frame), or may be elsewhere. It may not exist at
// all yet. The method for how to materialize a page (for example backing store
// or demand-zero) depends on the author of the book, such as file page cache
// or anonymous shared memory.
//
// These are often referred to as "VM objects" or "sections" in other systems
// and are given another name here to avoid a multiple-way naming collision with
// other system features also termed objects.
//
// The structure used for tracking a book's pages is called a tracking table or
// TT. A TT is a multi level table with an increasing number of levels for
// greater indices (similar to a traditional UFS inode block map). A tracking
// table level's lifetime is maintained by an entry count stored in the VPNDB
// entry for its containing page. When a tracking table contains no tracking
// table entries that point to physical pages (that is, all tracked pages have
// been cleaned to backing store and reclaimed via the standby list), it becomes
// itself pageable to disk. This works by allocating tracking tables as pageable
// memory and using a biased reference count on their page frame to avoid
// removal from the system working set until these entries are all gone (the
// working set trimming code is written to be aware of this special case).
//
// The reason they must be wired in physical memory until all tracked physical
// pages are gone is to avoid standby list reclamation taking a page fault while
// trying to record the page's backing store in its TTE, which would cause
// deadlock.
//

#INCLUDE "Mmp.hjk"

// On a 32-bit system with 4KB pages (xr17032, fox32) this can handle page
// numbers up to 1,100,586,419,232-1, or ~4.5 PB.

// On a 64-bit system with 4KB pages (amd64) this can handle page numbers up to
// 68,853,957,152-1 or ~282 TB.

// On a 64-bit system with 16KB pages (aphelion, aarch64) this can handle page
// numbers up to 17,600,780,175,392-1, or ~288.4 PB.

#DEFINE MMP_TT_ENTRIES [(RTL_PAGE_SIZE / SIZEOF MmpPte)]

#DEFINE MMP_EMBEDDED_PAGES 64

#DEFINE MMP_L1_PAGES [(MMP_EMBEDDED_PAGES + MMP_TT_ENTRIES)]

#DEFINE MMP_L2_PAGES [(MMP_L1_PAGES + (MMP_TT_ENTRIES * MMP_TT_ENTRIES))]

#DEFINE MMP_L3_PAGES [(
    MMP_L2_PAGES + (MMP_TT_ENTRIES * MMP_TT_ENTRIES * MMP_TT_ENTRIES)
)]

#DEFINE MMP_L4_PAGES [(
    MMP_L3_PAGES + (MMP_TT_ENTRIES * MMP_TT_ENTRIES *
        MMP_TT_ENTRIES * MMP_TT_ENTRIES)
)]

#DEFINE MMP_TTE_RACED_SENTINEL [-1]

STRUCT MmpBook
    // The operation lock guards against concurrent flushes and other high
    // level operations.

    OperationLock : KeLock,

KE_CACHE_LINE_END

    // The structure lock guards against modification to the tracking table
    // structure.

    StructureLock : KeLock,

KE_CACHE_LINE_END

    SizeInBytes : RtlUquad,

    EmbeddedArray : MmpPte[MMP_EMBEDDED_PAGES],
    OneLevelArray : ^MmpPte,
    TwoLevelArray : ^^MmpPte,
    ThreeLevelArray : ^^^MmpPte,
    FourLevelArray : ^^^^MmpPte,

KE_CACHE_LINE_END

    References : ULONG,
END

FN MmpConditionallyReferenceBook (
    IN book : ^MmpBook,
) : UWORD

    // Attempt to reference the book. Only succeeds if the reference count is
    // not already 0. Returns TRUE if referenced, FALSE otherwise. Note that
    // a FALSE return means somebody else is in the process of deleting the
    // book.

    // This is only safe if a lock is being held that the caller knows is
    // blocking out the final release of the book's memory.

    oldcount := book^.References

    WHILE TRUE DO
        IF oldcount == 0 THEN
            // Count is already zero, so it may be undergoing deletion. Not safe
            // to reference this book.

            RETURN FALSE
        END

        new := KeCompareSwapUlong (
            &book^.References, // ptr
            oldcount + 1, // newvalue
            oldcount, // expectedvalue
        )

        IF new == oldcount THEN
            // Got it. The previous count was nonzero so we know the book is
            // safe.

            RETURN TRUE
        END

        oldcount = new
    END
END

FN MmpReferenceBook (
    IN book : ^MmpBook,
)

    // Reeference the given book.

    KeIncrementUlong (
        &book^.References, // ptr
        1, // inc
    )
END

FN MmpUnreferenceBook (
    IN book : ^MmpBook,
    IN defer : UWORD,
)

    // Unreference the given book.

    // If the refcount reaches zero, it must be freed.
    // If it should be freed and defer is TRUE, then enqueue it to a reaper
    // thread.

    oldcount := KeIncrementUlong (
        &book^.References, // ptr
        0xFFFFFFFF, // inc
    )

    IF oldcount == 1 THEN
        // We're responsible for freeing the book.

        IF defer THEN
            // Enqueue the book to a reaper thread custody list.

            KeCrash ( "TODO MmpUnreferenceBook\n" )

            LEAVE
        END

        // Free the book ourselves.

        KeCrash ( "TODO MmpUnreferenceBook\n" )
    END
END

FN MmpDecrementLiveEntryCount (
    IN tte : ^MmpPte,
) : UWORD

    // Decrement the live entry count of the containing tracking table for this
    // TTE. Return the old count.

    mmnode := KeNumaNodeFromSpacePointer ( tte )^.Mmp

    vpe := MmpAddressToVpe ( mmnode, tte )

    RETURN KeIncrementUlong (
        &vpe^.U.TrackingTable.LiveEntryCount, // ptr
        0xFFFFFFFF, // inc
    )
END

FN MmpCheckAndDeleteTrackingTable (
    IN book : ^MmpBook,
    IN pagenumber : ^RtlUquad,
)

    // Check if the tracking table that is used to translate the given page
    // number should be deleted, and delete it if so.

    // XXX A reasonable fear here is that another thread holding the structure
    //     lock takes a page fault on a tracking table that had been paged out,
    //     and then a caller of this function who really does not want to block
    //     for pages, blocks indirectly for pages by waiting for that thread to
    //     release the structure lock. This can't happen, because before we walk
    //     from one tracking table level to the next while holding the structure
    //     lock, we check to make sure the PTE is valid first. If it isn't, then
    //     the live entry count of the tracking table is biased by 1 to ensure
    //     its lifetime, and then the structure lock is dropped. The page can
    //     then be faulted in. This process repeats until the lookup code
    //     observes a valid PTE, which it can pin in the system working set
    //     until the end of the operation by incrementing the reference count
    //     on the PFE of the tracking table. As for why this function can be
    //     sure it will also not take any page faults, it's because any tracking
    //     table with valid entries (such as any ancestor of the one we're
    //     looking for) is pinned in the system working set and can't be paged
    //     out. Therefore if we run into an invalid PTE, then we can simply
    //     terminate this operation, because that means that the leaf table we
    //     are here to delete is gone anyway.

    ipl := KeAcquireLockExclusiveRaise ( &book^.StructureLock )

    // First look up the tracking table that corresponds to the page number.
    // If there is none, there's nothing for us to do.

    // ...

    // Now check under the book lock to see if the live entry count of the
    // tracking table is still 0. If so, delete it. Then walk to the parent to
    // decrement its live entry count and clear the entry that pointed to this
    // tracking table. If its entry count becomes zero as well, then repeat.

    // ...

    KeCrash ( "TODO MmpCheckAndDeleteTrackingTable\n" )

    KeReleaseLockLower ( &book^.StructureLock, ipl )
END

FN MmpAllocatePageFromStandbyList (
    IN mmnode : ^MmpNode,
) : ^MmpPfe

    // Allocate a page from the given node's standby list.

    // This is in MmBook instead of MmPageFrames because all standby pages are
    // in a book and have to be removed here with a careful locking scheme,
    // and therefore we need knowledge of the internals of book implementation.

    ipl := KeAcquireLockExclusiveRaise ( &mmnode^.StandbyListLock )

    count := mmnode^.StandbyListCount

    IF count == 0 THEN
        KeReleaseLockLower ( &mmnode^.StandbyListLock, ipl )

        // Nothing on the standby list.

        RETURN NULLPTR
    END

    // There's at least one page on the standby list, so grab it.

    mmnode^.StandbyListCount = count - 1

    pfe := CONTAINEROF mmnode^.StandbyListHead.Next TO MmpPfe.Entry

    KeAssert ( pfe^.References == 0 )

    RtlRemoveEntryList ( &pfe^.Entry )

    // For lock ordering reasons we have to drop the standby list lock. In
    // order to stop a page lookup or something else from thinking the page is
    // alive and trying to take a reference to it, clear the tracking table
    // entry pointer.

    tte := pfe^.U.Used.TrackingTableEntryPtr
    pfe^.U.Used.TrackingTableEntryPtr = NULLPTR

    KeReleaseLock ( &mmnode^.StandbyListLock )

    // Take the page lock.

    KeAcquireLockExclusive ( &pfe^.Lock )

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    IF pfe^.U.Used.TrackingTableEntryPtr == MMP_TTE_RACED_SENTINEL THEN
        // We raced with a concurrent page lookup who saw the null TTE pointer
        // that we left across dropped locks. It already reset the page's
        // tracking table entry for us and there is nothing for us to do.

        // Conversely, someone examining the TTE while holding the PFE lock can
        // see that the PFE has become stale by noting that the TTE changed
        // in the time it took them to acquire the PFE lock. They should then
        // drop the PFE lock and do a retry loop and re-examine the TTE.

        GOTO Exit
    END

    // Didn't race, so go ahead and record the page's backing information in
    // the tracking table entry before reclaiming it. This tells us how to find
    // it in, for example, a pagefile, now that its contents have been fully
    // removed from memory. This field is set by the modified page writer.

    tte^ = pfe^.U.Used.Backing

    // Check if the page is associated with a book. If not, then its tracking
    // table entry is a system PTE, which we don't want to touch further.
    // A page's TTE is a real PTE in cases of paged kernel pool and code.

    book := pfe^.U.Used.Book

    IF book AND
        (tte < &book^.EmbeddedArray[0] OR
        tte > &book^.EmbeddedArray[MMP_EMBEDDED_PAGES - 1]) THEN

        // This page is associated with a book and is not tracked in the book's
        // embedded array, so some management of the tracking tables is
        // required now that we have invalidated a TTE.

        // We can decrement the reference count on a page of TTEs, potentially
        // allowing it to be trimmed from the system working set and paged out.

        ttpfe := MmpPfnToPfe (
            MmpPfnFromPte (
                (MmpPteAddress ( tte ))^
            )
        )

        // Tracking tables should consist of in-use anonymous pages.

        KeAssert ( MmpGetPackedType ( ttpfe^.Packed ) ==
            MMP_IN_USE_PFE_TYPE )

        // This page of tracking table should have at least 2
        // references: one for being pinned (due to having this tracking
        // entry resident), and another for being in the system working
        // set.

        KeAssert ( ttpfe^.References >= 2 )

        KeIncrementUlong (
            &ttpfe^.References, // ptr
            0xFFFFFFFF, // inc
        )

        IF pfe^.U.Used.Backing == 0 THEN
            // This page's backing location is recorded as zero, which means it
            // has no backing that is owned by the memory manager. That is, we
            // weren't the ones who gave it a backing store, nor do we know
            // where to find that. This usually means this is a file page,
            // which is the province of filesystem drivers to look up.

            // Since we don't need to store backing store information for this
            // page, we should decrement the live entry count of the containing
            // tracking table, in the hope of freeing it.

            IF MmpDecrementLiveEntryCount ( tte ) != 1 THEN
                // Didn't drop the count to zero, so exit.

                GOTO Exit
            END

            // Did drop the count to zero, so we want to get rid of this table.
            // Can't do this under the PFE lock, so we have to drop it. But
            // that will cause the book's lifetime to become uncertain. So first
            // try to increment the book's reference count.

            IF NOT MmpConditionallyReferenceBook ( book ) THEN
                // Someone is actively deleting the book already and is going
                // to free this tracking table anyway, so we don't have to do
                // anything. Just exit.

                GOTO Exit
            END

            KeReleaseLockLower ( &pfe^.Lock, ipl )

            // Now we can safely delete the tracking table. We use the book
            // page number of the PFE we just allocated in order to find the
            // tracking table that needs deleting, since any pointer to it is
            // now unsafe after dropping locks.

            // This PFE is in our custody fully now so we don't need to worry
            // about the book page number changing and can pass it directly in.

            // It's possible that while locks are dropped, someone will create
            // another entry in this table, and then we shouldn't delete it.
            // It's also possible that someone else deletes it. These cases will
            // be detected under the book structure lock and will be a harmless
            // no-op.

            MmpCheckAndDeleteTrackingTable (
                book, // book
                &pfe^.U.Used.BookPageNumber, // pagenumber
            )

            // Release the reference we took out on the book. Make sure to defer
            // any deletion of the book that this causes since that isn't safe
            // to do right now.

            MmpUnreferenceBook (
                book, // book
                TRUE, // defer
            )

            RETURN pfe
        END
    END

@Exit

    KeReleaseLockLower ( &pfe^.Lock, ipl )

    RETURN pfe
END