//
// Implements support for memory nodes.
//

#INCLUDE "Mmp.hjk"

#SECTION "INITtext"
FN MmpInitializeAvailablePageList (
    IN list : ^MmpAvailablePageList,
)

    // Initialize a list of available pages.

    list^.Count = 0

    i := 0

    WHILE i < MMP_COLOR_COUNT DO
        RtlInitializeList ( &list^.Colors[i].Head )
        KeInitializeLock ( &list^.Colors[i].Lock )

        i += 1
    END
END

#SECTION "INITtext"
FN MmpInitializeNodeStage1 (
    IN mmnode : ^MmpNode,
)

    // Perform stage 1 (physical) initialization for a memory node.

    // Initialize the locks.

    KeInitializeLock ( &mmnode^.ModifiedListLock )

    // Initialize the events.

    KeInitializeEvent (
        &mmnode^.LowMemoryEvent, // event
        "LowMemory", // name
        FALSE, // notification
        FALSE, // signalstate
    )

    KeInitializeEvent (
        &mmnode^.PageAvailableEvent, // event
        "PageAvailable", // name
        TRUE, // notification
        TRUE, // signalstate
    )

    KeInitializeEvent (
        &mmnode^.LowPageAvailableEvent, // event
        "LowPageAvailable", // name
        TRUE, // notification
        TRUE, // signalstate
    )

    KeInitializeEvent (
        &mmnode^.ModifiedPageEvent, // event
        "ModifiedPages", // name
        FALSE, // notification
        FALSE, // signalstate
    )

    KeInitializeEvent (
        &mmnode^.ZeroPageEvent, // event
        "ZeroPages", // name
        FALSE, // notification
        FALSE, // signalstate
    )

    // Initialize the list heads.

    RtlInitializeList ( &mmnode^.ModifiedListHead )
    mmnode^.ModifiedPageCount = 0

    MmpInitializeAvailablePageList ( &mmnode^.FreeList )
    MmpInitializeAvailablePageList ( &mmnode^.ZeroList )
    MmpInitializeAvailablePageList ( &mmnode^.StandbyList )

    mmnode^.AvailablePageCount = 0
    mmnode^.FluidPageCount = 0

    // Initialize thresholds.

    mmnode^.LowPageCount = 0
    mmnode^.SufficientPageCount = 0
    mmnode^.ModifiedPageMaximum = 0
    mmnode^.ZeroingThreshold = 0

    mmnode^.SizeLevel = MM_UNINITIALIZED_SYSTEM

    KeInitializeLock ( &mmnode^.KernelStackPteListLock )

#IF BLD_MP
    i := 0
    procs := KeQueryMostProcessorsInAnyNode ()
    table := mmnode^.BatchedShootdowns

    WHILE i < procs DO
        KeInitializeLock ( &table[i].Lock )

        i += 1
    END

    i = 0
    table = mmnode^.AlternateBatchedShootdowns

    WHILE i < procs DO
        KeInitializeLock ( &table[i].Lock )

        i += 1
    END

    KeInitializeLock ( &mmnode^.FlushShootdownLock )
#END

END

#SECTION "INITtext"
FN MmpSetNodeSize (
    IN mmnode : ^MmpNode,
)

    // Calculate the node size and various threshold values.

    membytes := mmnode^.TotalPages << RTL_PAGE_SHIFT
    size : UWORD

    IF membytes <= 3 * 1024 * 1024 THEN
        // Tiny, 0-3MB.

        size = MM_TINY_SYSTEM

    ELSEIF membytes <= 5 * 1024 * 1024 THEN
        // Small, 3-5MB.

        size = MM_SMALL_SYSTEM

    ELSEIF membytes <= 9 * 1024 * 1024 THEN
        // Medium, 5-9MB.

        size = MM_MEDIUM_SYSTEM

    ELSEIF membytes <= 33 * 1024 * 1024 THEN
        // Large, 9-33MB.

        size = MM_LARGE_SYSTEM

    ELSE
        // Massive, >33MB.

        size = MM_MASSIVE_SYSTEM
    END

    mmnode^.SizeLevel = size

    // Set the modified page maximum.

    IF size <= MM_TINY_SYSTEM THEN
        mmnode^.ModifiedPageMaximum = 50

    ELSEIF size <= MM_LARGE_SYSTEM THEN
        mmnode^.ModifiedPageMaximum = 100

    ELSE
        mmnode^.ModifiedPageMaximum = 300
    END

    // Set the page zeroing threshold.

    IF size <= MM_TINY_SYSTEM THEN
        mmnode^.ZeroingThreshold = 75

    ELSEIF size <= MM_MEDIUM_SYSTEM THEN
        mmnode^.ZeroingThreshold = 150

    ELSE
        mmnode^.ZeroingThreshold = 500
    END

    // Set the paging thresholds.

    IF size <= MM_TINY_SYSTEM THEN
        mmnode^.LowPageCount = MMP_BLOCK_FOR_PAGES_THRESHOLD + 8
        mmnode^.SufficientPageCount = MMP_BLOCK_FOR_PAGES_THRESHOLD + 50

    ELSEIF size <= MM_LARGE_SYSTEM THEN
        mmnode^.LowPageCount = MMP_BLOCK_FOR_PAGES_THRESHOLD + 20
        mmnode^.SufficientPageCount = MMP_BLOCK_FOR_PAGES_THRESHOLD + 100

    ELSE
        mmnode^.LowPageCount = MMP_BLOCK_FOR_PAGES_THRESHOLD + 100
        mmnode^.SufficientPageCount = MMP_BLOCK_FOR_PAGES_THRESHOLD + 500
    END
END

FN MmpInsertPageIntoList (
    IN list : ^MmpAvailablePageList,
    IN pfe : ^MmpPfe,
    IN head : UWORD,
) : UWORD

    // Insert the page into the specified list, into the correct color bucket.
    // Return the count of page frames on the list before this one was added.

    pfn := MmpPfeToPfn ( pfe )
    colorlist := &list^.Colors[MmpPfnColor ( pfn )]

    ipl := KeAcquireLockExclusiveRaise ( &colorlist^.Lock )

    IF head THEN
        RtlInsertAtHeadList (
            &colorlist^.Head, // head
            &pfe^.Entry, // entry
        )

    ELSE
        RtlInsertAtTailList (
            &colorlist^.Head, // head
            &pfe^.Entry, // entry
        )
    END

    oldcount := KeIncrementPtr (
        &list^.Count, // ptr
        1, // inc
    )

    KeReleaseLockLower ( &colorlist^.Lock, ipl )

    RETURN oldcount
END

FN MmpAllocatePageFromList (
    IN list : ^MmpAvailablePageList,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page, preferably with the given color, from the list.

    i := 0

    WHILE i < MMP_COLOR_COUNT DO
        colorlist := &list^.Colors[color]

        ipl := KeAcquireLockExclusiveRaise ( &colorlist^.Lock )

        entry := colorlist^.Head.Next

        IF entry != &colorlist^.Head THEN
            // Found one. Pop it from the head.

            RtlRemoveEntryList ( entry )

            KeIncrementPtr (
                &list^.Count, // ptr
                -1, // inc
            )

            KeReleaseLockLower ( &colorlist^.Lock, ipl )

            RETURN CONTAINEROF entry TO MmpPfe.Entry
        END

        KeReleaseLockLower ( &colorlist^.Lock, ipl )

        color = (color + 1) & (MMP_COLOR_COUNT - 1)
        i += 1
    END

    RETURN NULLPTR
END

FN MmpAllocatePageFromStandbyList (
    IN mmnode : ^MmpNode,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page from the given standby list.

    list := &mmnode^.StandbyList

    pfe : ^MmpPfe
    colorlist : ^MmpAvailablePageListColor
    ipl : UWORD
    object : ^MmuObject

    i := 0

    WHILE TRUE DO
        colorlist = &list^.Colors[color]

        ipl = KeAcquireLockExclusiveRaise ( &colorlist^.Lock )

        entry := colorlist^.Head.Next

        IF entry != &colorlist^.Head THEN
            pfe = CONTAINEROF entry TO MmpPfe.Entry

            // Found a page on this list. Capture its object and disassociate it
            // by clearing the object pointer. If a page lookup within the
            // object finds this page before we lock the object below and fully
            // clear the tracking PTE, it will find that the object pointer has
            // been cleared and will know that we're executing this path and
            // will clear the tracking PTE itself. It will also increment a
            // refcount on the object so that we don't hold a stale pointer to
            // it.

            object = pfe^.Object
            pfe^.Object = NULLPTR

            RtlRemoveEntryList ( &pfe^.Entry )

            KeIncrementPtr (
                &list^.Count, // ptr
                -1, // inc
            )

            KeReleaseLock ( &colorlist^.Lock )

            BREAK
        END

        KeReleaseLockLower ( &colorlist^.Lock, ipl )

        color = (color + 1) & (MMP_COLOR_COUNT - 1)
        i += 1

        IF i >= MMP_COLOR_COUNT THEN
            RETURN NULLPTR
        END
    END

    unrefobject := FALSE

    // No need to call this as APC-safe since we're already blocking out APCs
    // since we didn't lower IPL when we released the colorlist lock.

    KeAcquireLockExclusive ( &object^.StructureLock )

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    IF pfe^.TrackingTableEntry == NULLPTR THEN
        // A concurrent page lookup cleared the tracking table entry after
        // noticing that we were in the middle of stealing this page. It added a
        // reference to the object to stop our pointer to it from becoming
        // stale, which we will need to unreference below.

        unrefobject = TRUE

    ELSE
        MmpClearTrackingTableEntry (
            object, // object
            pfe, // pfe
        )
    END

    KeReleaseLockLower ( &object^.StructureLock, ipl )

    IF unrefobject THEN
        MmpUnreferenceObject (
            object, // object
            TRUE, // defer
        )
    END

    RETURN pfe
END

FN MmpMakeMorePages (
    IN mmnode : ^MmpNode,
)

    // Try to make free pages, asynchronously.

    IF mmnode^.LowMemoryEvent.Header.SignalCount == 0 THEN
        // Signal my own low memory event.

        KeSignalEvent (
            &mmnode^.LowMemoryEvent, // event
            0, // priorityboost
        )
    END

#IF BLD_NUMA
    // Scan neighboring nodes to see if any of them borrowed a substantial
    // number of page frames from me. If so, signal them too.

    nodelist := mmnode^.KeNode^.DistanceList

    WHILE nodelist[0] DO
        othernode := nodelist[0]^.Mmp

        IF othernode^.BorrowCounts[mmnode^.Id] >= MMP_SIGNIFICANT_BORROWS THEN
            // Set its borrow count from us to zero to avoid uselessly doing
            // this again and again. Intentionally don't use an atomic here.

            othernode^.BorrowCounts[mmnode^.Id] = 0

            IF othernode^.LowMemoryEvent.Header.SignalCount == 0 THEN
                // Signal its low memory event to get our page frames back.

                KeSignalEvent (
                    &othernode^.LowMemoryEvent, // event
                    0, // priorityboost
                )
            END
        END

        nodelist += SIZEOF ^KeuNode
    END
#END

END

FN MmpReferencePage (
    IN pfe : ^MmpPfe,
)

    // Increment the reference count on the page. This must either be a page
    // with a refcount that is already non-zero, or a page that is on the
    // modified list.

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    refcount := pfe^.References

    WHILE TRUE DO
        IF refcount == 0 THEN
            // If the reference count is zero, then the page is on a list and
            // needs special handling.

            BREAK
        END

        new := KeCompareSwapUlong (
            &pfe^.References, // ptr
            refcount + 1, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            LEAVE
        END

        refcount = new
    END

    // Reference count was zero, so we need to remove the page from a list.
    //
    // Only modified pages can be encountered in this state by this routine.
    // Free pages are only taken off that list by MmpAllocatePage, and standby
    // pages are only taken off that list by object lookups and
    // MmpAllocatePageFromStandbyList, due to special synchronization
    // requirements. It IS valid however to call this routine on a standby page
    // whose refcount you already know for a fact to be greater than zero, and
    // in fact it is the preferred method for doing so.

    // TODO: Remove the below, it isn't actually needed and is just included as
    //       an example of the locking protocol until page lookups within
    //       objects are implemented.

    packed := pfe^.Packed

    KeAssert ( MmpGetPackedFlag ( packed, MMP_MODIFIED_PFE_FLAG ) )

    mmnode := KeNumaNodeById ( MmpGetPackedNodeId ( packed ) )^.Mmp

    ipl := KeAcquireLockExclusiveRaise ( &mmnode^.ModifiedListLock )

    refcount = KeIncrementUlong (
        &pfe^.References, // ptr
        1, // inc
    )

    IF refcount == 0 THEN
        // Reference count was zero, so the page was on the modified page list,
        // which needs to be removed from.

        RtlRemoveEntryList ( &pfe^.Entry )

        mmnode^.ModifiedPageCount -= 1
    END

    KeReleaseLockLower ( &mmnode^.ModifiedListLock, ipl )
END

FN MmpUnreferencePage (
    IN pfe : ^MmpPfe,
)

    // Decrement the page's reference count.

    KeAssert ( MmpGetPackedType ( pfe^.Packed ) == MMP_IN_USE_PFE_TYPE )

    refcount := pfe^.References

    KeAssert ( refcount != 0 )

    WHILE TRUE DO
        IF refcount == 1 THEN
            // If this is the last reference, then special handling is required
            // in order to place the page on a list.

            BREAK
        END

        new := KeCompareSwapUlong (
            &pfe^.References, // ptr
            refcount - 1, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            LEAVE
        END

        refcount = new
    END

    // Acquire the page lock to block out concurrent modifications of the packed
    // flags that may affect which list it is supposed to go to now.

    ipl := KeAcquireLockExclusiveRaise ( &pfe^.Lock )

    packed := pfe^.Packed

    IF MmpGetPackedFlag ( packed, MMP_DELETED_PFE_FLAG ) THEN
        // The page was deleted, so it must be freed now that the last reference
        // has gone away.

        KeReleaseLockLower ( &pfe^.Lock, ipl )

        MmpFreePage ( pfe )

        LEAVE
    END

    mmnode := KeNumaNodeById ( MmpGetPackedNodeId ( packed ) )^.Mmp

    IF MmpGetPackedFlag ( packed, MMP_MODIFIED_PFE_FLAG ) THEN
        // The page was modified, so it must be placed on the modified page
        // list for its home node.

        KeAcquireLockExclusive ( &mmnode^.ModifiedListLock )

        refcount = KeIncrementUlong (
            &pfe^.References, // ulong
            0xFFFFFFFF, // inc
        )

        IF refcount == 1 THEN
            RtlInsertAtTailList (
                &mmnode^.ModifiedListHead, // listhead
                &pfe^.Entry, // entry
            )

            mmnode^.ModifiedPageCount += 1
        END

        // The order of releasing the page lock and list lock is important
        // because we dropped our refcount, so it is no longer safe to touch
        // the page lock after we release the list lock.

        KeReleaseLock ( &pfe^.Lock )

        KeReleaseLockLower ( &mmnode^.ModifiedListLock, ipl )

        IF mmnode^.ModifiedPageCount >= mmnode^.ModifiedPageMaximum AND
            mmnode^.ModifiedPageEvent.Header.SignalCount == 0 THEN

            // The modified page list is longer than the limit, so signal the
            // modified page writer.

            KeSignalEvent (
                &mmnode^.ModifiedPageEvent, // event
                0, // priorityboost
            )
        END

        LEAVE
    END

    // The page was neither deleted nor modified, so put it on the standby list.

    color := MmpPfnColor ( MmpPfeToPfn ( pfe ) )
    colorlist := &mmnode^.StandbyList.Colors[color]

    KeAcquireLockExclusive ( &colorlist^.Lock )

    refcount = KeIncrementUlong (
        &pfe^.References, // ulong
        0xFFFFFFFF, // inc
    )

    IF refcount == 1 THEN
        RtlInsertAtTailList (
            &colorlist^.Head, // listhead
            &pfe^.Entry, // listentry
        )

        KeIncrementPtr (
            &mmnode^.StandbyList.Count, // ptr
            1, // inc
        )

        // The order of releasing the page lock and list lock is important
        // because we dropped our refcount, so it is no longer safe to touch
        // the page lock after we release the list lock.

        KeReleaseLock ( &pfe^.Lock )

        KeReleaseLockLower ( &colorlist^.Lock, ipl )

        MmpIncrementAvailablePages (
            mmnode, // mmnode
            1, // inc
        )

        LEAVE
    END

    // The order of releasing the page lock and list lock is important
    // because we dropped our refcount, so it is no longer safe to touch
    // the page lock after we release the list lock.

    KeReleaseLock ( &pfe^.Lock )

    KeReleaseLockLower ( &colorlist^.Lock, ipl )
END

FN MmpAllocatePage (
    IN mmnode : ^MmpNode,
    IN flags : UWORD,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page from the given node. If none available, return
    // NULLPTR.

#IF BLD_NUMA
    nodelist : ^^KeuNode = NULLPTR
    originalnode := mmnode

    KeAssert ( originalnode^.KeNode^.ProcessorCount != 0 )
#END

@Retry

    avail := mmnode^.AvailablePageCount
    new : UWORD

    IF avail <= mmnode^.LowPageCount
#IF BLD_NUMA
        AND mmnode == originalnode
#END
        THEN

        // Too few pages. Try to make more, asynchronously.

        MmpMakeMorePages ( mmnode )
    END

    WHILE TRUE DO
        IF avail <= 0 OR
            (flags & MM_ALLOCATE_LOW == 0 AND
            avail <= MMP_BLOCK_FOR_PAGES_THRESHOLD) THEN

            // Not enough pages.

            // Note that the available page count can briefly become negative
            // due to a race between standby page reclamation, and page lookup
            // within an object. Any non-positive available page count means
            // functionally that no pages are available.

#IF BLD_NUMA
            IF flags & MM_ALLOCATE_NO_BORROW == 0 THEN
                GOTO TryNextNode
            END
#END

            RETURN NULLPTR
        END

        // Atomically claim a single page frame by a CAS loop.

        new = KeCompareSwapPtr (
            &mmnode^.AvailablePageCount, // ptr
            avail - 1, // newvalue
            avail, // expectedvalue
        )

        IF new == avail THEN
            BREAK
        END

        avail = CAST new TO WORD
    END

    color &= MMP_COLOR_COUNT - 1

    pfe : ^MmpPfe = NULLPTR

    mustzero := FALSE

    IF flags & MM_ALLOCATE_ZERO THEN
        IF mmnode^.ZeroList.Count THEN
            pfe = MmpAllocatePageFromList (
                &mmnode^.ZeroList, // list
                color, // color
            )

        ELSE
            // Need to grab a free or standby page. Make sure to zero out the
            // page outside the list lock.

            mustzero = TRUE

            IF mmnode^.FreeList.Count THEN
                pfe = MmpAllocatePageFromList (
                    &mmnode^.FreeList, // list
                    color, // color
                )

            ELSE
                pfe = MmpAllocatePageFromStandbyList (
                    mmnode, // mmnode
                    color, // color
                )
            END
        END

    ELSEIF mmnode^.FreeList.Count THEN
        pfe = MmpAllocatePageFromList (
            &mmnode^.FreeList, // list
            color, // color
        )

    ELSEIF mmnode^.ZeroList.Count THEN
        pfe = MmpAllocatePageFromList (
            &mmnode^.ZeroList, // list
            color, // color
        )

    ELSE
        pfe = MmpAllocatePageFromStandbyList (
            mmnode, // mmnode
            color, // color
        )
    END

    IF NOT pfe THEN
        // There is a race condition where after we claim an available page off
        // the count, a standby page can be taken off the list by a page lookup
        // within an object, which can make all of the lists empty even after
        // we successfully allocated a count. The available page count can also
        // become negative due to this. We might spin forever if we don't break
        // out here. Rather than do that, release the count we took, and return
        // NULLPTR.

        MmpIncrementAvailablePages (
            mmnode, // mmnode
            1, // inc
        )

#IF BLD_NUMA
        IF flags & MM_ALLOCATE_NO_BORROW == 0 THEN
            GOTO TryNextNode
        END
#END

        RETURN NULLPTR
    END

#IF BLD_CHK
    pfe^.Packed = MmpPackType ( pfe^.Packed, MMP_IN_USE_PFE_TYPE )
#END

    IF mustzero THEN
        KeAssert ( pfe != NULLPTR )

        MmZeroPage (
            MmpPfeToPfn ( pfe ), // pfn
            0, // offset
            RTL_PAGE_SIZE, // length
        )
    END

#IF BLD_NUMA
    IF originalnode != mmnode THEN
        // We're borrowing the page frame, so record that with a saturating
        // 16-bit counter. This does not need atomics since its a hint, so a
        // lost count isn't a big deal.

        oldvalue := originalnode^.BorrowCounts[mmnode^.Id]

        IF oldvalue != 0xFFFF THEN
            originalnode^.BorrowCounts[mmnode^.Id] = oldvalue + 1
        END
    END
#END

    RETURN pfe

#IF BLD_NUMA
@TryNextNode

    // Look at the next most distant node from this one.

    IF NOT nodelist THEN
        nodelist = mmnode^.KeNode^.DistanceList
    END

    WHILE nodelist[0] DO
        IF nodelist[0]^.Mmp^.PagefileState == mmnode^.PagefileState THEN
            // This node has the same pagefile pool and commit tracking so we
            // can borrow from it.

            mmnode = nodelist[0]^.Mmp

            nodelist += SIZEOF ^KeuNode

            GOTO Retry
        END

        nodelist += SIZEOF ^KeuNode
    END

    RETURN NULLPTR
#END

END

FN MmpFreePage (
    IN pfe : ^MmpPfe,
)

    // Free the page.

    packed := pfe^.Packed

#IF BLD_CHK
    pfe^.Packed = MmpPackType ( packed, MMP_FREE_PFE_TYPE )
#END

    mmnode := KeNumaNodeById ( MmpGetPackedNodeId ( packed ) )^.Mmp

    // Insert at the head so that we reuse it more quickly (hot in cache).

    count := MmpInsertPageIntoList (
        &mmnode^.FreeList, // list
        pfe, // pfe
        TRUE, // head
    )

    MmpIncrementAvailablePages (
        mmnode, // mmnode
        1, // inc
    )

    IF count > mmnode^.ZeroingThreshold AND
        mmnode^.ZeroPageEvent.Header.SignalCount == 0 THEN

        // Wake the zero page worker.

        KeSignalEvent (
            &mmnode^.ZeroPageEvent, // event
            0, // priorityboost
        )
    END
END

FN MmpIncrementAvailablePages (
    IN mmnode : ^MmpNode,
    IN increment : UWORD,
) : WORD

    // Increment the number of available pages and return the old count.
    // If needed, signal page-available events to wake waiters.

    old := CAST KeIncrementPtr (
        &mmnode^.AvailablePageCount, // ulong
        increment, // inc
    ) TO WORD

    IF old >= MMP_BLOCK_FOR_PAGES_THRESHOLD AND
        mmnode^.PageAvailableEvent.Header.SignalCount == 0 THEN

        // Signal the available page event.

        KeSignalEvent (
            &mmnode^.PageAvailableEvent, // event
            0, // priorityboost
        )
    END

    IF old >= 0 AND
        mmnode^.LowPageAvailableEvent.Header.SignalCount == 0 THEN

        // Signal the low page available event.

        KeSignalEvent (
            &mmnode^.LowPageAvailableEvent, // event
            0, // priorityboost
        )
    END

    RETURN old
END

#DEFINE MMP_MIN_LOOPS_FOR_BACKOFF 2
#DEFINE MMP_INITIAL_BACKOFF_MS 5
#DEFINE MMP_MAX_BACKOFF_MS 1000

FN MmpWaitForPages (
    IN mmnode : ^MmpNode,
    IN low : UWORD,
)

    // Wait for available pages to exist from the given node.
    // This function provides no guarantees - caller will have to repeatedly
    // call it until MmpAllocatePage yields a page.
    //
    // Note that each time this function returns, the caller should retry its
    // entire allocation path. For example, if the caller is a cache layer, then
    // it should try to look for a cached block to have appeared to take instead
    // of calling this function again. This avoids a class of resource
    // granularity deadlocks (described below).
    //
    // Randomized exponential back-off is performed to mitigate thundering herd.
    // Some bits of the current thread pointer are used as a seed for xorshift.

    loops := 0
    threshold : UWORD
    event : ^KeEvent

    timeout : RtlUquad
    RtlSetUquadToUlong ( &timeout, 5000 )

    backoff : RtlUquad
    backoffms := MMP_INITIAL_BACKOFF_MS

    IF low THEN
        threshold = 0
        event = &mmnode^.LowPageAvailableEvent

    ELSE
        threshold = MMP_BLOCK_FOR_PAGES_THRESHOLD
        event = &mmnode^.PageAvailableEvent
    END

    WHILE TRUE DO
        // Wait on the event until we catch the available page count at a
        // sufficient level.

        IF mmnode^.AvailablePageCount > threshold THEN
            LEAVE
        END

        KeResetEvent ( event )

        IF mmnode^.AvailablePageCount > threshold THEN
            // Inbetween checking the threshold and resetting the event, the
            // available page count became sufficient again, so we should
            // signal the event and return otherwise we may deadlock ourselves
            // or other threads.

            KeSignalEvent (
                event, // event
                0, // priorityboost
            )

            LEAVE
        END

        IF loops >= MMP_MIN_LOOPS_FOR_BACKOFF THEN
            // Perform exponential backoff.

            seed : UWORD

            IF loops == MMP_MIN_LOOPS_FOR_BACKOFF THEN
                // Initialize the xorshift seed which is the low bits of the
                // current thread pointer shifted right by the natural
                // alignment and XORed with the VPN and the current uptime.
                // This tries to improve uniqueness of the seed between each
                // thread and over time.

                thrd := KeCurrentThread ()
                seed = (thrd >> RTL_ALIGN_SHIFT) $ (thrd >> RTL_PAGE_SHIFT)
            END

            // XOR with bits of the uptime every iteration.

#IF ( == BLD_BITS 32 )
            seed $= KeCurrentVolatileNode ()^.SharedUserPage^.Uptime.Low
#ELSE
            seed $= KeCurrentVolatileNode ()^.SharedUserPage^.Uptime.Quad
#END

            // Jitter the backoff interval by the low 4 bits of the seed.

            backoffms += seed & 15

            IF backoffms >= MMP_MAX_BACKOFF_MS THEN
                // This thread has been waiting a long time for pages and may
                // be starved by newcoming threads. Reset the backoff interval
                // to a small random value in order to compete with them.

                backoffms = 1 + (seed & 31)
                loops = 0
            END

            RtlSetUquadToUlong (
                &backoff, // uquad
                backoffms, // ulong
            )

            KeSleep (
                &backoff, // interval
                KE_KERNEL_MODE, // waitmode
                FALSE, // alertable
                NULLPTR, // continuation
            )

            // Multiply the backoff interval by two.

            backoffms *= 2

            seed $= seed << 13
            seed $= seed >> 17
            seed $= seed << 5
        END

        status := KeWaitForSingleObject (
            KE_KERNEL_MODE, // waitmode
            KE_UNALERTABLE, // alertable
            &timeout, // timeout
            &event^.Header, // object
            NULLPTR, // continuation
        )

        IF status == OS_STATUS_WAIT_TIMEOUT THEN
            // No pages were freed for several seconds. Return to the upper
            // level codepath so that it can retry. If we're lucky, we might be
            // able to pick up a newly freed pool block, or something else that
            // obviates the need to grab a page frame at all.
            //
            // This actually mitigates a possible class of deadlocks where, for
            // example, the entirety of physical memory may be filled with pool
            // pages, and pool blocks are being allocated and freed, but no
            // physical pages are ever freed. Instead of sitting here forever,
            // we should retry so we can grab one of those freed pool blocks.
            // This should be very rare.

            LEAVE
        END

        loops += 1
    END
END

FN MmpAllocatePageWait (
    IN mmnode : ^MmpNode,
    IN flags : UWORD,
    IN color : UWORD,
) : ^MmpPfe

    // Allocate a page with the given parameters. Allowed to wait.

    WHILE TRUE DO
        pfe := MmpAllocatePage (
            mmnode, // mmnode
            flags, // flags
            color, // color
        )

        IF pfe THEN
            RETURN pfe
        END

        MmpWaitForPages (
            mmnode, // mmnode
            flags & MM_ALLOCATE_LOW, // low
        )
    END
END

FN MmuChargeCommit (
    IN mmnode : ^MmpNode,
    IN pages : UWORD,
    IN flags : UWORD,
) : OsStatus

    // Attempt to charge the specified commit to the memory node.
    // It would be unwise to page this routine as it can be called during
    // nonpaged pool allocation.

    vmprivileged := PsCurrentThread()^.VmPrivileged

    IF pages > RTL_MACHINE_WORD_MAX_S THEN
        // Page count overflows and is negative.

        KeAssert ( NOT vmprivileged )

        RETURN OS_STATUS_COMMIT_EXCEEDED
    END

    pfs := mmnode^.PagefileState

    remaining := pfs^.CommitRemaining

    WHILE TRUE DO
        IF remaining < RTL_MACHINE_WORD_MIN_S + pages THEN
            // Underflow would result from this subtraction.

            KeAssert ( NOT vmprivileged )

            RETURN OS_STATUS_COMMIT_EXCEEDED
        END

        IF NOT vmprivileged AND
            (remaining - pages < -pfs^.CommitLimitGrowthLeft) THEN

            // Don't even bother trying, there's no way to extend the pagefiles
            // to accommodate this because the theoretical commit limit
            // represents what we could theoretically increase the commit limit
            // to if we were to extend all of the pagefiles to their maximum
            // size.

            RETURN OS_STATUS_COMMIT_EXCEEDED
        END

        new := CAST KeCompareSwapPtr (
            &pfs^.CommitRemaining, // ptr
            remaining - pages, // newvalue
            remaining, // expectedvalue
        ) TO WORD

        IF new == remaining THEN
            BREAK
        END

        remaining = new
    END

    IF pfs^.CommitRemaining >= pfs^.CommitRemainingMinimum THEN
        // Plenty of commit left after charging.

        RETURN OS_STATUS_SUCCESS
    END

    // Not much commit left, so we're responsible for signaling pagefile
    // expansion.

    status := MmpExpandPagefiles (
        pfs, // pagefilestate
        (flags & MM_ALLOCATE_WAIT) AND NOT vmprivileged, // wait
        FALSE, // full
    )

    IF vmprivileged THEN
        // Proceed immediately with a successful status no matter what.

        RETURN OS_STATUS_SUCCESS
    END

    IF OsError ( status ) THEN
        // Failed to increase commit limit.
        // Remove the commit charge.

        KeIncrementPtr (
            &pfs^.CommitRemaining, // ptr
            pages, // inc
        )
    END

    RETURN status
END

FN MmuUnchargeCommit (
    IN mmnode : ^MmpNode,
    IN pages : UWORD,
)

    // Remove the specified commit charge from the node.
    // If pagefiles can now be contracted, that will be noticed at the next tick
    // of the responsible worker thread.

    pfs := mmnode^.PagefileState

    KeIncrementPtr (
        &pfs^.CommitRemaining, // ptr
        pages, // inc
    )
END

EXPORT FN MmGetKeNodeSize (
    IN kenode : ^KeuNode,
) : UWORD

    // Get the size of the given node.

    RETURN kenode^.Mmp^.SizeLevel
END

EXPORT FN MmGetMmNodeSize (
    IN mmnode : ^MmpNode,
) : UWORD

    // Get the size of the given node.

    RETURN mmnode^.SizeLevel
END

FN MmuNodeToKeNode (
    IN mmnode : ^MmpNode,
) : ^KeuNode

    RETURN mmnode^.KeNode
END