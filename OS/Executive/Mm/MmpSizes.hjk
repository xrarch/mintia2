//
// Common header for structure sizes used by Loader and Executive.
//

// VPN DB entry size.

#IF ( == BLD_BITS 32 )
    #DEFINE MMP_VPE_SIZE 64
    #DEFINE MMP_VPNDB_PER_FILTER 64
#ELSE
    #DEFINE MMP_VPE_SIZE 64
    #DEFINE MMP_VPNDB_PER_FILTER 256
#END

// PFN DB entry size.


#IF BLD_LOCKDEP
#IF ( == BLD_BITS 32 )
    #DEFINE MMP_PFE_SIZE 44
#ELSE
    #DEFINE MMP_PFE_SIZE 72
#END
#ELSE

#IF ( == BLD_BITS 32 )
    #DEFINE MMP_PFE_SIZE 40
#ELSE
    #DEFINE MMP_PFE_SIZE 64
#END

#END
