//
// Implements actions, which are little refcounted memory blocks that can be
// waited upon for another thread to finish performing some action, without
// requiring complicated lifetime guarantees.
//
// These are an abstraction atop KeLock.
//

#INCLUDE "Exp.hjk"

STRUCT ExpActionWaitable
    Lock : KeLock,
    References : ULONG,
END

#SECTION "INITtext"
FN ExpInitializeActionsForNode (
    IN kenode : ^KeuNode,
)

    // Initialize the action cache.

    IF NOT kenode^.Exp THEN
        LEAVE
    END

    status := MmCreateObjectCache (
        kenode, // kenode
        "Actions", // name
        0, // flags
        SIZEOF ExpActionWaitable, // objectsize
        TRUE, // magazinecached
        FALSE, // pageable
        RTL_ALIGN_BYTES, // align
        OUT kenode^.Exp^.ActionCache, // ptr
    )

#ENTERSECTION "INITtext"
    IF OsError ( status ) THEN
        KeCrash ( "ExpInitializeActions: failed to create cache\n" )
    END
#LEAVESECTION

END

#SECTION "INITtext"
FN ExpInitializeActions ()

    // Initialize the action caches.

    i := 0
    nodes := KeQueryNodeCount ()

    WHILE i < nodes DO
        kenode := KeNumaNodeById ( i )

        ExpInitializeActionsForNode ( kenode )

        i += 1
    END
END

EXPORT FN ExPrepareWaitForAction (
    IN action : ^ExAction,
    IN flags : UWORD,
    OUT waitable : ^ExpActionWaitable,
) : OsStatus

    // Get a waitable action block in preparation for waiting on the action's
    // completion to be signaled. Caller is responsible for preventing another
    // instance of ExPrepareWaitForAction or ExCompleteAction executing
    // simultaneously on the same ExAction.

    waitable = action^.Waitable

    // Caller should ensure the action is in progress.

    KeAssert ( waitable != NULLPTR )

    IF waitable & EXP_ACTION_WAITABLE_PTR THEN
        // The waitable has already been created, so just increment its
        // reference count.

        waitable &= ~EXP_ACTION_WAITABLE_PTR

        KeIncrementUlong (
            &waitable^.References, // ptr
            1, // inc
        )

    ELSE
        // The action hasn't been waited on yet, so we need to allocate the
        // reference counted KeLock for it.

        owner := waitable

        expnode := KeCurrentVolatileNode ()^.Exp

        status := MmAllocateFromObjectCache (
            expnode^.ActionCache, // cache
            flags, // flags
            'ExAc', // tag
            OUT waitable, // ptr
        )

        IF OsError ( status ) THEN
            RETURN status
        END

        // Initialize with 1 reference representing myself.

        waitable^.References = 1

        // Initialize the KeLock held exclusive by the thread performing the
        // action (whose pointer is stored in the action).

        KeInitializeLockWithOwner (
            &waitable^.Lock, // ptr
            owner, // owner
        )
    END

    RETURN OS_STATUS_SUCCESS
END

EXPORT FN ExWaitForActionCompletion (
    IN waitable : ^ExpActionWaitable,
)

    // Wait for an action to be completed by the thread performing it.
    // No synchronization required by the caller.

    // First wait for lock release (may cause priority inheritance etc).

    KeWaitForLockRelease ( &waitable^.Lock )

    // Unreference the waitable block.

    oldcount := KeIncrementUlong (
        &waitable^.References, // ptr
        0xFFFFFFFF, // inc
    )

    IF oldcount == 1 THEN
        // We're the last waiter and responsible for freeing the waitable.

        expnode := KeNumaNodeFromSpacePointer ( waitable )^.Exp

        MmFreeToObjectCache (
            expnode^.ActionCache, // objectcache
            waitable, // waitable
            'ExAc', // tag
        )
    END
END

EXPORT FN ExCompleteAction (
    IN action : ^ExAction,
)

    // Complete the action.
    // Caller is responsible for preventing another instance of
    // ExPrepareWaitForAction or ExCompleteAction executing simultaneously on
    // the same ExAction.

    waitable := action^.Waitable
    action^.Waitable = NULLPTR

    IF waitable & EXP_ACTION_WAITABLE_PTR THEN
        // There are waiters who need to be awoken.

        waitable &= ~EXP_ACTION_WAITABLE_PTR

        KeReleaseLock ( &waitable^.Lock )
    END
END