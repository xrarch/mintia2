//
// Management for string internment for the MINTIA Executive.
//

#INCLUDE "Exp.hjk"

#SECTION "PAGEtext"
EXPORT FN ExuFastComputeNameLength (
    IN buf : ^UBYTE,
) : UWORD

    // Compute the length of a 16-byte interned string buffer quickly, since
    // we make room for more string bytes rather than stashing the length.

    // We know that it is at least word aligned and the buffer is exactly
    // 16 bytes, and that the entire buffer after the last byte is zeroed, so
    // we can optimize this a bit.

    // We also know that it is not zero length because zero length strings are
    // never inlined.

    // Little-endian is intentionally the only thing supported here since we
    // don't plan to support any big-endian architectures.

    longbuf := CAST buf TO ^ULONG

    long := longbuf[0]

    IF (long - 0x01010101) & ~long & 0x80808080 THEN
        // First long has a null byte so find it.

        IF long & 0x0000FF00 == 0 THEN
            RETURN 1
        END

        IF long & 0x00FF0000 == 0 THEN
            RETURN 2
        END

        RETURN 3
    END

    long = longbuf[1]

    IF (long - 0x01010101) & ~long & 0x80808080 THEN
        // Second long has a null byte so find it.

        IF long == 0 THEN
            RETURN 4
        END

        IF long & 0x0000FF00 == 0 THEN
            RETURN 5
        END

        IF long & 0x00FF0000 == 0 THEN
            RETURN 6
        END

        RETURN 7
    END

    long = longbuf[2]

    IF (long - 0x01010101) & ~long & 0x80808080 THEN
        // Third long has a null byte so find it.

        IF long == 0 THEN
            RETURN 8
        END

        IF long & 0x0000FF00 == 0 THEN
            RETURN 9
        END

        IF long & 0x00FF0000 == 0 THEN
            RETURN 10
        END

        RETURN 11
    END

    long = longbuf[3]

    IF (long - 0x01010101) & ~long & 0x80808080 THEN
        // Fourth long has a null byte so find it.

        IF long == 0 THEN
            RETURN 12
        END

        IF long & 0x0000FF00 == 0 THEN
            RETURN 13
        END

        IF long & 0x00FF0000 == 0 THEN
            RETURN 14
        END

        RETURN 15
    END

    // Should be unreachable but just return some sane-ish value.

    RETURN 16
END

STRUCT ExpName
    String : RtlString,

    Entry : RtlAvlNode,

    References : ULONG,
END

#SECTION "INITtext"
FN ExpInitializeNamesForNode (
    IN expnode : ^ExpNode,
)

    // Initialize the interned name buckets.

    i := 0

    WHILE i < EXP_NAME_BUCKETS DO
        RtlInitializeAvl ( &expnode^.NameBuckets[i].TreeRoot )
        KeInitializeLock ( &expnode^.NameBuckets[i].Lock, "NameBucket" )

        i += 1
    END
END

#SECTION "INITtext"
FN ExpInitializeNames ()

    // Initialize the interned name buckets.

    i := 0
    nodes := KeQueryNodeCount ()

    WHILE i < nodes DO
        expnode := KeNumaNodeById ( i )^.Exp

        IF expnode THEN
            ExpInitializeNamesForNode ( expnode )
        END

        i += 1
    END
END

#SECTION "PAGEtext"
FN (RtlAvlLessThanF) ExpCompareNameNodes (
    IN a : ^RtlAvlNode,
    IN b : ^RtlAvlNode,
) : UWORD

    // Return whether A < B, lexicographically.

    RETURN CAST RtlCompareRtlString (
        &(CONTAINEROF a TO ExpName.Entry)^.String, // str1
        &(CONTAINEROF b TO ExpName.Entry)^.String, // str2
    ) TO WORD < 0
END

#SECTION "PAGEtext"
FN ExpHashAndValidateString (
    IN str : ^RtlString,
    OUT hash : UWORD,
) : OsStatus

    // Simple hash for a string. Make sure this algorithm stays in sync with
    // ExpHashString below.
    //
    // Also checks for embedded null bytes before the end of len, which are
    // illegal. This might seem like a strange place to do that, but it's
    // to avoid having a second place where we iterate over the string, we can
    // just do it all at once.

    data := str^.Data
    len := str^.Length

    hash = 0

    WHILE len DO
        IF data^ == 0 THEN
            // Embedded null byte is bad.

            RETURN OS_STATUS_ILLEGAL_STRING
        END

        hash += data^
        hash += hash << 10
        hash $= hash >> 6

        data += 1
        len -= 1
    END

    hash += hash << 3
    hash $= hash >> 11
    hash += hash << 15

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
FN ExpHashString (
    IN data : ^UBYTE,
) : UWORD

    // Simple hash for a string. Make sure this algorithm stays in sync with
    // ExpHashAndValidateString.
    //
    // Doesn't do validation, since that was done earlier (or is not needed)
    // and that would be redundant work for the caller.

    hash := 0

    WHILE data^ DO
        hash += data^
        hash += hash << 10
        hash $= hash >> 6

        data += 1
    END

    hash += hash << 3
    hash $= hash >> 11
    hash += hash << 15

    RETURN hash
END

#SECTION "PAGEtext"
FN ExpCopyToInlinedBuffer (
    IN dest : ^UBYTE,
    IN src : ^UBYTE,
    IN len : UWORD,
) : OsStatus

    // Optimized copy of src to dest plus zero fill of remaining area.
    // While we're at it we also validate that there are no null bytes.
    // There's no guarantee that an error return leaves dest intact.

    // We can optimize based on the fact the destination buffer is guaranteed
    // to be 32-bit aligned and we know the length of the source buffer.
    // We also know that the destination buffer is exactly 16 bytes and must
    // end with a null byte, and that length is at least 1 and no more than 15.

    destbuf := CAST dest TO ^ULONG
    srcbuf := CAST src TO ^ULONG

    bytes := len & 3
    off := len - bytes

    i : UWORD

    IF (src & 3) != 0 THEN
        // Source buffer isn't 32-bit aligned so do a dumb byte copy up until
        // the final bytes, and then join the common code for the last bytes and
        // the zero fill.

        i = 0

        WHILE i < off DO
            dest[i] = src[i]

            IF src[i] == 0 THEN
                GOTO Error
            END

            i += 1
        END

        GOTO Common
    END

    // First copy full longs.

    i = srcbuf[0]

    IF len >= 4 THEN
        destbuf[0] = i

        IF (i - 0x01010101) & ~i & 0x80808080 THEN
            // There's an embedded null byte which is not allowed.

            GOTO Error
        END

        IF len >= 8 THEN
            i = srcbuf[1]

            destbuf[1] = i

            IF (i - 0x01010101) & ~i & 0x80808080 THEN
                // There's an embedded null byte which is not allowed.

                GOTO Error
            END

            IF len >= 12 THEN
                i = srcbuf[2]

                destbuf[2] = i

                IF (i - 0x01010101) & ~i & 0x80808080 THEN
                    // There's an embedded null byte which is not allowed.

                    GOTO Error
                END
            END
        END
    END

@Common

    // Now copy end bytes.

    IF bytes THEN
        // Fill final long with 0 first so that we don't have to do it manually
        // in a byte-wise manner.

        destbuf[off / 4] = 0

        IF src[off] == 0 THEN
            GOTO Error
        END

        IF bytes == 3 THEN
            dest[off] = src[off]
            dest[off + 1] = src[off + 1]
            dest[off + 2] = src[off + 2]

            IF src[off + 1] == 0 OR
                src[off + 2] == 0 THEN

                GOTO Error
            END

        ELSEIF bytes == 2 THEN
            dest[off] = src[off]
            dest[off + 1] = src[off + 1]

            IF src[off + 1] == 0 THEN
                GOTO Error
            END

        ELSEIF bytes == 1 THEN
            dest[off] = src[off]
        END

        off += 4
    END

    // At this point off contains a long-aligned index to wherever we need to
    // start filling with zeroes.

    bytes = EXU_INLINE_BUF_LENGTH - off
    off /= 4

    IF bytes >= 4 THEN
        destbuf[off] = 0

        IF bytes >= 8 THEN
            destbuf[off + 1] = 0

            IF bytes >= 12 THEN
                destbuf[off + 2] = 0
            END
        END
    END

    RETURN OS_STATUS_SUCCESS

@Error

    RETURN OS_STATUS_ILLEGAL_STRING
END

#SECTION "PAGEtext"
EXPORT FN ExCreateNameReference (
    IN reference : ^ExNameReference,
    IN str : ^RtlString,
) : OsStatus

    // Create a reference to an interned string.

    status : OsStatus

    len := str^.Length

    IF len != 0 AND
        len <= EXU_INLINE_BUF_LENGTH - 1 THEN

        // We can actually just inline the string in the reference.

        RETURN ExpCopyToInlinedBuffer (
            &reference^.U.Inlined.Buffer[0], // dest
            str^.Data, // src
            len, // size
        )
    END

    status = ExCreateName (
        str, // str
        OUT: name, // name
    )

    IF NOT OsError ( status ) THEN
        reference^.U.Inlined.Buffer[0] = 0
        reference^.U.Reference.Data = name^.String.Data
        reference^.U.Reference.Length = name^.String.Length
    END

    RETURN status
END

#SECTION "PAGEtext"
EXPORT FN ExCreateName (
    IN str : ^RtlString,
    OUT name : ^ExName,
) : OsStatus

    // Find a name in the string internment buckets.

    len := str^.Length

    IF len == 0 THEN
        // Refuse to intern a zero-length string.

        // Not only is it tricky with how we encode the references, but
        // it's usually a bad idea to permit zero-length strings, so system
        // services that forget to do special handling for them will tend to
        // find themselves in this codepath and short circuit out because of
        // this error status; it's good to help avoid bugs causing
        // vulnerabilities or corruption.

        RETURN OS_STATUS_ZERO_LENGTH_STRING
    END

    IF len > OS_SAFE_LENGTH THEN
        // Scary string length, larger than the signed max for 32 bit integer.
        // To try to minimize the odds of weird overflow bugs by consumers of
        // the interned string package, just reject this.

        RETURN OS_STATUS_STRING_TOO_LONG
    END

    // Hash the name.

    status := ExpHashAndValidateString (
        str, // str
        OUT: hash, // hash
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    kenode := KeCurrentAffinityNode ()
    expnode := kenode^.Exp

    node : ^ExpName

    // Get the hash bucket.

    bucket := &expnode^.NameBuckets[hash & (EXP_NAME_BUCKETS - 1)]

    reserved := FALSE

@Retry

    status = OS_STATUS_SUCCESS

    // Lock the bucket.

    KeAcquireLockExclusive ( &bucket^.Lock )

    // Look up the name in the bucket, which is an AVL tree keyed by string and
    // ordered lexicographically.

    avlnode := bucket^.TreeRoot.Right

    WHILE TRUE DO
        IF NOT avlnode THEN
            // Didn't find it, we'll need to create it.

            BREAK
        END

        node = CONTAINEROF avlnode TO ExpName.Entry

        res := CAST RtlCompareRtlString (
            str, // str1
            &node^.String, // str2
        ) TO WORD

        IF res == 0 THEN
            // Found it! Unlock the bucket and return the node.

            KeIncrementUlong (
                &node^.References, // ptr
                1, // inc
            )

            KeReleaseLock ( &bucket^.Lock )

            GOTO Exit
        END

        IF res < 0 THEN
            avlnode = avlnode^.Left
        ELSE
            avlnode = avlnode^.Right
        END
    END

    status = MmAllocatePoolEx (
        kenode, // kenode
        TRUE, // pageable
        SIZEOF ExpName + len + 1, // bytes
        'Name', // tag
        0, // flags
        OUT node, // ptr
    )

    IF OsError ( status ) THEN
        KeReleaseLock ( &bucket^.Lock )

        IF status != OS_STATUS_TRY_AGAIN THEN
            GOTO Exit
        END

        status = MmFulfillPageReservation ()

        IF OsError ( status ) THEN
            GOTO Exit
        END

        reserved = TRUE

        GOTO Retry
    END

    // Initialize the name.

    node^.References = 1

    newstr := &node^.String

    newstr^.Length = len
    newstr^.Data = CAST (node + SIZEOF ExpName) TO ^UBYTE

    RtlCopyBytes (
        newstr^.Data, // dest
        str^.Data, // src
        len, // sz
    )

    // Set null terminator here instead of copying it just for good measure
    // in case caller passed in a non null terminated RtlString (shouldn't be
    // possible but here we guard against it).

    newstr^.Data[len] = 0

    // Insert into the tree.

    RtlInsertAvl (
        &bucket^.TreeRoot, // root
        &node^.Entry, // node
        &ExpCompareNameNodes, // comparisonfunc
    )

    // Unlock bucket and return node.

    KeReleaseLock ( &bucket^.Lock )

@Exit

    IF reserved THEN
        MmReleasePageReserve ()
    END

    name = CAST node TO ^ExName

    RETURN status
END

#SECTION "PAGEtext"
EXPORT FN ExuDeleteNameReference (
    IN reference : ^ExNameReference,
)

    // We can get a pointer to the ExName structure by looking at the buffer
    // pointer and subtracting SIZEOF ExpName from it, since we put the string
    // bytes at the end of it.

    name := CAST (reference^.U.Reference.Data - SIZEOF ExpName) TO ^ExName

    ExUnreferenceName ( name )
END

#SECTION "PAGEtext"
EXPORT FN ExUnreferenceName (
    IN name : ^ExName,
)

    // Unreference the name node.

    expname := CAST name TO ^ExpName

    refcount := expname^.References

    KeAssert ( refcount != 0 )

    WHILE TRUE DO
        IF refcount == 1 THEN
            // If this is the last reference, then special handling is required.

            BREAK
        END

        new := KeCompareSwapUlong (
            &expname^.References, // ptr
            refcount - 1, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            LEAVE
        END

        refcount = new
    END

    expnode := KeNumaNodeFromSpacePointer ( expname )^.Exp

    hash := ExpHashString ( expname^.String.Data )

    bucket := &expnode^.NameBuckets[hash & (EXP_NAME_BUCKETS - 1)]

    // Lock the bucket.

    KeAcquireLockExclusive ( &bucket^.Lock )

    // Decrement the reference count.

    oldcount := KeIncrementUlong (
        &expname^.References, // ptr
        0xFFFFFFFF, // ulong
    )

    IF oldcount == 1 THEN
        // Remove from tree.

        RtlRemoveAvl (
            &bucket^.TreeRoot, // root
            &expname^.Entry, // node
        )

        KeReleaseLock ( &bucket^.Lock )

        // Free outside the bucket lock.

        MmFreePool (
            expname, // ptr
            'Name', // tag
        )

        LEAVE
    END

    // Unlock the bucket.

    KeReleaseLock ( &bucket^.Lock )
END

#SECTION "PAGEtext"
EXPORT FN ExReferenceName (
    IN name : ^ExName,
)

    // Reference the name node.

    expname := CAST name TO ^ExpName

    KeAssert ( expname^.References != 0 )

    KeIncrementUlong (
        &expname^.References, // ptr
        1, // inc
    )
END

#SECTION "PAGEtext"
EXPORT FN ExDuplicateString (
    IN outputstring : ^RtlString,
    IN inputstring : ^RtlString,
    IN pageable : UWORD,
    IN tag : UWORD,
) : OsStatus

    // Duplicate a string into an output string.

    // Copy the length.

    outputstring^.Length = inputstring^.Length

    // Create a new string buffer (this is the important work).

    status := MmAllocatePool (
        pageable, // pageable
        inputstring^.Length + 1, // bytes
        tag, // tag
        MM_ALLOCATE_WAIT, // flags
        OUT outputstring^.Data, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Copy the old string into the new one, including the null terminator.

    RtlCopyBytes (
        outputstring^.Data, // dest
        inputstring^.Data, // src
        inputstring^.Length + 1, // sz
    )

    RETURN status
END
