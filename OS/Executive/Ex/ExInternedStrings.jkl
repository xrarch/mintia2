//
// Management for string internment for the MINTIA Executive.
//

#INCLUDE "Exp.hjk"

STRUCT ExpName
    // The RtlString must be at the start to align with ExName.
    String : RtlString,

    Entry : RtlAvlNode,

    References : ULONG,
END

#SECTION "INITtext"
FN ExpInitializeNamesForNode (
    IN expnode : ^ExpNode,
)

    // Initialize the interned name buckets.

    i := 0

    WHILE i < EXP_NAME_BUCKETS DO
        RtlInitializeAvl ( &expnode^.NameBuckets[i].TreeRoot )
        KeInitializeLock ( &expnode^.NameBuckets[i].Lock, "NameBucket" )

        i += 1
    END
END

#SECTION "INITtext"
FN ExpInitializeNames ()

    // Initialize the interned name buckets.

    i := 0
    nodes := KeQueryNodeCount ()

    WHILE i < nodes DO
        expnode := KeNumaNodeById ( i )^.Exp

        IF expnode THEN
            ExpInitializeNamesForNode ( expnode )
        END

        i += 1
    END
END

#SECTION "PAGEtext"
FN (RtlAvlLessThanF) ExpCompareNameNodes (
    IN a : ^RtlAvlNode,
    IN b : ^RtlAvlNode,
) : UWORD

    // Return whether A < B, lexicographically.

    RETURN CAST RtlCompareRtlString (
        &(CONTAINEROF a TO ExpName.Entry)^.String, // str1
        &(CONTAINEROF b TO ExpName.Entry)^.String, // str2
    ) TO WORD < 0
END

#SECTION "PAGEtext"
FN ExpHash (
    IN str : ^UBYTE,
) : UWORD

    // Simple hash for a string.

    hash := 0

    WHILE str^ DO
        hash += str^
        hash += hash << 10
        hash $= hash >> 6

        str += 1
    END

    hash += hash << 3
    hash $= hash >> 11
    hash += hash << 15

    RETURN hash
END

#SECTION "PAGEtext"
EXPORT FN ExFindName (
    IN str : ^RtlString,
) : ^ExName

    // Find a name in the string internment buckets.

    // Hash the name.

    len := str^.Length

    hash := ExpHash ( str^.Data )

    kenode := KeCurrentAffinityNode ()
    expnode := kenode^.Exp

    // Get the hash bucket.

    bucket := &expnode^.NameBuckets[hash & (EXP_NAME_BUCKETS - 1)]

@Retry

    // Lock the bucket.

    KeAcquireLockExclusive ( &bucket^.Lock )

    // Look up the name in the bucket, which is an AVL tree keyed by string and
    // ordered lexicographically.

    avlnode := bucket^.TreeRoot.Right

    WHILE TRUE DO
        IF NOT avlnode THEN
            // Didn't find it, we'll need to create it.

            BREAK
        END

        checknode := CONTAINEROF avlnode TO ExpName.Entry

        res := CAST RtlCompareRtlString (
            str, // str1
            &checknode^.String, // str2
        ) TO WORD

        IF res == 0 THEN
            // Found it! Unlock the bucket and return the node.

            KeIncrementUlong (
                &checknode^.References, // ptr
                1, // inc
            )

            KeReleaseLock ( &bucket^.Lock )

            RETURN CAST checknode TO ^ExName
        END

        IF res < 0 THEN
            avlnode = avlnode^.Left
        ELSE
            avlnode = avlnode^.Right
        END
    END

    status := MmAllocatePoolEx (
        kenode, // kenode
        TRUE, // pageable
        SIZEOF ExpName + len + 1, // bytes
        'Name', // tag
        0, // flags
        OUT node : ^ExpName, // ptr
    )

    IF OsError ( status ) THEN
        KeReleaseLock ( &bucket^.Lock )

        IF status != OS_STATUS_NO_MEMORY THEN
            RETURN NULLPTR
        END

        MmWaitForPoolMemory ()

        GOTO Retry
    END

    // Initialize the name.

    node^.References = 1

    newstr := &node^.String

    newstr^.Length = len
    newstr^.Data = CAST (node + SIZEOF ExpName) TO ^UBYTE

    RtlCopyBytes (
        newstr^.Data, // dest
        str^.Data, // src
        len + 1, // sz
    )

    // Insert into the tree.

    RtlInsertAvl (
        &bucket^.TreeRoot, // root
        &node^.Entry, // node
        &ExpCompareNameNodes, // comparisonfunc
    )

    // Unlock bucket and return node.

    KeReleaseLock ( &bucket^.Lock )

    RETURN CAST node TO ^ExName
END

#SECTION "PAGEtext"
EXPORT FN ExUnreferenceName (
    IN name : ^ExName,
)

    // Unreference the name node.

    expname := CAST name TO ^ExpName

    refcount := expname^.References

    KeAssert ( refcount != 0 )

    WHILE TRUE DO
        IF refcount == 1 THEN
            // If this is the last reference, then special handling is required.

            BREAK
        END

        new := KeCompareSwapUlong (
            &expname^.References, // ptr
            refcount - 1, // newvalue
            refcount, // expectedvalue
        )

        IF new == refcount THEN
            LEAVE
        END

        refcount = new
    END

    expnode := KeNumaNodeFromSpacePointer ( expname )^.Exp

    hash := ExpHash ( expname^.String.Data )

    bucket := &expnode^.NameBuckets[hash & (EXP_NAME_BUCKETS - 1)]

    // Lock the bucket.

    KeAcquireLockExclusive ( &bucket^.Lock )

    // Decrement the reference count.

    oldcount := KeIncrementUlong (
        &expname^.References, // ptr
        0xFFFFFFFF, // ulong
    )

    IF oldcount == 1 THEN
        // Remove from tree.

        RtlRemoveAvl (
            &bucket^.TreeRoot, // root
            &expname^.Entry, // node
        )

        KeReleaseLock ( &bucket^.Lock )

        // Free outside the bucket lock.

        MmFreePool (
            expname, // ptr
            'Name', // tag
        )

        LEAVE
    END

    // Unlock the bucket.

    KeReleaseLock ( &bucket^.Lock )
END

#SECTION "PAGEtext"
EXPORT FN ExReferenceName (
    IN name : ^ExName,
)

    // Reference the name node.

    expname := CAST name TO ^ExpName

    KeAssert ( expname^.References != 0 )

    KeIncrementUlong (
        &expname^.References, // ptr
        1, // inc
    )
END

#SECTION "PAGEtext"
EXPORT FN ExDuplicateString (
    IN outputstring : ^RtlString,
    IN inputstring : ^RtlString,
    IN pageable : UWORD,
    IN tag : UWORD,
) : OsStatus

    // Duplicate a string into an output string.

    // Copy the length.

    outputstring^.Length = inputstring^.Length

    // Create a new string buffer (this is the important work).

    status := MmAllocatePool (
        pageable, // pageable
        inputstring^.Length + 1, // bytes
        tag, // tag
        MM_ALLOCATE_WAIT, // flags
        OUT outputstring^.Data, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Copy the old string into the new one, including the null terminator.

    RtlCopyBytes (
        outputstring^.Data, // dest
        inputstring^.Data, // src
        inputstring^.Length + 1, // sz
    )

    RETURN status
END
