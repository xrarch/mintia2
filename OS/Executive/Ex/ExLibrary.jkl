//
// Implements support for dynamically (un)loadable kernel mode libraries.
//

#INCLUDE "Exp.hjk"
#INCLUDE "../../Loader/Headers/Loader.hjk"

ExpLibraryCacheLock : KeLock

ExpLibraryDictionary : ExuDictionary

ExpLibraryReapListHeads : RtlListEntry[2]
ExpLibraryReapLists : ^RtlListEntry[2]

#DEFINE EXP_LIBRARY_REAP_NOW 0
#DEFINE EXP_LIBRARY_REAP_LATER 1

#SECTION "PAGEtext"
EXPORT FN ExLookupSymbolLibrary (
    IN library : ^ExuLibrary,
    IN symbol : ^UBYTE,
) : ^VOID

    // Look up the exported symbol or return NULLPTR if not found.
    // Caller should have exclusive custody of the library.

    IF library^.Flags & EX_LOAD_LIBRARY_KEEP_HEADERS == 0 THEN
        // The headers aren't present so return.

        RETURN NULLPTR
    END

    KeCrash ( "TODO ExLookupSymbolLibrary" )
END

#SECTION "PAGEtext"
EXPORT FN ExJettisonHeadersLibrary (
    IN library : ^ExuLibrary,
)

    // Jettison library headers to save space.
    // Caller should have exclusive custody of the library.

    IF library^.Flags & EX_LOAD_LIBRARY_KEEP_HEADERS == 0 THEN
        // The headers aren't present so return.

        LEAVE
    END

    library^.Flags &= ~EX_LOAD_LIBRARY_KEEP_HEADERS

    KeCrash ( "TODO ExJettisonHeadersLibrary" )
END

#SECTION "PAGEtext"
EXPORT FN ExUnloadLibrary (
    IN library : ^ExuLibrary,
)

    // Unload a library.

    // Does not instantly unload the library but instead places it on a queue
    // to be unloaded later if it is not ExLoadLibrary'd off that queue in the
    // meanwhile. This forms a "library cache" mechanism.

    KeAcquireLockExclusive ( &ExpLibraryCacheLock )

    library^.References -= 1

    IF library^.References == 0 THEN
        // Place on the reap-later list.

        RtlInsertAtTailList (
            ExpLibraryReapLists[EXP_LIBRARY_REAP_LATER], // listhead
            &library^.ReapListEntry, // entry
        )
    END

    KeReleaseLock ( &ExpLibraryCacheLock )
END

#SECTION "PAGEtext"
EXPORT FN ExLoadLibrary (
    IN path : ^RtlString,
    IN name : ^RtlString,
    IN loadflags : UWORD,
    OUT library : ^ExuLibrary,
    OUT cached : UWORD,
) : OsStatus

    // Load a library at the given path, with the given symbolic name.
    // If a symbolic name is provided then an existing library with the same
    // name is searched for and returned if found.

    // If no name is provided then a new instance of the library is loaded
    // unconditionally. Such a library will not be cached and will therefore
    // not participate in deferred deletion, so this can be a performance
    // concern for consumers to keep in mind.

    // The path is relative to the system directory.

    cached = FALSE

@Retry

    status := OS_STATUS_SUCCESS

    IF name THEN
        // There was a symbolic name so look up the dictionary to see if we
        // already have a library going by that name.

        KeAcquireLockExclusive ( &ExpLibraryCacheLock )

        library = ExLookupDictionary (
            &ExpLibraryDictionary, // dict
            name, // key
        )

        IF library THEN
            // We do have a library, which might either be in a fully loaded
            // state or is in the process of being loaded by another thread.

            IF NOT ExIsActionInProgress ( &library^.Action ) THEN
                // The library is fully loaded so just increment the reference
                // count and return it.

                IF library^.References == 0 THEN
                    // Was on a reap list so take it off.

                    RtlRemoveEntryList ( &library^.ReapListEntry )
                END

                library^.References += 1

                KeReleaseLock ( &ExpLibraryCacheLock )

                cached = TRUE

                RETURN OS_STATUS_SUCCESS
            END

            // Someone else is in the process of loading the library.
            // We need to wait for them to complete that.

            status = ExPrepareWaitForAction (
                &library^.Action, // action
                MM_ALLOCATE_WAIT, // flags
                OUT: waitable, // waitable
            )

            // Wait for the other thread to complete the load outside of the
            // library cache lock.

            KeReleaseLock ( &ExpLibraryCacheLock )

            IF OsError ( status ) THEN
                RETURN status
            END

            ExWaitForActionCompletion ( waitable )

            GOTO Retry
        END
    END

    // There is no library going by that symbolic name (or the caller did not
    // pass in a name), so we have to load it. Note that if a symbolic name was
    // provided, we are currently still holding the library cache lock,
    // otherwise we never took it.

    // Create a new library structure.

    status = MmAllocatePool (
        FALSE, // pageable
        SIZEOF ExuLibrary, // bytes
        'ExLb', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT library, // ptr
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    library^.Name = NULLPTR
    library^.References = 1
    library^.Flags = loadflags

    IF name THEN
        // Intern the symbolic name string.

        library^.Name = ExFindName ( name )

        IF NOT library^.Name THEN
            status = OS_STATUS_NO_MEMORY

            GOTO Exit1
        END

        // Insert the library in the lookup dictionary, keyed by its symbolic
        // name.

        status = ExInsertInDictionary (
            &ExpLibraryDictionary, // dict
            name, // key
            library, // value
            FALSE, // canupdate
            OUT: oldvalue, // oldvalue
        )

        IF OsError ( status ) THEN
            GOTO Exit2
        END

        // Now set the library's action started, so that other threads that
        // look up the library can wait for us to finish loading it. Then
        // release the lock and perform the loading work outside of it so that
        // we don't block other library lookups or loads from happening in
        // parallel.

        ExStartAction ( &library^.Action )

        KeReleaseLock ( &ExpLibraryCacheLock )
    END

    // If path is NULLPTR, then we do nothing and leave it up to the caller to
    // initialize this library. This is meant for setting up special boot-time
    // libraries.

    IF path THEN
        // There is a path, so perform the actual loading.

        // Make sure to retain headers for ExLookupSymbolLibrary if
        // EX_LOAD_LIBRARY_KEEP_HEADERS is specified.

        KeCrash ( "TODO\n" )
    END

    // We finished loading the library, so if there is a symbolic name (which
    // means the library can be looked up by others), set the action completed
    // under the library cache lock and wake up anyone waiting for us. 

    IF name THEN
        KeAcquireLockExclusive ( &ExpLibraryCacheLock )

        ExCompleteAction ( &library^.Action )

        KeReleaseLock ( &ExpLibraryCacheLock )
    END

    RETURN OS_STATUS_SUCCESS

@Exit3

    KeAcquireLockExclusive ( &ExpLibraryCacheLock )

    IF name THEN
        ExCompleteAction ( &library^.Action )
    END

    ExRemoveFromDictionary (
        &ExpLibraryDictionary, // dict
        name, // key
    )

@Exit2

    IF name THEN
        ExUnreferenceName ( library^.Name )
    END

@Exit1

    MmFreePool (
        library, // ptr
        'ExLb', // tag
    )

@Exit

    IF name THEN
        KeReleaseLock ( &ExpLibraryCacheLock )
    END

    RETURN status
END

#SECTION "PAGEtext"
FN ExpDeleteLibrary (
    IN library : ^ExuLibrary,
)

    // Delete a library.

    KeAssert ( library^.References == 0 )

    // Unreference all of the libraries depended upon by this one.

    KeCrash ( "TODO\n" )

    // Release memory used for sections and headers of the library.

    KeCrash ( "TODO\n" )

    // Free the library structure.

    ExUnreferenceName ( library^.Name )

    MmFreePool (
        library, // ptr
        'ExLb', // tag
    )
END

FN ExuReapLibraries (
    IN all : UWORD,
)

    // Called periodically on the boot node to reap libraries with a reference
    // count of zero.

    toreap : RtlListEntry

    RtlInitializeList ( &toreap )

    library : ^ExuLibrary

@Again

    // Take library lock.

    KeAcquireLockExclusive ( &ExpLibraryCacheLock )

    // Swap reap list pointers. This makes it so that a library whose reference
    // count drops to zero will not be reaped until at least one full reaping
    // period in the future.

    reapnow := ExpLibraryReapLists[EXP_LIBRARY_REAP_NOW]
    reaplater := ExpLibraryReapLists[EXP_LIBRARY_REAP_LATER]

    ExpLibraryReapLists[EXP_LIBRARY_REAP_LATER] = reapnow
    ExpLibraryReapLists[EXP_LIBRARY_REAP_NOW] = reaplater

    // Now capture the entire list of libraries to reap now into our local
    // list head and make the old reap now list empty.

    IF NOT RtlEmptyList ( reapnow ) THEN
        headentry := reapnow^.Next
        tailentry := reapnow^.Prev

        toreap.Prev = tailentry
        tailentry^.Next = &toreap

        toreap.Next = headentry
        headentry^.Prev = &toreap

        RtlInitializeList ( reapnow )
    END

    // Unpublish all of these libraries.

    listentry := toreap.Next

    WHILE listentry != &toreap DO
        library = CONTAINEROF listentry TO ExuLibrary.ReapListEntry

        KeAssert ( library^.References == 0 )

        ExRemoveFromDictionary (
            &ExpLibraryDictionary, // dict
            &library^.Name^.String, // key
        )

        listentry = listentry^.Next
    END

    KeReleaseLock ( &ExpLibraryCacheLock )

    // The libraries can no longer be looked up in the dictionary, so they are
    // now just inert hunks of bytes in our custody. We can do the rest of the
    // deletion work outside the library cache lock.

    listentry = toreap.Next

    WHILE listentry != &toreap DO
        library = CONTAINEROF listentry TO ExuLibrary.ReapListEntry
        listentry = listentry^.Next

        ExpDeleteLibrary ( library )
    END

    IF all THEN
        // If the caller said to reap all libraries aggressively, then go again
        // to reap the ones on the other list too. Happens when the system is
        // in need of memory.

        all = FALSE

        GOTO Again
    END
END

#SECTION "PAGEtext"
EXPORT FN ExForgetLibrary (
    IN name : ^RtlString,
)

    // If a library is in the cache and has a reference count of 0 then
    // forcibly free it fully.

    KeAcquireLockExclusive ( &ExpLibraryCacheLock )

    library := CAST ExLookupDictionary (
        &ExpLibraryDictionary, // dict
        name, // key
    ) TO ^ExuLibrary

    IF NOT library OR
        library^.References != 0 THEN

        // Not in the cache or not a zero reference count.

        KeReleaseLock ( &ExpLibraryCacheLock )

        LEAVE
    END

    // The reference count was zero which means it must be on a reap list, so
    // remove it.

    RtlRemoveEntryList ( &library^.ReapListEntry )

    // Now unpublish it.

    ExRemoveFromDictionary (
        &ExpLibraryDictionary, // dict
        &library^.Name^.String, // key
    )

    // It's fully in our custody now so we can do the rest of the deletion work
    // outside of the library cache lock.

    KeReleaseLock ( &ExpLibraryCacheLock )

    // Delete it the rest of the way.

    ExpDeleteLibrary ( library )
END

#ENTERSECTION "INITtext"

FN ExpInitializeLibraries ()

    // Initialize the loadable libraries package.

    // Initialize the reap list for libraries with zero references.

    RtlInitializeList ( &ExpLibraryReapListHeads[0] )
    RtlInitializeList ( &ExpLibraryReapListHeads[1] )

    ExpLibraryReapLists[EXP_LIBRARY_REAP_NOW] = &ExpLibraryReapListHeads[0]
    ExpLibraryReapLists[EXP_LIBRARY_REAP_LATER] = &ExpLibraryReapListHeads[1]

    // Initialize the lock.

#LEAVESECTION
    KeInitializeLock ( &ExpLibraryCacheLock, "LibraryCache" )
#ENTERSECTION "INITtext"

    // Initialize the dictionary.

    ExuInitializeDictionary ( &ExpLibraryDictionary )

    // Set up special library structures for all of the modules loaded by the
    // bootloader.

    listhead := &KeuLoaderBlock.DllListHead
    listentry := listhead^.Next

    WHILE listhead != listentry DO
        bldll := CONTAINEROF listentry TO BlDll.Entry
        listentry = listentry^.Next

        name : RtlString

        RtlInitializeString ( &name, &bldll^.Name[0] )

        status := ExLoadLibrary (
            NULLPTR, // path
            &name, // name
            0, // loadflags
            OUT: library, // library
            OUT: cached, // cached
        )

        IF OsError ( status ) THEN
            KeCrash ( "Failed to set up initial library structures\n" )
        END

        bldll^.FreeSpace = library
    END
END

#LEAVESECTION
