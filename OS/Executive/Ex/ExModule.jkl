//
// Implements support for dynamic modules.
//

#INCLUDE "Exp.hjk"

PUBLIC ExuExecutiveModule : ^ExuLoadedModule

ExpModuleLoadingLock : KeLock = KE_INITIAL_LOCK

ExpKnownModuleDictionary : ExuDictionary

#SECTION "PAGEtext"
FN ExuLookupKnownModule (
    IN name : ^RtlString,
    IN create : UWORD,
) : ^ExuKnownModule

    // Look up a known module, or register it.
    //
    // If create is FALSE, a return value of NULLPTR means it wasn't found.
    // If create is TRUE, a return value of NULLPTR means insufficient memory.

    KeAcquireLockExclusive ( &ExpModuleLoadingLock )

    knownmodule := CAST ExLookupDictionary (
        &ExpKnownModuleDictionary, // dict
        name, // key
    ) TO ^ExuKnownModule

    IF knownmodule OR NOT create THEN
        // Found it, or we didn't find it and don't wanna create it.
        // In either case just return what we have.

        GOTO Exit
    END

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF ExuKnownModule, // bytes
        'KnMo', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT knownmodule, // ptr
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // Insert it into the dictionary.

    oldvalue : ^VOID

    status = ExInsertInDictionary (
        &ExpKnownModuleDictionary, // dict
        name, // key
        knownmodule, // value
        FALSE, // canupdate
        OUT oldvalue, // oldvalue
    )

    IF OsError ( status ) THEN
        MmFreePool (
            knownmodule, // knownmodule
            'KnMo', // tag
        )

        GOTO Exit
    END

    // Initialize as not having an associated loaded module.

    knownmodule^.LoadedModule = NULLPTR

@Exit

    KeReleaseLock ( &ExpModuleLoadingLock )

    RETURN knownmodule
END

#SECTION "PAGEtext"
FN (ObuTypeDeleteF) ExpDeleteModuleObject (
    IN object : ^VOID,
) : UWORD

    // The module's refcount hit zero, which means none of its classes are in
    // use. We should unload it now.

    // ...

    RETURN TRUE
END

STRUCT ExpModuleContext
    KnownModule : ^ExuKnownModule,
END

#SECTION "PAGEtext"
FN (ObuTypeInitializeF) ExpInitializeModuleObject (
    IN object : ^VOID,
    IN context : ^VOID,
) : OsStatus

    // Initialize an ExuLoadedModule object.

    module := CAST object TO ^ExuLoadedModule
    ctx := CAST context TO ^ExpModuleContext

    // Set the known module that this loaded module will be associated with.

    module^.KnownModule = ctx^.KnownModule

    module^.Flags = 0

    RETURN OS_STATUS_SUCCESS
END

#SECTION "INITtext"
ExpModuleType : ObuType = {
    [Name] = "Module",

    [Delete] = &ExpDeleteModuleObject,

    [Initialize] = &ExpInitializeModuleObject,

    [TypeIdentifier] = OS_MODULE_TYPE,
    [Tag] = 'Modu',

    [TypicalBodySize] = SIZEOF ExuLoadedModule,

    [Align] = ALIGNOF ExuLoadedModule,

    [IsPaged] = FALSE,
}

#SECTION "PAGEtext"
FN ExpCreateModule (
    IN knownmodule : ^ExuKnownModule,
    OUT module : ^ExuLoadedModule,
) : OsStatus

    // Create an ExuLoadedModule object.

    ctx : ExpModuleContext

    ctx.KnownModule = knownmodule

    obparams : ObParameters

    ObInitializeParameters (
        &obparams, // obparams
        OS_MODULE_TYPE, // typeid
        &ctx, // context
        PsuSystemCredentials (), // cred
        OS_ACCESS_OWNER_ALL, // access
        0, // flags
        SIZEOF ExuLoadedModule, // bodysize
        0, // pagedbodysize
        0, // npquotabias
        0, // pgquotabias
    )

    RETURN ObuAllocateObject (
        &obparams, // obparams
        OUT module, // object
    )
END

#ENTERSECTION "INITtext"

FN ExpInitializeModules ()

    // Initialize the loadable modules package.

    // Initialize the module type.

    ObuInitializeType ( &ExpModuleType )

    // Initialize the known modules dictionary.

    ExuInitializeDictionary ( &ExpKnownModuleDictionary )

    // Create a "known module" for the kernel itself.

    kernelname : RtlString

    RtlInitializeString ( &kernelname, "mintia.sys" )

    knownmodule := ExuLookupKnownModule (
        &kernelname, // name
        TRUE, // create
    )

    IF NOT knownmodule THEN
        KeCrash (
            "%s: failed to create known module\n", // fmt
            "ExpInitializeModules",
        )
    END

    // Now create a special ExuLoadedModule to represent the executive binary
    // and IO classes implemented therein.

    module : ^ExuLoadedModule

    status := ExpCreateModule (
        knownmodule, // knownmodule
        OUT module, // module
    )

    IF OsError ( status ) THEN
        KeCrash (
            "%s: failed to create module\n", // fmt
            "ExpInitializeModules",
        )
    END

    // Set the known module to point here.

    knownmodule^.LoadedModule = module

    // Set the special executive module pointer.

    ExuExecutiveModule = module
END

#LEAVESECTION