//
// Implements event counters, which are little refcounted memory blocks
// containing event objects.
//

#INCLUDE "Exp.hjk"

#SECTION "INITtext"
FN ExpInitializeEventCountersForNode (
    IN kenode : ^KeuNode,
)

    // Initialize the event counter list.

    IF NOT kenode^.Exp THEN
        LEAVE
    END

    status := MmCreateObjectCache (
        kenode, // kenode
        "Event Counters", // name
        0, // flags
        SIZEOF ExuEventCounter, // objectsize
        TRUE, // magazinecached
        FALSE, // pageable
        RTL_ALIGN_BYTES, // align
        OUT kenode^.Exp^.EventCounterCache, // ptr
    )

#ENTERSECTION "INITtext"
    IF OsError ( status ) THEN
        KeCrash ( "ExpInitializeEventCounters: failed to create cache\n" )
    END
#LEAVESECTION

END

#SECTION "INITtext"
FN ExpInitializeEventCounters ()

    // Initialize the event counter list.

    i := 0
    nodes := KeQueryNodeCount ()

    WHILE i < nodes DO
        kenode := KeNumaNodeById ( i )

        ExpInitializeEventCountersForNode ( kenode )

        i += 1
    END
END

EXPORT FN ExAllocateEventCounter (
    IN flags : UWORD,
    OUT counter : ^ExuEventCounter,
) : OsStatus

    // Allocate an event counter.

    expnode := KeCurrentVolatileNode ()^.Exp

    status := MmAllocateFromObjectCache (
        expnode^.EventCounterCache, // cache
        flags, // flags
        'EvCn', // tag
        OUT counter, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    KeInitializeEvent (
        &counter^.Event, // event
        "Collision Counter", // name
        TRUE, // notification
        FALSE, // signalstate
    )

    counter^.References = 1

    RETURN status
END

EXPORT FN ExReferenceEventCounter (
    IN counter : ^ExuEventCounter,
)

    // Increment the refcount of the counter.

    oldcount := KeIncrementUlong (
        &counter^.References, // ptr
        1, // inc
    )

    KeAssert ( oldcount != 0 )
END

EXPORT FN ExUnreferenceEventCounter (
    IN counter : ^ExuEventCounter,
)

    // Decrement the refcount of the counter.

    oldcount := KeIncrementUlong (
        &counter^.References, // ptr
        0xFFFFFFFF, // inc
    )

    KeAssert ( oldcount != 0 )

    IF oldcount == 1 THEN
        // This was the last user of this event counter. Put it on the list.

        expnode := KeNumaNodeFromSpacePointer ( counter )^.Exp

        MmFreeToObjectCache (
            expnode^.EventCounterCache, // cache
            counter, // ptr
            'EvCn', // tag
        )
    END
END