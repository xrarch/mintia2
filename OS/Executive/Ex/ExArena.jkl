//
// Generic resource allocator for the MINTIA Executive.
// Inspired by the Vmem resource allocator from Solaris (Bonwick).
//

#INCLUDE "Exp.hjk"

#DEFINE EXP_MAX_QUANTUM_CACHES 16

#DEFINE EXP_PREALLOCATED_ARENAS 4

#DEFINE EXP_TAG_FREE 1
#DEFINE EXP_TAG_ALLOCATED 2
#DEFINE EXP_TAG_SPAN 3

STRUCT ExpArenaTag
    Address : ^VOID,
    Size : UWORD,
    TreeEntry : RtlAvlNode,
    ListEntry : RtlListEntry,
    Type : ULONG,
END

STRUCT ExpQuantumCache
    Cache : ^MmpPoolCache,
    Arena : ^ExpArena,
    Size : UWORD,
END

STRUCT ExpArena
    Lock : KeLock,

KE_CACHE_LINE_END

    Entry : RtlListEntry,
    Name : ^UBYTE,
    Node : ^KeuNode,
    TagCallbacks : ExArenaTagCallbacks,
    ImportCallbacks : ExArenaImportCallbacks,
    QuantumCaches : ExpQuantumCache[EXP_MAX_QUANTUM_CACHES + 1],
    QuantumCacheMaximum : ULONG,
    QuantumShift : ULONG,
    ImportArena : ^ExpArena,

KE_CACHE_LINE_END

    // Keyed by size.
    FreeTree : RtlAvlNode,

    // Keyed by address.
    UsedTree : RtlAvlNode,

    // Ordered by address.
    SegmentListHead : RtlListEntry,

    TagReserveListHead : RtlListEntry,
    TagReserveCount : UWORD,
    TagReserveMinimum : UWORD,
END

FN (ExArenaLookupTagF) ExpArenaLookupTag (
    IN context : ^VOID,
    IN address : ^VOID,
) : ^ExpArenaTag

    // Lookup a tag by address.
    // Arena lock is held.

    arena := CAST context TO ^ExpArena

    avlnode := arena^.UsedTree.Right

    WHILE TRUE DO
        IF NOT avlnode THEN
            // Didn't find it.

            RETURN NULLPTR
        END

        tag := CONTAINEROF avlnode TO ExpArenaTag.TreeEntry

        IF tag^.Address == address THEN
            // Found it!

            RETURN tag
        END

        IF address < tag^.Address THEN
            avlnode = avlnode^.Left
        ELSE
            avlnode = avlnode^.Right
        END
    END
END

FN (RtlAvlLessThanF) ExpArenaCompareTagsByAddress (
    IN a : ^RtlAvlNode,
    IN b : ^RtlAvlNode,
) : UWORD

    // Return whether a < b by address.

    tag1 := CONTAINEROF a TO ExpArenaTag.TreeEntry
    tag2 := CONTAINEROF b TO ExpArenaTag.TreeEntry

    RETURN tag1^.Address < tag2^.Address
END

FN (RtlAvlLessThanF) ExpArenaCompareTagsBySize (
    IN a : ^RtlAvlNode,
    IN b : ^RtlAvlNode,
) : UWORD

    // Return whether a < b by size.

    tag1 := CONTAINEROF a TO ExpArenaTag.TreeEntry
    tag2 := CONTAINEROF b TO ExpArenaTag.TreeEntry

    RETURN tag1^.Size < tag2^.Size
END

FN (ExArenaInsertTagF) ExpArenaInsertTag (
    IN context : ^VOID,
    IN address : ^VOID,
    IN tag : ^ExpArenaTag,
)

    // Insert a tag into the lookup tree by address.
    // Arena lock is held.

    arena := CAST context TO ^ExpArena

    RtlInsertAvl (
        &arena^.UsedTree, // root
        &tag^.TreeEntry, // node
        &ExpArenaCompareTagsByAddress, // comparisonfunc
    )
END

FN (ExArenaRemoveTagF) ExpArenaRemoveTag (
    IN context : ^VOID,
    IN address : ^VOID,
    IN tag : ^ExpArenaTag,
)

    // Remove a tag from the lookup tree.
    // Arena lock is held.

    arena := CAST context TO ^ExpArena

    RtlRemoveAvl (
        &arena^.UsedTree, // root
        &tag^.TreeEntry, // node
    )
END

#SECTION "INITtext"
FN ExpInitializeArenas ()

    // Initialize the arena package for all nodes.

    i := 0
    nodes := KeQueryNodeCount ()

    WHILE i < nodes DO
        kenode := KeNumaNodeById ( i )

        expnode := kenode^.Exp

        KeInitializeLock ( &expnode^.ArenaListLock )

        RtlInitializeList ( &expnode^.ArenaListHead )

        expnode^.PreallocatedArenas = KeuAllocateNodeSpace (
            kenode, // kenode
            SIZEOF ExpArena * EXP_PREALLOCATED_ARENAS, // bytes
        )

        KeAssert ( expnode^.PreallocatedArenas != NULLPTR )

        expnode^.PreallocatedArenaIndex = 0

        KeInitializeLock ( &expnode^.ArenaTagListLock )

        RtlInitializeList ( &expnode^.ArenaTagListHead )

        KeInitializeLock ( &expnode^.ArenaPopulateLowLock )

        KeInitializeLock ( &expnode^.ArenaPopulateWaitLock )

        KeInitializeLock ( &expnode^.ArenaPopulateNoWaitLock )

        i += 1
    END
END

#SECTION "PAGEtext"
FN ExpFreeArena (
    IN arena : ^ExpArena,
)

    // Free an arena.

    expnode := arena^.Node^.Exp

    IF arena >= &expnode^.PreallocatedArenas[0] AND
        arena < &expnode^.PreallocatedArenas[EXP_PREALLOCATED_ARENAS] THEN

        // The arena is preallocated so don't free it.

        LEAVE
    END

    MmFreeToPoolCache (
        expnode^.ArenaCache, // cache
        arena, // ptr
    )
END

#SECTION "PAGEtext"
FN ExDeleteArena (
    IN arena : ^ExpArena,
)

    // Delete the arena. It should no longer be in use and all contained
    // blocks should have been freed by now, if needed; they are not freed
    // automatically by this function.

    expnode := arena^.Node^.Exp

    KeAcquireLockExclusive ( &expnode^.ArenaListLock )

    RtlRemoveEntryList ( &arena^.Entry )

    KeReleaseLock ( &expnode^.ArenaListLock )

    // Delete all of the quantum caches.

    i := 1

    WHILE i <= arena^.QuantumCacheMaximum DO
        MmDeletePoolCache ( arena^.QuantumCaches[i].Cache )

        i += 1
    END

    IF arena^.TagReserveCount THEN
        // Move the arena's reserved tags to the per-node list.

        KeAssert ( NOT RtlEmptyList ( &arena^.TagReserveListHead ) )

        headentry := arena^.TagReserveListHead.Next
        tailentry := arena^.TagReserveListHead.Prev

        // Splice the list in at the tail, all at once.

        ipl := KeAcquireLockExclusiveRaise ( &expnode^.ArenaTagListLock )

        headentry^.Prev = expnode^.ArenaTagListHead.Prev
        expnode^.ArenaTagListHead.Prev^.Next = headentry

        tailentry^.Next = &expnode^.ArenaTagListHead
        expnode^.ArenaTagListHead.Prev = tailentry

        KeReleaseLockLower ( &expnode^.ArenaTagListLock, ipl )
    END

    ExpFreeArena ( arena )
END

FN ExpAdjustQuantumCaches (
    IN arena : ^ExpArena,
    IN purge : UWORD,
)

    // Adjust the arena's quantum caches.

    i := 1

    WHILE i <= arena^.QuantumCacheMaximum DO
        IF purge THEN
            MmuPurgePoolCache ( arena^.QuantumCaches[i].Cache )
        ELSE
            MmuAdjustPoolCache ( arena^.QuantumCaches[i].Cache )
        END

        i += 1
    END
END

FN ExpPopulateTagReserve (
    IN arena : ^ExpArena,
    IN flags : UWORD,
) : OsStatus

    // Populate the tag reserve of the arena so that it has TagReserveMinimum
    // of them. Arena lock is held.

    expnode := arena^.Node^.Exp
    tag : ^ExpArenaTag

    // Take boundary tags off the global per-node free list first.

    KeAcquireLockExclusive ( &expnode^.ArenaTagListLock )

    WHILE arena^.TagReserveCount < arena^.TagReserveMinimum AND
        NOT RtlEmptyList ( &expnode^.ArenaTagListHead ) DO

        tag =
            CONTAINEROF expnode^.ArenaTagListHead.Next TO ExpArenaTag.ListEntry

        RtlRemoveEntryList ( &tag^.ListEntry )

        RtlInsertAtHeadList (
            &arena^.TagReserveListHead, // listhead
            &tag^.ListEntry, // listentry
        )

        arena^.TagReserveCount += 1
    END

    KeReleaseLock ( &expnode^.ArenaTagListLock )

    IF arena^.TagReserveCount >= arena^.TagReserveMinimum THEN
        RETURN OS_STATUS_SUCCESS
    END

    // We still need more boundary tags.

    current := KeCurrentThread ()

    IF KeLockOwner ( &expnode^.ArenaPopulateLowLock ) == current OR
        KeLockOwner ( &expnode^.ArenaPopulateWaitLock ) == current OR
        KeLockOwner ( &expnode^.ArenaPopulateNoWaitLock ) == current THEN

        // This thread is already doing a boundary tag population so just
        // return. There are enough in the reserve to satisfy this.

        RETURN OS_STATUS_SUCCESS
    END

    // Release arena lock but do not lower IPL.

    KeReleaseLock ( &arena^.Lock )

    // Prevent more than 3 concurrent repopulations.

    lock : ^KeLock

    IF flags & MM_ALLOCATE_LOW THEN
        lock = &expnode^.ArenaPopulateLowLock
    ELSEIF flags & MM_ALLOCATE_WAIT THEN
        lock = &expnode^.ArenaPopulateWaitLock
    ELSE
        lock = &expnode^.ArenaPopulateNoWaitLock
    END

    KeAcquireLockExclusive ( lock )

    // Allocate a page of boundary tags.
    // This ends up allocating from another ExArena so we're at risk of
    // recursion here which we deal with using the reserved tags.

    status := MmAllocatePoolPages (
        arena^.Node^.Mmp, // mmnode
        flags, // flags
        1, // pages
        MM_NONPAGED_POOL, // poolindex
        OUT tag, // ptr
    )

    IF OsError ( status ) THEN
        // Failed.

        KeReleaseLock ( lock )

        KeAcquireLockExclusive ( &arena^.Lock )

        RETURN status
    END

    numtags := RTL_PAGE_SIZE / SIZEOF ExpArenaTag

    // Repopulate arenas involved in population.

    i := 0
    count := expnode^.PopulatorArenaIndex

    WHILE i < count DO
        populator := expnode^.PopulatorArenas[i]

        KeAcquireLockExclusive ( &populator^.Lock )

        WHILE populator^.TagReserveCount < populator^.TagReserveMinimum DO
            KeAssert ( numtags != 0 )

            RtlInsertAtHeadList (
                &populator^.TagReserveListHead, // listhead
                &tag^.ListEntry, // listentry
            )

            tag += SIZEOF ExpArenaTag
            numtags -= 1
            populator^.TagReserveCount += 1
        END

        KeReleaseLock ( &populator^.Lock )

        i += 1
    END

    KeReleaseLock ( lock )

    // Repopulate this arena.

    KeAcquireLockExclusive ( &arena^.Lock )

    WHILE arena^.TagReserveCount < arena^.TagReserveMinimum DO
        KeAssert ( numtags != 0 )

        RtlInsertAtHeadList (
            &arena^.TagReserveListHead, // listhead
            &tag^.ListEntry, // listentry
        )

        tag += SIZEOF ExpArenaTag
        numtags -= 1
        arena^.TagReserveCount += 1
    END

    IF numtags THEN
        // Put any left on the per node free list.

        KeAcquireLockExclusive ( &expnode^.ArenaTagListLock )

        WHILE numtags DO
            RtlInsertAtHeadList (
                &expnode^.ArenaTagListHead, // listhead
                &tag^.ListEntry, // listentry
            )

            tag += SIZEOF ExpArenaTag
            numtags -= 1
        END

        KeReleaseLock ( &expnode^.ArenaTagListLock )
    END

    RETURN OS_STATUS_SUCCESS
END

FN ExpAllocateTag (
    IN arena : ^ExpArena,
) : ^ExpArenaTag

    // Allocate a tag from the arena. Arena lock held.

    IF RtlEmptyList ( &arena^.TagReserveListHead ) THEN
        RETURN NULLPTR
    END

    tag := CONTAINEROF arena^.TagReserveListHead.Next TO ExpArenaTag.ListEntry

    RtlRemoveEntryList ( &tag^.ListEntry )

    arena^.TagReserveCount -= 1

    RETURN tag
END

FN ExpFreeTag (
    IN arena : ^ExpArena,
    IN tag : ^ExpArenaTag,
)

    // Free the tag to the arena. Lock held.

    RtlInsertAtHeadList (
        &arena^.TagReserveListHead, // listhead
        &tag^.ListEntry, // entry
    )

    arena^.TagReserveCount += 1
END

FN ExAllocateFromArena (
    IN arena : ^ExpArena,
    IN flags : UWORD,
    IN size : UWORD,
    OUT address : ^VOID,
) : OsStatus

    // Unconstrained allocation of a block with the given size.

    KeAssert ( size != 0 )
    KeAssert ( size & ((1 << arena^.QuantumShift) - 1) == 0 )

    // First try the quantum caches.

    IF size <= arena^.QuantumCacheMaximum AND
        flags & MM_ALLOCATE_NO_QUANTUM_CACHE == 0 THEN

        RETURN MmAllocateFromPoolCache (
            arena^.QuantumCaches[size >> arena^.QuantumShift].Cache, // cache
            flags, // flags
            OUT address, // ptr
        )
    END

    // Didn't work out.

    retries := 0
    status := OS_STATUS_ARENA_EXHAUSTED

@Retry

    ipl := KeAcquireLockExclusiveRaise ( &arena^.Lock )

@RetryLockHeld

    IF arena^.TagReserveCount < arena^.TagReserveMinimum THEN
        status = ExpPopulateTagReserve (
            arena, // arena
            flags, // flags
        )

        IF OsError ( status ) THEN
            KeReleaseLockLower ( &arena^.Lock, ipl )

            RETURN status
        END
    END

    // Search for a block of the right size in the size-ordered  free block
    // tree.

    tag : ^ExpArenaTag
    alloctag : ^ExpArenaTag = NULLPTR
    avlnode := arena^.FreeTree.Right

    WHILE TRUE DO
        IF NOT avlnode THEN
            // Didn't find it.

            BREAK
        END

        tag = CONTAINEROF avlnode TO ExpArenaTag.TreeEntry

        IF size <= tag^.Size THEN
            alloctag = tag

            IF size == tag^.Size THEN
                // Perfectly sized.

                BREAK
            END

            avlnode = avlnode^.Left

        ELSE
            avlnode = avlnode^.Right
        END
    END

    IF alloctag == NULLPTR THEN
        // There was no sufficiently sized free block in the whole arena.

        IF arena^.ImportCallbacks.Import THEN
            // There's an import function, so try to do that now.

            // Decrement the reserved tags by 3 to make sure nobody yoinks the
            // three we will need to describe the imported span.

            KeAssert ( arena^.TagReserveCount >= 3 )

            arena^.TagReserveCount -= 3

            KeReleaseLockLower ( &arena^.Lock, ipl )

            importminimum := 1 << arena^.ImportCallbacks.ImportQuantumShift
            importsize := (size + importminimum - 1) & -importminimum

            status = arena^.ImportCallbacks.Import (
                arena^.ImportCallbacks.Context, // context
                arena^.ImportArena, // importarena
                flags, // flags
                importsize, // size
                OUT address, // address
            )

            ipl = KeAcquireLockExclusiveRaise ( &arena^.Lock )

            arena^.TagReserveCount += 3

            IF NOT OsError ( status ) THEN
                // Import succeeded.

                // Allocate span left tag.

                tag = ExpAllocateTag ( arena )
                tag^.Type = EXP_TAG_SPAN
                tag^.Address = address
                tag^.Size = size

                RtlInsertAtTailList (
                    &arena^.SegmentListHead, // listhead
                    &tag^.ListEntry, // entry
                )

                // Allocate span content tag.

                tag = ExpAllocateTag ( arena )
                tag^.Type = EXP_TAG_FREE
                tag^.Address = address
                tag^.Size = size

                RtlInsertAtTailList (
                    &arena^.SegmentListHead, // listhead
                    &tag^.ListEntry, // entry
                )

                RtlInsertAvl (
                    &arena^.FreeTree, // root
                    &tag^.TreeEntry, // node
                    &ExpArenaCompareTagsBySize, // comparisonfunc
                )

                // Allocate span right tag.

                tag = ExpAllocateTag ( arena )
                tag^.Type = EXP_TAG_SPAN
                tag^.Address = address
                tag^.Size = 0

                RtlInsertAtTailList (
                    &arena^.SegmentListHead, // listhead
                    &tag^.ListEntry, // entry
                )

                // Retry the allocation.

                GOTO RetryLockHeld
            END
        END

        KeReleaseLockLower ( &arena^.Lock, ipl )

        // Importing from the arena failed or there's none to import from.

        IF arena^.QuantumCacheMaximum != 0 AND
            retries <= 1 THEN

            // Reap quantum caches and try again.

            ExpAdjustQuantumCaches (
                arena, // arena
                retries == 1, // purge
            )

            retries += 1

            GOTO Retry
        END

        // If we made it here then we failed to get any block.

        RETURN status
    END

    // There was a sufficient block.

    address = alloctag^.Address

    // Remove the allocated tag from the size-ordered tree.

    RtlRemoveAvl (
        &arena^.FreeTree, // root
        &alloctag^.TreeEntry, // node
    )

    IF size != alloctag^.Size THEN
        // Create a right-fragment.

        righttag := ExpAllocateTag ( arena )

        righttag^.Type = EXP_TAG_FREE

        KeAssert ( righttag != NULLPTR )

        righttag^.Address = address + size
        righttag^.Size = alloctag^.Size - size

        // Insert after alloctag.

        RtlInsertAtHeadList (
            &alloctag^.ListEntry, // listhead
            &righttag^.ListEntry, // listentry
        )

        alloctag^.Size -= size

        // Insert right tag in size-ordered free tree.

        RtlInsertAvl (
            &arena^.FreeTree, // root
            &righttag^.TreeEntry, // node
            &ExpArenaCompareTagsBySize, // comparisonfunc
        )
    END

    // Insert the allocated tag in the arena's lookup structure.

    arena^.TagCallbacks.InsertTag (
        arena^.TagCallbacks.Context, // context
        address, // address
        alloctag, // tag
    )

    alloctag^.Type = EXP_TAG_ALLOCATED

    KeReleaseLockLower ( &arena^.Lock, ipl )

    RETURN OS_STATUS_SUCCESS
END

FN ExpFreeToArena (
    IN arena : ^ExpArena,
    IN address : ^VOID,
)

    // Free a block to the arena. Bypass quantum caches.

    ipl := KeAcquireLockExclusiveRaise ( &arena^.Lock )

    tag := arena^.TagCallbacks.LookupTag (
        arena^.TagCallbacks.Context, // context
        address, // address
    )

    KeAssert ( tag != NULLPTR )
    KeAssert ( tag^.Type == EXP_TAG_ALLOCATED )
    KeAssert ( tag^.Address == address )

    // Check left. Checks can be elided because all spans are preceded and
    // succeeded by EXP_TAG_SPAN tags.

    othertag := CONTAINEROF tag^.ListEntry.Prev TO ExpArenaTag.ListEntry

    IF othertag^.Type == EXP_TAG_FREE THEN
        // Coalesce left.

        othertag^.Size += tag^.Size

        RtlRemoveEntryList ( &tag^.ListEntry )

        RtlRemoveAvl (
            &arena^.FreeTree, // root
            &tag^.TreeEntry, // node
        )

        ExpFreeTag (
            arena, // arena
            tag, // tag
        )

        tag = othertag
    END

    // Check right.

    othertag = CONTAINEROF tag^.ListEntry.Next TO ExpArenaTag.ListEntry

    IF othertag^.Type == EXP_TAG_FREE THEN
        // Coalesce right.

        tag^.Size += othertag^.Size

        RtlRemoveEntryList ( &othertag^.ListEntry )

        RtlRemoveAvl (
            &arena^.FreeTree, // root
            &othertag^.TreeEntry, // node
        )

        ExpFreeTag (
            arena, // arena
            othertag, // tag
        )
    END

    othertag = CONTAINEROF tag^.ListEntry.Prev TO ExpArenaTag.ListEntry

    IF (CONTAINEROF tag^.ListEntry.Prev TO ExpArenaTag.ListEntry)^.Type
        == EXP_TAG_SPAN AND
        (CONTAINEROF tag^.ListEntry.Next TO ExpArenaTag.ListEntry)^.Type
        == EXP_TAG_SPAN AND
        arena^.ImportCallbacks.Free THEN

        // The whole span is free and should be returned to the arena it was
        // imported from.

        // Remove the left span tag.

        othertag = CONTAINEROF tag^.ListEntry.Prev TO ExpArenaTag.ListEntry

        RtlRemoveEntryList ( &othertag^.ListEntry )

        ExpFreeTag (
            arena, // arena
            othertag, // tag
        )

        // Remove the right span tag.

        othertag = CONTAINEROF tag^.ListEntry.Next TO ExpArenaTag.ListEntry

        RtlRemoveEntryList ( &othertag^.ListEntry )

        ExpFreeTag (
            arena, // arena
            othertag, // tag
        )

        // Remove the middle tag.

        address = tag^.Address
        size := tag^.Size

        RtlRemoveEntryList ( &tag^.ListEntry )

        ExpFreeTag (
            arena, // arena
            tag, // tag
        )

        KeReleaseLockLower ( &arena^.Lock, ipl )

        // Free the span to the source.

        arena^.ImportCallbacks.Free (
            arena^.ImportCallbacks.Context, // context
            arena^.ImportArena, // importarena
            address, // address
            size, // size
        )

        LEAVE
    END

    // Set the tag free.

    tag^.Type = EXP_TAG_FREE

    // Insert into the free tree.

    RtlInsertAvl (
        &arena^.FreeTree, // root
        &tag^.TreeEntry, // node
        &ExpArenaCompareTagsBySize, // comparisonfunc
    )

    KeReleaseLockLower ( &arena^.Lock, ipl )
END

FN ExFreeToArena (
    IN arena : ^ExpArena,
    IN address : ^VOID,
    IN size : UWORD,
)

    // Free a block to the arena.

    KeAssert ( size != 0 )
    KeAssert ( size & ((1 << arena^.QuantumShift) - 1) == 0 )

    // Will free to a quantum cache if the block is appropriately sized.
    // Otherwise free directly to the arena.

    IF size <= arena^.QuantumCacheMaximum THEN
        MmFreeToPoolCache (
            arena^.QuantumCaches[size >> arena^.QuantumShift].Cache, // cache
            address, // ptr
        )

        LEAVE
    END

    ExpFreeToArena (
        arena, // arena
        address, // address
    )
END

FN (MmPoolCacheAllocateF) ExpPopulateQuantumCache (
    IN context : ^VOID,
    IN flags : UWORD,
    OUT ptr : ^VOID,
) : OsStatus

    // A quantum cache missed and the magazine layer called us to return a
    // block.

    qcache := CAST context TO ^ExpQuantumCache

    RETURN ExAllocateFromArena (
        qcache^.Arena, // arena
        flags | MM_ALLOCATE_NO_QUANTUM_CACHE, // flags
        qcache^.Size, // size
        OUT ptr, // address
    )
END

FN (MmPoolCacheFreeF) ExpFreeQuantumCache (
    IN context : ^VOID,
    IN ptr : ^VOID,
)

    // Free a block from a quantum cache back to its underlying arena.

    qcache := CAST context TO ^ExpQuantumCache
    arena := qcache^.Arena

    ExpFreeToArena (
        arena, // arena
        ptr, // ptr
    )
END

FN (ExArenaImportF) ExDefaultArenaImport (
    IN context : ^VOID,
    IN importarena : ^ExpArena,
    IN flags : UWORD,
    IN size : UWORD,
    OUT address : ^VOID,
) : OsStatus

    RETURN ExAllocateFromArena (
        importarena, // arena
        flags, // flags
        size, // size
        OUT address, // address
    )
END

FN (ExArenaFreeF) ExDefaultArenaFree (
    IN context : ^VOID,
    IN importarena : ^ExpArena,
    IN address : ^VOID,
    IN size : UWORD,
) : OsStatus

    ExFreeToArena (
        importarena, // arena
        address, // address
        size, // size
    )
END

#SECTION "PAGEtext"
FN ExCreateArena (
    IN name : ^UBYTE,
    IN kenode : ^KeuNode,
    IN flags : UWORD,
    IN tagcallbacks : ^ExArenaTagCallbacks,
    IN importcallbacks : ^ExArenaImportCallbacks,
    IN quantumcachemax : UWORD,
    IN pageable : UWORD,
    IN quantumshift : UWORD,
    IN importarena : ^ExpArena,
    OUT arena : ^ExpArena,
) : OsStatus

    // Create an arena.

    quantumcachemax >>= quantumshift

    IF quantumcachemax >= EXP_MAX_QUANTUM_CACHES THEN
        RETURN OS_STATUS_NO_MEMORY
    END

    status : OsStatus

    expnode := kenode^.Exp

    arena = NULLPTR

    KeAcquireLockExclusive ( &expnode^.ArenaListLock )

    IF expnode^.PreallocatedArenaIndex < EXP_PREALLOCATED_ARENAS THEN
        // There are still preallocated arenas, so take one.

        arena = &expnode^.PreallocatedArenas[expnode^.PreallocatedArenaIndex]

        expnode^.PreallocatedArenaIndex += 1
    END

    KeReleaseLock ( &expnode^.ArenaListLock )

    IF NOT arena THEN
        // No more preallocated arenas left, so grab one from the arena pool
        // cache.

        status = MmAllocateFromPoolCache (
            expnode^.ArenaCache, // cache
            flags, // flags
            OUT arena, // ptr
        )

        IF OsError ( status ) THEN
            RETURN status
        END
    END

    // Initialize the arena structure before adding it to the arena list.

    KeInitializeLock ( &arena^.Lock )

    arena^.Name = name

    arena^.Node = kenode

    arena^.QuantumShift = quantumshift

    arena^.ImportArena = importarena

    IF NOT tagcallbacks THEN
        arena^.TagCallbacks.Context = arena
        arena^.TagCallbacks.LookupTag = &ExpArenaLookupTag
        arena^.TagCallbacks.InsertTag = &ExpArenaInsertTag
        arena^.TagCallbacks.RemoveTag = &ExpArenaRemoveTag
    
    ELSE
        RtlCopyBytes (
            &arena^.TagCallbacks, // dest
            tagcallbacks, // src
            SIZEOF ExArenaTagCallbacks, // sz
        )
    END

    IF NOT importcallbacks THEN
        RtlFillMemoryWithUlong (
            &arena^.ImportCallbacks, // dest
            SIZEOF ExArenaImportCallbacks, // sz
            0, // ulong
        )

        IF importarena THEN
            arena^.ImportCallbacks.Import = &ExDefaultArenaImport
            arena^.ImportCallbacks.Free = &ExDefaultArenaFree
            arena^.ImportCallbacks.ImportQuantumShift =
                importarena^.QuantumShift
        END
    
    ELSE
        RtlCopyBytes (
            &arena^.ImportCallbacks, // dest
            importcallbacks, // src
            SIZEOF ExArenaImportCallbacks, // sz
        )
    END

    arena^.QuantumCacheMaximum = quantumcachemax << quantumshift

    RtlInitializeAvl ( &arena^.FreeTree )

    RtlInitializeAvl ( &arena^.UsedTree )

    RtlInitializeList ( &arena^.SegmentListHead )

    RtlInitializeList ( &arena^.TagReserveListHead )
    arena^.TagReserveCount = 0

    // Two for import tags and two for each side of a middle-split block.

    arena^.TagReserveMinimum = 4

    // Multiply by four for one normal user plus three concurrent populators.

    arena^.TagReserveMinimum *= 4

    i := 1

    WHILE i <= quantumcachemax DO
        arena^.QuantumCaches[i].Arena = arena
        arena^.QuantumCaches[i].Size = i << quantumshift

        status = MmCreatePoolCacheEx (
            kenode^.Mmp, // mmnode
            "QuantumCache", // name
            i, // size
            pageable, // pageable
            &ExpPopulateQuantumCache, // allocfunc
            &ExpFreeQuantumCache, // freefunc
            NULLPTR, // deletefunc
            &arena^.QuantumCaches[i], // context
            OUT arena^.QuantumCaches[i].Cache, // poolcache
        )

        IF OsError ( status ) THEN
            // Back out and return error status.

            WHILE i != 1 DO
                i -= 1

                MmDeletePoolCache ( arena^.QuantumCaches[i].Cache )
            END

            ExpFreeArena ( arena )

            RETURN status
        END

        i += 1
    END

    // Insert into the node's arena list.
    // This list is to be used for user introspection.

    KeAcquireLockExclusive ( &expnode^.ArenaListLock )

    RtlInsertAtTailList (
        &expnode^.ArenaListHead, // listhead
        &arena^.Entry, // entry
    )

    KeReleaseLock ( &expnode^.ArenaListLock )
END