//
// The I/O Catalog tracks the device drivers known to the system and enables
// driver matching.
//

#INCLUDE "Iop.hjk"
#INCLUDE "../../Loader/Headers/Loader.hjk"

IopCatalogLock : KeLock

IopModuleDictionary : ExuDictionary
IopClassDictionary : ExuDictionary

#SECTION "PAGEtext"
FN IopInitializeLoadedModule (
    IN module : ^IopModule,
) : OsStatus

    // A module has been loaded and now has to be initialized.

    status : OsStatus

    // Call the DrvInitialize routine.

    IF module^.Initialize THEN
        status = module^.Initialize ( module )

        IF OsError ( status ) THEN
            RETURN status
        END
    END

    // Initialize all of the classes as specified in the class table.

    IF module^.ClassTable THEN
        // Iterate the class entries up until the first sentinel entry which
        // has a name of NULLPTR, and initialize loaded classes according to
        // the information therein.

        // If any of these fail then call the DrvUninitialize routine and exit
        // with an error status.

        KeCrash ( "TODO IopInitializeLoadedModule\n" )
    END

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
FN IopLoadClassByName (
    IN name : ^RtlString,
    OUT class : ^IopClass,
) : OsStatus

    // Load an IO class by name. Returns a referenced pointer to the class or
    // an error status.

    status : OsStatus

@Retry

    KeAcquireLockExclusive ( &IopCatalogLock )

@RetryLockHeld

    class = ExLookupDictionary (
        &IopClassDictionary, // dict
        name, // key
    )

    IF NOT class THEN
        // Don't know of this class.

        KeReleaseLock ( &IopCatalogLock )

        RETURN OS_STATUS_UNKNOWN_IOCLASS
    END

    module := class^.Module

    IF ExIsActionInProgress ( &module^.LoadAction ) THEN
        // Someone else is loading it.

        status = ExPrepareWaitForAction (
            &module^.LoadAction, // action
            MM_ALLOCATE_WAIT, // flags
            OUT: waitable, // waitable
        )

        KeReleaseLock ( &IopCatalogLock )

        IF OsError ( status ) THEN
            RETURN status
        END

        // Wait for the other guy to finish loading the module, outside any
        // locks, and then retry.

        ExWaitForActionCompletion ( waitable )

        GOTO Retry
    END

    library := module^.Library

    IF library THEN
        // The library exists, so reference it and return.

        module^.ClassReferences += 1

        KeReleaseLock ( &IopCatalogLock )

        RETURN OS_STATUS_SUCCESS
    END

    KeAssert ( module^.ClassReferences == 0 )

    // The library isn't loaded yet, so we're responsible for doing that.
    // Start the load action and then load it outside of any locks, so that
    // anybody else who tries to load this module will wait for us to finish.

    // This might seem redundant because loading the library by symbolic name
    // will also start an action that is used to scalably wait for a thing to
    // complete, but ExLibrary's action doesn't cover the potentially lengthy
    // extra work of initializing an I/O module that we're also gonna be doing.

    ExStartAction ( &module^.LoadAction )

    KeReleaseLock ( &IopCatalogLock )

    status = ExLoadLibrary (
        &module^.Path^.String, // path
        &module^.Name^.String, // name
        EX_LOAD_LIBRARY_KEEP_HEADERS, // flags
        OUT library, // library
        OUT: cached, // cached
    )

    IF OsError ( status ) THEN
        // Failed to load the library so get outta here.

        GOTO Exit
    END

    IF NOT cached THEN
        // The copy of the library we got was not cached, so we just loaded it.
        // It still has its headers and we need to jettison them to free up
        // space. Before doing that, we need to look up the symbols our I/O
        // system cares about.

        // This might seem scary but the effect of this is just that these
        // values are "sticky" in the module structure as long as we reuse the
        // same copy of the library. We're guaranteed to look them up the first
        // time the module is initialized, so don't fear.

        module^.Initialize = ExLookupSymbolLibrary (
            library, // library
            "DrvInitialize", // symbol
        )

        module^.Uninitialize = ExLookupSymbolLibrary (
            library, // library
            "DrvUninitialize", // symbol
        )

        module^.ClassTable = ExLookupSymbolLibrary (
            library, // library
            "DrvClassTable", // symbol
        )

        // Jettison library headers to save space.

        ExJettisonHeadersLibrary ( library )
    END

    // Now do the common module initialization stuff.
    // This is made common so that the boot module path can call the same
    // thing.

    status = IopInitializeLoadedModule ( module )

    IF OsError ( status ) THEN
        // Failed to initialize the module so unload the library and get outta
        // here.

        ExUnloadLibrary ( library )
    END

@Exit

    // Take the catalog lock.

    KeAcquireLockExclusive ( &IopCatalogLock )

    // Complete the action under the catalog lock in order to wake up anyone
    // waiting for us to finish initializing the module.

    ExCompleteAction ( &module^.LoadAction )

    IF OsError ( status ) THEN
        // There was a failure so just return.

        KeReleaseLock ( &IopCatalogLock )

        RETURN status
    END

    // Successfully loaded the library so save that information.

    module^.Library = library

    // Now set the module as having 1 ClassReference to reflect the one we're
    // taking away.

    module^.ClassReferences = 1

    // And return the class.

    KeReleaseLock ( &IopCatalogLock )

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
FN IopLookupModule (
    IN name : ^RtlString,
    IN create : UWORD,
    OUT module : ^IopModule
) : OsStatus

    // Look up a known module, or register it.
    // Catalog lock is held.

    module = CAST ExLookupDictionary (
        &IopModuleDictionary, // dict
        name, // key
    ) TO ^IopModule

    IF module THEN
        // Found the module so return success.

        RETURN OS_STATUS_SUCCESS
    END

    IF NOT create THEN
        // Didn't find the module and didn't wanna create it,
        // so return an error.

        RETURN OS_STATUS_NOT_FOUND
    END

    // Didn't find the module, but the caller asked us to create it in that
    // case, so do that now.

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF IopModule, // bytes
        'KnMo', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT module, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Insert it into the dictionary.

    status = ExInsertInDictionary (
        &IopModuleDictionary, // dict
        name, // key
        module, // value
        FALSE, // canupdate
        OUT: oldvalue, // oldvalue
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // Intern the name of the module.

    module^.Name = ExFindName ( name )

    IF NOT module^.Name THEN
        GOTO Exit2
    END

    // No associated loaded library yet, this module represents just a container
    // of classes that exists but isn't loaded yet.

    module^.Library = NULLPTR

    // No class references yet.

    module^.ClassReferences = 0

    // Empty class list.

    RtlInitializeList ( &module^.ClassListHead )

    // Unstarted load action.

    ExInitializeAction ( &module^.LoadAction )

    RETURN OS_STATUS_SUCCESS

@Exit2

    ExRemoveFromDictionary (
        &IopModuleDictionary, // dict
        name, // key
    )

@Exit

    MmFreePool (
        module, // module
        'KnMo', // tag
    )

    RETURN status
END

#SECTION "PAGEtext"
FN IopCreateClass (
    OUT class : ^IopClass,
) : OsStatus

    // Create a class structure.

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF IopClass, // bytes
        'IoKc', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT class, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Initialize the part of the class structure that is relevant to the
    // catalog even when the class is not loaded.

    // Initialize the properties dictionary.

    ExuInitializeDictionary ( &class^.Properties )

    // Initialize the module to unloaded.

    class^.Module = NULLPTR

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
FN IopGetClassProperty (
    IN class : ^IopClass,
    IN name : ^RtlString,
) : ^RtlString

    // Return the value of a given property in the class, or NULLPTR
    // if none.

    RETURN ExLookupDictionary (
        &class^.Properties, // dict
        name, // key
    )
END

#SECTION "PAGEtext"
FN IopSetClassProperty (
    IN class : ^IopClass,
    IN name : ^RtlString,
    IN value : ^RtlString,
    IN canupdate : UWORD,
) : OsStatus

    // Set the given property in a class structure.

    RETURN ExInsertStringInDictionary (
        &class^.Properties, // dict
        name, // key
        value, // value
        canupdate, // canupdate
        NULLPTR, // oldvalue
    )
END

#SECTION "PAGEtext"
EXPORT FN IopDeleteClass (
    IN class : ^IopClass,
)

    // Delete a class structure.
    // If it was in a loaded state it should have been unloaded by now
    // and IopUninitializeClass'd.

    ExEnumerateDictionary (
        &class^.Properties, // dict
        &ExDeleteStringDictionaryEntry, // func
        NULLPTR, // context
        TRUE, // delete
    )

    MmFreePool (
        class, // ptr
        'IoKc', // tag
    )
END

#SECTION "PAGEtext"
FN IopForgetModule (
    IN module : ^IopModule,
) : OsStatus

    // Forcibly forget a module from the catalog. This is intended to allow a
    // module's configuration files to be re-loaded if a new version is
    // installed. Synchronization is obtained via the module's LoadAction.

    IF module^.Library THEN
        // The module is currently loaded, so initiate an unload (the big kind
        // that cancels IO requests and stuff) and then retry the whole operation.
        // If the unload fails, propagate the status to the caller.

        // ...

        RETURN OS_STATUS_TRY_AGAIN
    END

    // Make sure the memory for the module's library is fully freed so that it
    // is really reloaded from disk next time.

    ExForgetLibrary ( &module^.Name^.String )

    // The module's classes should now be inert. Delete their structures.

    // ...

    RETURN OS_STATUS_NOT_IMPLEMENTED
END

#SECTION "PAGEtext"
FN IopProcessConfiguration (
    IN modulename : ^RtlString,
    IN configtext : ^UBYTE,
    IN configsize : UWORD,
) : OsStatus

    // Process a driver configuration file.

    // First parse the configuration and create an IopClass for each
    // described class.

    status := IopParseConfiguration (
        configtext, // configtext
        configsize, // configsize
        OUT: class, // class
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Now take the catalog lock.

    KeAcquireLockExclusive ( &IopCatalogLock )

    status = IopLookupModule (
        modulename, // name
        TRUE, // create
        OUT: module, // module
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // If we already processed a configuration file for this module, we want to
    // forget whatever we learned there.

    status = IopForgetModule ( module )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // Insert all of the classes into the IO catalog.

    // ...

@Exit

    KeReleaseLock ( &IopCatalogLock )

    IF OsError ( status ) THEN
        IopDeleteClassList ( class )
    END

    RETURN status
END

#SECTION "PAGEtext"
FN IopReferenceModule (
    IN module : ^IopModule,
)

    // Increment the module's class reference count.

    // Usually happens to retain a reference to a superclass's containing
    // module when a new class is being loaded.

    KeAssert ( module^.ClassReferences != 0 )

    // Do it under the catalog lock.

    // Technically this could be done with an atomic but the catalog lock isn't
    // anticipated to be a scalability concern since hugely parallel operations
    // on the system's set of loaded drivers are only done at boot time and
    // the really lengthy stuff is already done outside the catalog lock, so
    // that would just burden other codepaths with also needing to use atomics.

    KeAcquireLockExclusive ( &IopCatalogLock )

    module^.ClassReferences += 1

    KeReleaseLock ( &IopCatalogLock )
END

#SECTION "PAGEtext"
FN IopUnreferenceModule (
    IN module : ^IopModule,
)

    // Decrement the module's class reference count, which may cause the module
    // to be uninitialized if if drops to zero.

    KeAssert ( module^.ClassReferences != 0 )

    // Do it under the catalog lock.

    KeAcquireLockExclusive ( &IopCatalogLock )

    module^.ClassReferences -= 1

    IF module^.ClassReferences != 0 THEN
        // That didn't drop the number of references to zero, so just leave.

        KeReleaseLock ( &IopCatalogLock )

        LEAVE
    END

    // The module no longer has any references and this instance of it should
    // be uninitialized.

    library := module^.Library

    // Clear the library pointer and start the load action, so that anybody
    // who tries to look up the module waits for us to finish unloading it
    // before they try to reload it.

    module^.Library = NULLPTR

    ExStartAction ( &module^.LoadAction )

    // Release the catalog lock to do lengthy work.

    KeReleaseLock ( &IopCatalogLock )

    // Uninitialize all of the classes, to put them back into an inert and
    // "unloaded" state. This may recursively unload other modules if they
    // contain superclasses of this class.

    listhead := &module^.ClassListHead
    listentry := listhead^.Next

    WHILE listentry != listhead DO
        class := CONTAINEROF listentry TO IopClass.Entry
        listentry = listentry^.Next

        IopUninitializeClass ( class )
    END

    // Call the uninitialize routine, if there is one.

    IF module^.Uninitialize THEN
        module^.Uninitialize ( module )
    END

    // Unload the library. Note that this is just unreferencing a cached copy
    // of it, but nevertheless we aren't allowed to touch it after this since
    // it could be deleted for real at any time from asynchronous context.

    ExUnloadLibrary ( library )

    // Complete the load action under the catalog lock in order to wake up
    // anybody waiting for us to uninitialize the module.

    KeAcquireLockExclusive ( &IopCatalogLock )

    ExCompleteAction ( &module^.LoadAction )

    KeReleaseLock ( &IopCatalogLock )
END

#ENTERSECTION "INITtext"

FN IopInitializeCatalog ()

    // Initialize the IO Catalog.

#LEAVESECTION
    KeInitializeLock ( &IopCatalogLock, "CatalogLock" )
#ENTERSECTION "INITtext"

    // Initialize the module and class dictionaries.

    ExuInitializeDictionary ( &IopModuleDictionary )

    ExuInitializeDictionary ( &IopClassDictionary )

    // Create proper IO module structures for all of the bootloader's initial
    // modules.

    name : RtlString

    listhead := &KeuLoaderBlock.DllListHead
    listentry := listhead^.Next

    WHILE listhead != listentry DO
        bldll := CONTAINEROF listentry TO BlDll.Entry
        listentry = listentry^.Next

        RtlInitializeString ( &name, &bldll^.Name[0] )

        // Create the IopModule for this module.

        status := IopLookupModule (
            &name, // name
            TRUE, // create
            OUT: module, // module
        )

        IF OsError ( status ) THEN
            KeCrash ( "Failed to set up initial known module structures\n" )
        END

        // Initialize it manually.

        // Jam it referenced since we currently never uninitialize bootloaded
        // modules.

        module^.ClassReferences = 1

        // Set the library to the special one created by ExLibrary which was
        // stashed in the FreeSpace pointer.

        module^.Library = bldll^.FreeSpace

        // Manually set the symbol pointers to the ones looked up by the
        // bootloader.

        module^.Initialize = bldll^.Initialize
        module^.Uninitialize = NULLPTR
        module^.ClassTable = bldll^.ClassTable

        // Replace the FreeSpace pointer with a pointer to our module so that
        // we can use it conveniently in a bit.

        bldll^.FreeSpace = module
    END

    // Process all of the configuration files loaded by the bootloader.

    listhead = &KeuLoaderBlock.ResourceListHead
    listentry = listhead^.Next

    WHILE listentry != listhead DO
        rsrc := CONTAINEROF listentry TO BlResource.Entry

        IF rsrc^.IoConfig THEN
            RtlInitializeString ( &name, &rsrc^.Name[0] )

            IopProcessConfiguration (
                &name, // modulename
                rsrc^.Data, // configtext
                rsrc^.Size, // configsize
            )
        END

        listentry = listentry^.Next
    END

    // Call the initialization routines for each of the drivers loaded at
    // boot time.

    listhead = &KeuLoaderBlock.DllListHead
    listentry = listhead^.Next

    WHILE listhead != listentry DO
        bldll := CONTAINEROF listentry TO BlDll.Entry
        listentry = listentry^.Next

        module : ^IopModule = bldll^.FreeSpace

        status := IopInitializeLoadedModule ( module )

        IF OsError ( status ) THEN
            KeCrash ( "Failed to initialize boot driver %s\n",
                module^.Name^.String.Data )
        END
    END
END

#LEAVESECTION