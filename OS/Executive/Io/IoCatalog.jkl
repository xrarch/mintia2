//
// The I/O Catalog tracks the device drivers known to the system and enables
// driver matching.
//

#INCLUDE "Iop.hjk"
#INCLUDE "../../Loader/Headers/Loader.hjk"

IopCatalogLock : KeLock

IopKnownModuleDictionary : ExuDictionary

#SECTION "PAGEtext"
FN IopLookupKnownModule (
    IN name : ^RtlString,
    IN create : UWORD,
    OUT knownmodule : ^IopKnownModule
) : OsStatus

    // Look up a known module, or register it.
    // Catalog lock is held.
    //
    // If create is FALSE, a return value of NULLPTR means it wasn't found.
    // If create is TRUE, a return value of NULLPTR means insufficient memory.

    knownmodule = CAST ExLookupDictionary (
        &IopKnownModuleDictionary, // dict
        name, // key
    ) TO ^IopKnownModule

    IF knownmodule OR NOT create THEN
        // Found it, or we didn't find it and don't wanna create it.
        // In either case just return what we have.

        RETURN OS_STATUS_SUCCESS
    END

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF IopKnownModule, // bytes
        'KnMo', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT knownmodule, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Insert it into the dictionary.

    oldvalue : ^VOID

    status = ExInsertInDictionary (
        &IopKnownModuleDictionary, // dict
        name, // key
        knownmodule, // value
        FALSE, // canupdate
        OUT oldvalue, // oldvalue
    )

    IF OsError ( status ) THEN
        MmFreePool (
            knownmodule, // knownmodule
            'KnMo', // tag
        )

        RETURN status
    END

    // Initialize as not having an associated loaded module.

    knownmodule^.Module = NULLPTR

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
EXPORT FN IoCreateKnownClass (
    OUT knownclass : ^IopKnownClass,
) : OsStatus

    // Create a known class structure.

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF IopKnownClass, // bytes
        'IoKc', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT knownclass, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Initialize the dictionary.

    ExuInitializeDictionary ( &knownclass^.Properties )

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
EXPORT FN IoGetKnownClassProperty (
    IN knownclass : ^IopKnownClass,
    IN name : ^RtlString,
) : ^RtlString

    // Return the value of a given property in the known class, or NULLPTR
    // if none.

    RETURN ExLookupDictionary (
        &knownclass^.Properties, // dict
        name, // key
    )
END

#SECTION "PAGEtext"
EXPORT FN IoSetKnownClassProperty (
    IN knownclass : ^IopKnownClass,
    IN name : ^RtlString,
    IN value : ^RtlString,
    IN canupdate : UWORD,
) : OsStatus

    // Set the given property in a known class structure.

    RETURN ExInsertStringInDictionary (
        &knownclass^.Properties, // dict
        name, // key
        value, // value
        canupdate, // canupdate
        NULLPTR, // oldvalue
    )
END

#SECTION "PAGEtext"
EXPORT FN IoDeleteKnownClass (
    IN knownclass : ^IopKnownClass,
)

    // Delete a known class structure.

    ExEnumerateDictionary (
        &knownclass^.Properties, // dict
        &ExDeleteStringDictionaryEntry, // func
        NULLPTR, // context
        TRUE, // delete
    )

    MmFreePool (
        knownclass, // ptr
        'IoKc', // tag
    )
END

#SECTION "PAGEtext"
FN IopForgetModule (
    IN modulename : ^UBYTE,
) : OsStatus

    // Forcibly forget a module. The catalog lock is held on entry.

    // First look up the module.

    // If the module wasn't found, nothing to do.

    // If the module was found and is currently loaded, unlock the catalog lock
    // and initiate an unload and then retry the whole operation. If the unload
    // fails, propagate the status to the caller.

    // If the module was found and is unloaded, forget about it from the
    // catalog.

    RETURN OS_STATUS_NOT_IMPLEMENTED
END

#SECTION "PAGEtext"
FN IopProcessConfiguration (
    IN modulename : ^UBYTE,
    IN configtext : ^UBYTE,
    IN configsize : UWORD,
) : OsStatus

    // Process a driver configuration file.

    class : ^IopKnownClass

    // First parse the configuration and create an IopKnownClass for each
    // described class.

    status := IopParseConfiguration (
        configtext, // configtext
        configsize, // configsize
        OUT class, // class
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Now take the catalog lock.

    KeAcquireLockExclusive ( &IopCatalogLock )

    // If we already processed a configuration file for this module, we want to
    // forget whatever we learned there. 

    status = IopForgetModule ( modulename )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // Insert all of the known classes into the IO catalog.

    // ...

@Exit

    KeReleaseLock ( &IopCatalogLock )

    RETURN status
END

#ENTERSECTION "INITtext"

FN IopInitializeCatalog ()

    // Initialize the IO Catalog.

#LEAVESECTION
    KeInitializeLock ( &IopCatalogLock, "CatalogLock" )
#ENTERSECTION "INITtext"

    // Initialize the known modules dictionary.

#LEAVESECTION
    ExuInitializeDictionary ( &IopKnownModuleDictionary )
#ENTERSECTION "INITtext"

    // Create a "known module" for the kernel itself.

    kernelname : RtlString

    RtlInitializeString ( &kernelname, "mintia.sys" )

    knownmodule : ^IopKnownModule

    status := IopLookupKnownModule (
        &kernelname, // name
        TRUE, // create
        OUT knownmodule, // knownmodule
    )

    IF OsError ( status ) THEN
        KeCrash (
            "%s: failed to create known module\n", // fmt
            "IopInitializeCatalog",
        )
    END

    // Set the known module to point to the executive module.

    knownmodule^.Module = ExuExecutiveModule

    // We need to process all of the configuration files loaded by the
    // bootloader.

    listhead := &KeuLoaderBlock.ResourceListHead
    listentry := listhead^.Next

    WHILE listentry != listhead DO
        rsrc := CONTAINEROF listentry TO BlResource.Entry

        IF rsrc^.IoConfig THEN
            IopProcessConfiguration (
                &rsrc^.Name[0], // modulename
                rsrc^.Data, // configtext
                rsrc^.Size, // configsize
            )
        END

        listentry = listentry^.Next
    END
END

#LEAVESECTION