//
// The I/O Catalog tracks the device drivers known to the system and enables
// driver matching.
//

#INCLUDE "Iop.hjk"
#INCLUDE "../../Loader/Headers/Loader.hjk"

IopCatalogLock : KeLock

IopModuleDictionary : ExuDictionary
IopClassDictionary : ExuDictionary

#SECTION "PAGEtext"
FN IopLoadClassByName (
    IN name : ^RtlString,
    OUT class : ^IopClass,
) : OsStatus

    // Load an IO class by name. Returns a referenced pointer to the class or
    // an error status.

    status : OsStatus

@Retry

    KeAcquireLockExclusive ( &IopCatalogLock )

@RetryLockHeld

    class = ExLookupDictionary (
        &IopClassDictionary, // dict
        name, // key
    )

    IF NOT class THEN
        // Don't know of this class.

        KeReleaseLock ( &IopCatalogLock )

        RETURN OS_STATUS_UNKNOWN_IOCLASS
    END

    module := class^.Module

    IF ExIsActionInProgress ( &module^.LoadAction ) THEN
        // Someone else is loading it, wait for them to finish and then
        // retry.

        status = ExPrepareWaitForAction (
            &module^.LoadAction, // action
            MM_ALLOCATE_WAIT, // flags
            OUT: waitable, // waitable
        )

        KeReleaseLock ( &IopCatalogLock )

        IF OsError ( status ) THEN
            RETURN status
        END

        ExWaitForActionCompletion ( waitable )

        GOTO Retry
    END

    library := module^.Library

    IF library THEN
        // The library exists, so reference it and return.

        module^.ClassReferences += 1

        KeReleaseLock ( &IopCatalogLock )

        RETURN OS_STATUS_SUCCESS
    END

    // The library isn't loaded yet.

    KeAssert ( module^.ClassReferences == 0 )

    ExStartAction ( &module^.LoadAction )

    KeReleaseLock ( &IopCatalogLock )

    status = ExLoadLibrary (
        &module^.Path^.String, // path
        &module^.Name^.String, // name
        OUT library, // library
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // Look up and call the DrvInitialize routine.

    initialize : IoDriverInitialize = ExLookupSymbolLibrary (
        library, // library
        "DrvInitialize", // symbol
    )

    IF initialize THEN
        status = initialize ( module )

        IF OsError ( status ) THEN
            // Driver failed to initialize, so unload.

            ExUnloadLibrary ( library )

            GOTO Exit
        END
    END

    module^.Uninitialize = ExLookupSymbolLibrary (
        library, // library
        "DrvUninitialize", // symbol
    )

@Exit

    KeAcquireLockExclusive ( &IopCatalogLock )

    ExCompleteAction ( &module^.LoadAction )

    IF OsError ( status ) THEN
        KeReleaseLock ( &IopCatalogLock )

        RETURN status
    END

    // Successfully loaded the library, so retry.

    module^.Library = library

    GOTO RetryLockHeld
END

#SECTION "PAGEtext"
FN IopLookupModule (
    IN name : ^RtlString,
    IN create : UWORD,
    OUT module : ^IopModule
) : OsStatus

    // Look up a known module, or register it.
    // Catalog lock is held.

    module = CAST ExLookupDictionary (
        &IopModuleDictionary, // dict
        name, // key
    ) TO ^IopModule

    IF module OR NOT create THEN
        // Found it, or we didn't find it and don't wanna create it.
        // In either case just return what we have.

        RETURN OS_STATUS_SUCCESS
    END

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF IopModule, // bytes
        'KnMo', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT module, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Insert it into the dictionary.

    status = ExInsertInDictionary (
        &IopModuleDictionary, // dict
        name, // key
        module, // value
        FALSE, // canupdate
        OUT: oldvalue, // oldvalue
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    module^.Name = ExFindName ( name )

    IF NOT module^.Name THEN
        GOTO Exit2
    END

    // Initialize as not having an associated loaded library.

    module^.Library = NULLPTR

    module^.ClassReferences = 0

    RtlInitializeList ( &module^.KnownClassListHead )

    ExInitializeAction ( &module^.LoadAction )

    RETURN OS_STATUS_SUCCESS

@Exit2

    ExRemoveFromDictionary (
        &IopModuleDictionary, // dict
        name, // key
    )

@Exit

    MmFreePool (
        module, // module
        'KnMo', // tag
    )

    RETURN status
END

#SECTION "PAGEtext"
FN IopCreateClass (
    OUT class : ^IopClass,
) : OsStatus

    // Create a class structure.

    status := MmAllocatePool (
        TRUE, // pageable
        SIZEOF IopClass, // bytes
        'IoKc', // tag
        MM_ALLOCATE_WAIT, // flags
        OUT class, // ptr
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Initialize the part of the class structure that is relevant to the
    // catalog even when the class is not loaded.

    // Initialize the properties dictionary.

    ExuInitializeDictionary ( &class^.Properties )

    // Initialize the module to unloaded.

    class^.Module = NULLPTR

    RETURN OS_STATUS_SUCCESS
END

#SECTION "PAGEtext"
FN IopGetClassProperty (
    IN class : ^IopClass,
    IN name : ^RtlString,
) : ^RtlString

    // Return the value of a given property in the class, or NULLPTR
    // if none.

    RETURN ExLookupDictionary (
        &class^.Properties, // dict
        name, // key
    )
END

#SECTION "PAGEtext"
FN IopSetClassProperty (
    IN class : ^IopClass,
    IN name : ^RtlString,
    IN value : ^RtlString,
    IN canupdate : UWORD,
) : OsStatus

    // Set the given property in a class structure.

    RETURN ExInsertStringInDictionary (
        &class^.Properties, // dict
        name, // key
        value, // value
        canupdate, // canupdate
        NULLPTR, // oldvalue
    )
END

#SECTION "PAGEtext"
EXPORT FN IopDeleteClass (
    IN class : ^IopClass,
)

    // Delete a class structure.
    // If it was in a loaded state it should have been unloaded by now
    // and IopUninitializeClass'd.

    ExEnumerateDictionary (
        &class^.Properties, // dict
        &ExDeleteStringDictionaryEntry, // func
        NULLPTR, // context
        TRUE, // delete
    )

    MmFreePool (
        class, // ptr
        'IoKc', // tag
    )
END

#SECTION "PAGEtext"
FN IopForgetModule (
    IN module : ^IopModule,
) : OsStatus

    // Forcibly forget a module's known classes. The catalog lock is held on
    // entry.

    // If the module is currently loaded, unlock the catalog lock and initiate
    // an unload and then retry the whole operation. If the unload fails,
    // propagate the status to the caller.

    // If the module was found and is unloaded, forget about it from the
    // catalog.

    RETURN OS_STATUS_NOT_IMPLEMENTED
END

#SECTION "PAGEtext"
FN IopProcessConfiguration (
    IN modulename : ^RtlString,
    IN configtext : ^UBYTE,
    IN configsize : UWORD,
) : OsStatus

    // Process a driver configuration file.

    // First parse the configuration and create an IopClass for each
    // described class.

    status := IopParseConfiguration (
        configtext, // configtext
        configsize, // configsize
        OUT: class, // class
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    // Now take the catalog lock.

    KeAcquireLockExclusive ( &IopCatalogLock )

    status = IopLookupModule (
        modulename, // name
        TRUE, // create
        OUT: module, // module
    )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // If we already processed a configuration file for this module, we want to
    // forget whatever we learned there.

    status = IopForgetModule ( module )

    IF OsError ( status ) THEN
        GOTO Exit
    END

    // Insert all of the classes into the IO catalog.

    // ...

@Exit

    KeReleaseLock ( &IopCatalogLock )

    IF OsError ( status ) THEN
        IopDeleteClassList ( class )
    END

    RETURN status
END

#SECTION "PAGEtext"
FN IopReferenceModule (
    IN module : ^IopModule,
)

    // Increment the module's class reference count.

    KeAcquireLockExclusive ( &IopCatalogLock )

    KeAssert ( module^.ClassReferences != 0 )

    module^.ClassReferences += 1

    KeReleaseLock ( &IopCatalogLock )
END

#SECTION "PAGEtext"
FN IopUnreferenceModule (
    IN module : ^IopModule,
)

    // Decrement the module's class reference count.

    KeAcquireLockExclusive ( &IopCatalogLock )

    KeAssert ( module^.ClassReferences != 0 )

    module^.ClassReferences -= 1

    IF module^.ClassReferences != 0 THEN
        KeReleaseLock ( &IopCatalogLock )

        LEAVE
    END

    // Unload the library.

    library := module^.Library
    module^.Library = NULLPTR

    ExStartAction ( &module^.LoadAction )

    KeReleaseLock ( &IopCatalogLock )

    module^.Uninitialize ( module )

    ExUnloadLibrary ( library )

    KeAcquireLockExclusive ( &IopCatalogLock )

    ExCompleteAction ( &module^.LoadAction )

    KeReleaseLock ( &IopCatalogLock )
END

#ENTERSECTION "INITtext"

FN IopInitializeCatalog ()

    // Initialize the IO Catalog.

#LEAVESECTION
    KeInitializeLock ( &IopCatalogLock, "CatalogLock" )
#ENTERSECTION "INITtext"

    // Initialize the known modules dictionary.

    ExuInitializeDictionary ( &IopModuleDictionary )

    ExuInitializeDictionary ( &IopClassDictionary )

    // Create known modules for all of the bootloader's initial modules.

    name : RtlString

    listhead := &KeuLoaderBlock.DllListHead
    listentry := listhead^.Next

    WHILE listhead != listentry DO
        bldll := CONTAINEROF listentry TO BlDll.Entry
        listentry = listentry^.Next

        RtlInitializeString ( &name, &bldll^.Name[0] )

        status := IopLookupModule (
            &name, // name
            TRUE, // create
            OUT: module, // module
        )

        IF OsError ( status ) THEN
            KeCrash ( "Failed to set up initial known module structures\n" )
        END

        module^.ClassReferences = 1
        module^.Library = bldll^.FreeSpace
        module^.Initialize = bldll^.DriverEntrypoint
        module^.Uninitialize = NULLPTR

        bldll^.FreeSpace = module
    END

    // Process all of the configuration files loaded by the bootloader.

    listhead = &KeuLoaderBlock.ResourceListHead
    listentry = listhead^.Next

    WHILE listentry != listhead DO
        rsrc := CONTAINEROF listentry TO BlResource.Entry

        IF rsrc^.IoConfig THEN
            RtlInitializeString ( &name, &rsrc^.Name[0] )

            IopProcessConfiguration (
                &name, // modulename
                rsrc^.Data, // configtext
                rsrc^.Size, // configsize
            )
        END

        listentry = listentry^.Next
    END

    // Call the initialization routines for each of the drivers loaded at
    // boot time.

    listhead = &KeuLoaderBlock.DllListHead
    listentry = listhead^.Next

    WHILE listhead != listentry DO
        bldll := CONTAINEROF listentry TO BlDll.Entry
        listentry = listentry^.Next

        module : ^IopModule = bldll^.FreeSpace

        IF module^.Initialize THEN
            status := module^.Initialize ( module )

            IF OsError ( status ) THEN
                KeCrash ( "Failed to initialize boot driver %s\n",
                    module^.Name^.String.Data )
            END
        END
    END
END

#LEAVESECTION