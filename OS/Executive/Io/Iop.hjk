//
// Private header file for the I/O (Io) component of the MINTIA Executive.
//

#INCLUDE "<ll>/Rtl.hjk"

#INCLUDE "<inc>/Iou.hjk"
#INCLUDE "<inc>/Psu.hjk"

#INCLUDE "<ll>/System/OsObject.hjk"

EXTERN FN IopInitPacketZones ()

EXTERN FN IopInitializeObjectRuntime ()

EXTERN FN IopInitializeCatalog ()

EXTERN IopFileType : ObuType

EXTERN IopFcbType : ObuType

// The location was allocated from a zone.

#DEFINE IOP_LOCATION_FROM_ZONE 1

// The location should not be freed.

#DEFINE IOP_LOCATION_DONT_FREE 2

ENUM IopPacketType : UBYTE
    IOP_PACKET_TYPE_NORMAL,
    IOP_PACKET_TYPE_USERASYNC,

    IOP_PACKET_TYPE_MAX,
END

// Don't free the trampoline.

#DEFINE IOP_TRAMPOLINE_DONT_FREE 2

#MACRO IopInitializeTreeNode ( node ) [
    RtlInitializeList ( &(node)^.PlaneNodeListHead )

    KeInitializeLock ( &(node)^.Lock )
]

STRUCT IopClass
    Entry : RtlListEntry,

    Properties : ExuDictionary,

    Module : ^IopModule,

// The remainder of the structure corresponds to a loaded instance of a class
// and is inert when the module is not loaded.

    Superclass : ^IopClass,

    DispatchTable : ^IoPacketBasedCallF,

    InstantiationCount : ULONG,
    SubclassCount : ULONG,

    DispatchTableSize : UINT,
END

#DEFINE IOP_MODULE_LOADING 1

STRUCT IopModule
    Path : ^ExName,
    Name : ^ExName,

    KnownClassListHead : RtlListEntry,

    Library : ^ExuLibrary,

    LoadAction : ExAction,

    Initialize : IoDriverInitialize,
    Uninitialize : IoDriverUninitialize,

    ClassReferences : ULONG,
END

EXTERN FN IopReferenceModule (
    IN module : ^IopModule,
)

EXTERN FN IopUnreferenceModule (
    IN module : ^IopModule,
)

EXTERN FN IopParseConfiguration (
    IN configtext : ^UBYTE,
    IN configsize : UWORD,
    OUT knownclass : ^IopClass,
) : OsStatus

EXTERN FN IopDeleteClassList (
    IN class : ^IopClass,
)

EXTERN FN IopSetClassProperty (
    IN class : ^IopClass,
    IN name : ^RtlString,
    IN value : ^RtlString,
    IN canupdate : UWORD,
) : OsStatus

EXTERN FN IopGetClassProperty (
    IN class : ^IopClass,
    IN name : ^RtlString,
) : ^RtlString

EXTERN FN IopCreateClass (
    OUT class : ^IopClass,
) : OsStatus

EXTERN FN IopDeleteClass (
    IN class : ^IopClass,
)