//
// Parses configuration files for loadable modules.
//

#INCLUDE "IopCatalog.hjk"

STRUCT IopParseContext
    Text : ^UBYTE,
    Size : UWORD,
    Index : UWORD,
    ClassListHead : RtlListEntry,
END

#MACRO IopIsWhitespace ( c ) [ ((c) == ' ' OR (c) == '\t' OR (c) == '\n') ]

#SECTION "PAGEtext"
FN IopConsumeWhitespace (
    IN parse : ^IopParseContext,
) : UWORD

    // Consume whitespace until the next non-whitespace character is
    // encountered. Returns TRUE if EOF was encountered. Also elides
    // line comments.

    comment := FALSE

    WHILE parse^.Index < parse^.Size DO
        c := parse^.Text[parse^.Index]

        IF comment THEN
            IF c == '\n' THEN
                // Comments continue until the end of the line.

                comment = FALSE
            END

        ELSEIF c == '#' THEN
            comment = TRUE

        ELSEIF NOT IopIsWhitespace ( c ) THEN
            RETURN TRUE
        END

        parse^.Index += 1
    END

    RETURN FALSE
END

#SECTION "PAGEtext"
FN IopConsumeToken (
    IN parse : ^IopParseContext,
    IN buffer : ^UBYTE,
    IN bufsize : UWORD,
    OUT tokenlength : UWORD,
) : UWORD

    // Consume a token into the buffer. Returns FALSE if EOF was encountered.

    IF NOT IopConsumeWhitespace ( parse ) THEN
        RETURN FALSE
    END

    tokenlength = 0

    // Make sure there's enough room for the null terminator.

    bufsize -= 1

    WHILE parse^.Index < parse^.Size DO
        c := parse^.Text[parse^.Index]

        IF IopIsWhitespace ( c ) THEN
            BREAK
        END

        IF tokenlength >= bufsize THEN
            RETURN FALSE
        END
        
        buffer[tokenlength] = c
        tokenlength += 1

        parse^.Index += 1
    END

    buffer[tokenlength] = 0

    RETURN TRUE
END

#SECTION "PAGEtext"
FN IopParseClass ( 
    IN parse : ^IopParseContext,
) : OsStatus

    // Parse a class definition.
    // This just consists of pairs of strings that end up as key-value pairs in
    // the properties dictionary.

    knownclass : ^IopKnownClass

    status := IopCreateKnownClass (
        OUT knownclass, // knownclass
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    name : RtlString
    value : RtlString

    namebuf : UBYTE[64]
    valuebuf : UBYTE[64]

    name.Data = &namebuf[0]
    value.Data = &valuebuf[0]

    WHILE TRUE DO
        IF NOT IopConsumeToken (
            parse, // parse
            &namebuf[0], // buffer
            64, // bufsize
            OUT name.Length, // tokenlength
        ) THEN

            status = OS_STATUS_SYNTAX_ERROR

            GOTO Exit
        END

        IF RtlCompareString ( &namebuf[0], "END" ) == 0 THEN
            BREAK
        END

        IF NOT IopConsumeToken (
            parse, // parse
            &valuebuf[0], // buffer
            64, // bufsize
            OUT value.Length, // tokenlength
        ) THEN

            status = OS_STATUS_SYNTAX_ERROR

            GOTO Exit
        END

        status = IopSetKnownClassProperty (
            knownclass, // knownclass
            &name, // name
            &value, // value
            FALSE, // canupdate
        )

        IF OsError ( status ) THEN
            GOTO Exit
        END
    END

    RtlInsertAtTailList (
        &parse^.ClassListHead, // head
        &knownclass^.Entry, // entry
    )

    status = OS_STATUS_SUCCESS

@Exit

    IF OsError ( status ) THEN
        IopDeleteKnownClass ( knownclass )
    END

    RETURN status
END

#SECTION "PAGEtext"
FN IopParseDefinition (
    IN parse : ^IopParseContext,
) : OsStatus

    // Parse a definition.

    buf : UBYTE[32]
    tokenlength : UWORD

    WHILE IopConsumeToken (
        parse, // parse
        &buf[0], // buffer
        32, // bufsize
        OUT tokenlength, // tokenlength
    ) DO

        status := OS_STATUS_SYNTAX_ERROR

        IF RtlCompareString ( &buf[0], "CLASS" ) == 0 THEN
            status = IopParseClass ( parse )
        END

        IF OsError ( status ) THEN
            RETURN status
        END
    END

    RETURN 0
END

#SECTION "PAGEtext"
FN IopParseConfiguration (
    IN configtext : ^UBYTE,
    IN configsize : UWORD,
    OUT knownclass : ^IopKnownClass,
) : OsStatus

    // Parse the given configuration file data and return a list of
    // IouKnownClass which represent the information found therein.

    parse : IopParseContext
    parse.Text = configtext
    parse.Size = configsize
    parse.Index = 0

    RtlInitializeList ( &parse.ClassListHead )

    WHILE TRUE DO
        status := IopParseDefinition ( &parse )

        IF OsError ( status ) THEN
            listhead := &parse.ClassListHead
            listentry := listhead^.Next

            WHILE listentry != listhead DO
                knownclass = CONTAINEROF listentry TO IopKnownClass.Entry
                listentry = listentry^.Next

                IopDeleteKnownClass ( knownclass )
            END

            RETURN status
        END

        IF status == 0 THEN
            BREAK
        END
    END

    knownclass = NULLPTR

    IF NOT RtlEmptyList ( &parse.ClassListHead ) THEN
        knownclass = CONTAINEROF parse.ClassListHead.Next TO IopKnownClass.Entry
    END

    RETURN OS_STATUS_SUCCESS
END