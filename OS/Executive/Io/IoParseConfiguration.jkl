//
// Parses configuration files for loadable modules.
//

#INCLUDE "Iop.hjk"

STRUCT IopParseContext
    Text : ^UBYTE,
    Size : UWORD,
    Index : UWORD,
    ClassListHead : ^IopClass,
END

#MACRO IopIsWhitespace ( c ) [ ((c) == ' ' OR (c) == '\t' OR (c) == '\n') ]

#SECTION "PAGEtext"
FN IopConsumeWhitespace (
    IN parse : ^IopParseContext,
) : UWORD

    // Consume whitespace until the next non-whitespace character is
    // encountered. Returns TRUE if EOF was encountered. Also elides
    // line comments.

    comment := FALSE

    WHILE parse^.Index < parse^.Size DO
        c := parse^.Text[parse^.Index]

        IF comment THEN
            IF c == '\n' THEN
                // Comments continue until the end of the line.

                comment = FALSE
            END

        ELSEIF c == '#' THEN
            comment = TRUE

        ELSEIF NOT IopIsWhitespace ( c ) THEN
            RETURN TRUE
        END

        parse^.Index += 1
    END

    RETURN FALSE
END

#SECTION "PAGEtext"
FN IopConsumeToken (
    IN parse : ^IopParseContext,
    IN buffer : ^UBYTE,
    IN bufsize : UWORD,
    OUT tokenlength : UWORD,
) : UWORD

    // Consume a token into the buffer. Returns FALSE if EOF was encountered.

    IF NOT IopConsumeWhitespace ( parse ) THEN
        RETURN FALSE
    END

    tokenlength = 0

    // Make sure there's enough room for the null terminator.

    bufsize -= 1

    WHILE parse^.Index < parse^.Size DO
        c := parse^.Text[parse^.Index]

        IF IopIsWhitespace ( c ) THEN
            BREAK
        END

        IF tokenlength >= bufsize THEN
            RETURN FALSE
        END
        
        buffer[tokenlength] = c
        tokenlength += 1

        parse^.Index += 1
    END

    buffer[tokenlength] = 0

    RETURN TRUE
END

#SECTION "PAGEtext"
FN IopParseClass ( 
    IN parse : ^IopParseContext,
) : OsStatus

    // Parse a class definition.
    // This just consists of pairs of strings that end up as key-value pairs in
    // the properties dictionary.

    status := IopCreateClass (
        OUT: class, // class
    )

    IF OsError ( status ) THEN
        RETURN status
    END

    name : RtlString
    value : RtlString

    namebuf : UBYTE[64]
    valuebuf : UBYTE[64]

    name.Data = &namebuf[0]
    value.Data = &valuebuf[0]

    WHILE TRUE DO
        IF NOT IopConsumeToken (
            parse, // parse
            &namebuf[0], // buffer
            64, // bufsize
            OUT name.Length, // tokenlength
        ) THEN

            status = OS_STATUS_SYNTAX_ERROR

            GOTO Exit
        END

        IF RtlCompareString ( &namebuf[0], "END" ) == 0 THEN
            BREAK
        END

        IF NOT IopConsumeToken (
            parse, // parse
            &valuebuf[0], // buffer
            64, // bufsize
            OUT value.Length, // tokenlength
        ) THEN

            status = OS_STATUS_SYNTAX_ERROR

            GOTO Exit
        END

        status = IopSetClassProperty (
            class, // class
            &name, // name
            &value, // value
            FALSE, // canupdate
        )

        IF OsError ( status ) THEN
            GOTO Exit
        END
    END

    class^.Entry.Next = CAST parse^.ClassListHead TO ^VOID
    parse^.ClassListHead = class

    status = OS_STATUS_SUCCESS

@Exit

    IF OsError ( status ) THEN
        IopDeleteClass ( class )
    END

    RETURN status
END

#SECTION "PAGEtext"
FN IopParseDefinition (
    IN parse : ^IopParseContext,
) : OsStatus

    // Parse a definition.

    buf : UBYTE[32]

    WHILE IopConsumeToken (
        parse, // parse
        &buf[0], // buffer
        32, // bufsize
        OUT: tokenlength, // tokenlength
    ) DO

        status := OS_STATUS_SYNTAX_ERROR

        IF RtlCompareString ( &buf[0], "CLASS" ) == 0 THEN
            status = IopParseClass ( parse )
        END

        IF OsError ( status ) THEN
            RETURN status
        END
    END

    RETURN 0
END

#SECTION "PAGEtext"
FN IopDeleteClassList (
    IN class : ^IopClass,
)

    // Delete a list of classes produced by IopParseConfiguration.

    WHILE class DO
        next := CAST class^.Entry.Next TO ^IopClass

        IopDeleteClass ( class )

        class = next 
    END
END

#SECTION "PAGEtext"
FN IopParseConfiguration (
    IN configtext : ^UBYTE,
    IN configsize : UWORD,
    OUT knownclass : ^IopClass,
) : OsStatus

    // Parse the given configuration file data and return a list of
    // IopClass which represent the information found therein.

    parse : IopParseContext
    parse.Text = configtext
    parse.Size = configsize
    parse.Index = 0
    parse.ClassListHead = NULLPTR

    WHILE TRUE DO
        status := IopParseDefinition ( &parse )

        IF OsError ( status ) THEN
            IopDeleteClassList ( parse.ClassListHead )

            RETURN status
        END

        IF status == 0 THEN
            BREAK
        END
    END

    knownclass = parse.ClassListHead

    RETURN OS_STATUS_SUCCESS
END