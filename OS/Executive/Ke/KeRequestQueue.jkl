//
// Implements a request queue. Intended for device drivers to save duplication
// on cancellation state machine logic.
//
// Enables a simple form of request flow control by giving each request a "cost"
// representing how many of some driver-specific resource it will consume to
// start, and each queue has a "maximum" representing how many such resources
// are available. New requests will be started automatically as resources become
// available due to cancellation and completion of previously started requests.
//
// The driver is expected to provide its own locking, and its own book-keeping
// for things like enumerating started requests (if needed) and also lifetime
// guarantees for the queue and its requests.
//
// Supports three request sorting policies:
//
//  KE_REQUEST_ORDER_FIFO: O(1)
//                         Requests are processed in insertion order.
//                         (Example: a named pipe or teletype).
//
//                         Keep in mind that if requests ever have a cost above
//                         1, an expensive request at the head can block cheaper
//                         requests behind it because the FIFO queue will not be
//                         scanned.
//
//  KE_REQUEST_ORDER_INCREASING: O(log n)
//                         Requests are processed in increasing order of an
//                         opaque key value. Requests with lower key values are
//                         only started when all requests with increasing keys
//                         have been exhausted. (Example: spinning rust disk
//                         drivers, where key = LBA).
//
//  KE_REQUEST_ORDER_MINIMUM: O(log n)
//                         Requests are started minimum key first. (Example:
//                         NVMe controller driver, where key = cost = number of
//                         submission queue entries).
//

#INCLUDE "Kep.hjk"

EXPORT FN KeInitializeRequestQueue (
    IN queue : ^KeRequestQueue,
    IN sortpolicy : UWORD,
    IN startfunc : KeRequestStartF,
    IN completefunc : KeRequestCompleteF,
    IN maximum : UWORD,
)

    // Initialize a request queue.

    IF sortpolicy == KE_REQUEST_ORDER_FIFO THEN
        // Initialize the linked list.

        RtlInitializeList ( &queue^.Head.List )

    ELSE
        // Initialize the roots of the pairing heaps.

        queue^.Head.Sorted.Roots[0] = NULLPTR
        queue^.Head.Sorted.Roots[1] = NULLPTR
        queue^.CurrentQueueIndex = 0
    END

    queue^.SortPolicy = sortpolicy
    queue^.Current = 0
    queue^.Maximum = maximum
    queue^.StartFunction = startfunc
    queue^.CompleteFunction = completefunc
END

FN (RtlLessThanF) KepCompareRequests (
    IN a : ^RtlHeapEntry,
    IN b : ^RtlHeapEntry,
) : UWORD

    request1 := CONTAINEROF a TO KeRequestEntry.Entry.Sorted
    request2 := CONTAINEROF b TO KeRequestEntry.Entry.Sorted

    RETURN request1^.SortKey < request2^.SortKey
END

EXPORT FN KeInsertRequestQueue (
    IN queue : ^KeRequestQueue,
    IN request : ^KeRequestEntry,
)

    // Insert a request into the queue, and start it if possible.

    IF request^.Status == KEP_REQUEST_CANCELLED THEN
        // Already cancelled between being published to cancellation and being
        // inserted, which completely nullifies the request as far as this queue
        // is concerned. It should just be ignored.

        LEAVE
    END

    IF queue^.Current + request^.Cost <= queue^.Maximum THEN
        // Not busy, set it busy.

        queue^.Current += request^.Cost
        queue^.Pivot = request^.SortKey

        // Start the request.

        request^.Status = KEP_REQUEST_CURRENT

        queue^.StartFunction ( request )

        LEAVE
    END

    // The queue is busy so insert the request for deferred processing.

    sortpolicy := queue^.SortPolicy

    IF sortpolicy != KE_REQUEST_ORDER_FIFO THEN
        // This is a sorted request queue.

        current := queue^.CurrentQueueIndex

        IF sortpolicy == KE_REQUEST_ORDER_INCREASING THEN
            IF request^.SortKey <= queue^.Pivot THEN
                // We are currently processing entries with a key larger than
                // the current pivot. Since we're less or equal, toggle the
                // index to insert us into the "next" queue. (This is an XOR.)

                current $= 1
            END

            // Save which heap we stored it in.

            request^.HeapIndex = current
        END

        RtlInsertIntoHeap (
            &KepCompareRequests, // comparisonfunc
            &queue^.Head.Sorted.Roots[current], // rootptr
            &request^.Entry.Sorted, // entry
        )

    ELSE
        // This is a non-sorted request queue.

        // The queue is busy, so insert the request at the tail of the list.

        RtlInsertAtTailList (
            &queue^.Head.List, // head
            &request^.Entry.List, // entry
        )
    END

    // Set inserted.

    request^.Status = KEP_REQUEST_ENQUEUED
END

EXPORT FN KepStartRequests (
    IN queue : ^KeRequestQueue,
)

    // Start requests from the queue until the maximum cost is reached.

    sortpolicy := queue^.SortPolicy

@Again

    request : ^KeRequestEntry = NULLPTR

    IF sortpolicy == KE_REQUEST_ORDER_FIFO THEN
        // Check the FIFO queue.

        IF NOT RtlEmptyList ( &queue^.Head.List ) THEN
            request =
                CONTAINEROF queue^.Head.List.Next TO KeRequestEntry.Entry.List
        END

    ELSE
        // Check the current queue.

        current := queue^.CurrentQueueIndex

        root := queue^.Head.Sorted.Roots[current]

        IF root THEN
            request = CONTAINEROF root TO KeRequestEntry.Entry.Sorted

        ELSEIF sortpolicy == KE_REQUEST_ORDER_INCREASING THEN
            // None in current queue. Switch queues and check the other one.

            current $= 1

            queue^.CurrentQueueIndex = current

            root = queue^.Head.Sorted.Roots[current]

            IF root THEN
                request = CONTAINEROF root TO KeRequestEntry.Entry.Sorted
            END
        END
    END

    IF NOT request OR
        queue^.Current + request^.Cost > queue^.Maximum THEN

        // No next request or it would be too expensive.

        LEAVE
    END

    IF queue^.SortPolicy == KE_REQUEST_ORDER_FIFO THEN
        // Remove from FIFO list.

        RtlRemoveEntryList ( &request^.Entry.List )

    ELSE
        // Remove from heap.

        RtlRemoveFromHeap (
            &KepCompareRequests, // comparisonfunc
            &queue^.Head.Sorted.Roots[request^.HeapIndex], // rootptr
            &request^.Entry.Sorted, // entry
        )
    END

    // Start the next request.

    queue^.Current += request^.Cost
    queue^.Pivot = request^.SortKey

    request^.Status = KEP_REQUEST_CURRENT

    queue^.StartFunction ( request )

    // Find another one.

    GOTO Again
END

EXPORT FN KeCompleteRequestQueue (
    IN queue : ^KeRequestQueue,
    IN request : ^KeRequestEntry,
) : UWORD

    // Complete the given request (if it hasn't already been cancelled) and
    // start any that can now be started. Returns TRUE if completed, FALSE
    // otherwise.

    KeAssert ( (request^.Status == KEP_REQUEST_CURRENT) OR
        (request^.Status == KEP_REQUEST_CANCELLED) )

    IF request^.Status != KEP_REQUEST_CURRENT THEN
        RETURN FALSE
    END

    // Set as completed.

    request^.Status = KEP_REQUEST_COMPLETED

    queue^.Current -= request^.Cost

    // Invoke callback to free up any structures associated with this
    // entry's cost.

    queue^.CompleteFunction (
        request, // request
        FALSE, // cancelled
    )

    // Try to start any requests that can be started.

    KepStartRequests ( queue )

    RETURN TRUE
END

EXPORT FN KeCancelRequestQueue (
    IN queue : ^KeRequestQueue,
    IN request : ^KeRequestEntry,
) : UWORD

    // Cancel the given request. Returns TRUE if cancelled, FALSE otherwise.

    status := request^.Status

    IF status == KEP_REQUEST_COMPLETED OR
        status == KEP_REQUEST_CANCELLED THEN

        RETURN FALSE
    END

    // Hasn't been completed yet, which means its still cancellable.

    request^.Status = KEP_REQUEST_CANCELLED

    IF status == KEP_REQUEST_NONE THEN
        // The request was published to cancellation, then cancelled, before
        // the driver had a chance to actually enqueue or start it. So there's
        // nothing left to do.

        RETURN TRUE

    ELSEIF status == KEP_REQUEST_ENQUEUED THEN
        // It was enqueued, so we have to remove it from the queue
        // structure.

        IF queue^.SortPolicy == KE_REQUEST_ORDER_FIFO THEN
            // Remove from the FIFO list.

            RtlRemoveEntryList ( &request^.Entry.List )

        ELSE
            // Remove from the appropriate min heap.

            RtlRemoveFromHeap (
                &KepCompareRequests, // comparisonfunc
                &queue^.Head.Sorted.Roots[request^.HeapIndex], // rootptr
                &request^.Entry.Sorted, // entry
            )
        END

        // It's possible this unblocked a cheaper request, so try to start one.

        KepStartRequests ( queue )

        RETURN TRUE
    END

    KeAssert ( status == KEP_REQUEST_CURRENT )

    // The request is current, so the callback needs to be invoked to allow
    // the driver to do whatever is necessary.
    //
    // This callback returns a value indicating whether new requests can be
    // immediately started. If not, then the driver promises to call
    // KeFinishCancelRequestQueue later on the request in order to remove its
    // cost and allow more requests to be started.

    IF queue^.CompleteFunction (
        request, // request
        TRUE, // cancelled
    ) THEN

        // Try to start any requests that can be started.

        queue^.Current -= request^.Cost

        KepStartRequests ( queue )
    END

    RETURN TRUE
END

EXPORT FN KeFinishCancelRequestQueue (
    IN queue : ^KeRequestQueue,
    IN request : ^KeRequestEntry,
)

    // Finish cancelling the given request. This just decrements the current
    // cost and attempts to start more requests.

    KeAssert ( request^.Status == KEP_REQUEST_CANCELLED )

    queue^.Current -= request^.Cost

    KepStartRequests ( queue )
END
