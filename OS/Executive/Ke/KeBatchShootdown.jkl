//
// Per-process & per-cpu batched TB shootdown mechanisms.
// Also used to shoot down system space.
//

#IF BLD_MP

#INCLUDE "Kep.hjk"

FN KeuFlushShootdowns (
    IN process : ^KeuProcess,
)

    // Flush all of the pending batched shootdowns on this process.

    // Take the shootdown lock to avoid others redundantly doing the same work.
    // We take it unconditionally even if there are no pending flushes so that
    // if we are a high priority thread depending on a low priority thread to
    // do flushes, it inherits our priority, and we wait for it to finish.

    state := process^.BatchedShootdownState

    ipl := KeAcquireLockExclusiveRaise ( &state^.FlushShootdownLock )

    IF NOT state^.HasPendingFlushes THEN
        KeReleaseLockLower ( &state^.FlushShootdownLock, ipl )

        LEAVE
    END

    state^.HasPendingFlushes = FALSE

    // Flush HasPendingFlushes flag before swapping shootdown tables.

    KeWriteMemoryBarrier ()

    // Before doing the shootdown, swap the active shootdown table and the
    // alternate shootdown table. This will give us a copy that is guaranteed
    // not to have any new shootdowns enqueued to it in the future.

    table := state^.BatchedShootdowns
    alttable := state^.AlternateBatchedShootdowns

    state^.BatchedShootdowns = alttable
    state^.AlternateBatchedShootdowns = table

    // Acquire all per-cpu locks in order to serialize behind all ongoing
    // enqueues to this table.

    i := 0
    procs := KeQueryMostProcessorsInAnyNode ()

    WHILE i < procs DO
        KeAcquireLockExclusive ( &table[i].Lock )
        KeReleaseLock ( &table[i].Lock )

        i += 1
    END

    // Do a global synchronous TB shootdown of all of the processors that this
    // process has run on. Keep global mappings if this is not a system
    // process.

    KeuSweepTb (
        &state^.ProcessorMask, // processormask
        NOT state^.SystemSpace, // keepglobal
    )

    // Process all of the batched ranges.

    i = 0

    WHILE i < procs DO
        percpu := &table[i]

        index := percpu^.Index

        IF index THEN
            percpu^.Index = 0
            j := 0

            WHILE j < index DO
                percpu^.Table[j].Callback (
                    process, // process
                    percpu^.Table[j].Context, // context
                    percpu^.Table[j].Ptr, // ptr
                    percpu^.Table[j].Pages, // pages
                )

                j += 1
            END
        END

        i += 1
    END

    KeReleaseLockLower ( &state^.FlushShootdownLock, ipl )
END

FN KeuBatchShootdown (
    IN process : ^KeuProcess,
    IN context : ^VOID,
    IN ptr : ^VOID,
    IN pages : UWORD,
    IN callback : KeuAfterShootdownF,
    IN canflush : UWORD,
) : UWORD

    // Add the callback to the next batch.

    state := process^.BatchedShootdownState

@Retry

    cpuid := KeCurrentNodeLocalProcessorId ()

    shootdownstate := state^.BatchedShootdowns
    percpu := &shootdownstate[cpuid]

    ipl := KeAcquireLockExclusiveRaise ( &percpu^.Lock )

    IF shootdownstate != state^.BatchedShootdowns THEN
        // We raced with a flush which swapped the shootdown states. Reload the
        // pointer, since we shouldn't enqueue anything new to this one.

        KeReleaseLockLower ( &percpu^.Lock, ipl )

        GOTO Retry
    END

    // Try to coalesce with the last entered shootdown.

    index := percpu^.Index
    entry : ^KepBatchedShootdown

    IF index != 0 THEN
        entry = &percpu^.Table[index - 1]

        IF entry^.Callback == callback AND
            entry^.Context == context AND
            ((entry^.Ptr + (entry^.Pages << RTL_PAGE_SHIFT) == ptr) OR
            (ptr + (pages << RTL_PAGE_SHIFT) == entry^.Ptr)) THEN

            // This shootdown is directly contiguous with the last one that
            // was inserted and has the same callback and context. So we
            // can just extend the last one.

            entry^.Pages += pages

            IF ptr < entry^.Ptr THEN
                entry^.Ptr = ptr
            END

            KeReleaseLockLower ( &percpu^.Lock, ipl )

            RETURN TRUE
        END
    END

    // Nope, add a new entry.

    IF index >= KEP_MAXIMUM_SHOOTDOWN_BATCH THEN
        // The batch is full, do it immediately.

        KeReleaseLockLower ( &percpu^.Lock, ipl )

        IF canflush THEN
            KeuFlushShootdowns ( process )

            callback (
                process, // process
                context, // context
                ptr, // ptr
                pages, // pages
            )
        END

        RETURN canflush
    END

    entry = &percpu^.Table[index]

    entry^.Ptr = ptr
    entry^.Pages = pages
    entry^.Callback = callback
    entry^.Context = context

    percpu^.Index = index + 1

    IF NOT state^.HasPendingFlushes THEN
        // Indicate that something productive is to be gained by doing a flush.
        // We don't just unconditionally set this to TRUE because it would
        // cause its cache line to aggressively migrate around, so we check
        // if it's FALSE first.

        // Setting this to TRUE is intentionally not guarded by any lock in
        // particular, but we place it before the release below in order to get
        // caught by its release barrier.

        state^.HasPendingFlushes = TRUE
    END

    KeReleaseLockLower ( &percpu^.Lock, ipl )

    RETURN TRUE
END

#SECTION "PAGEtext"
FN KeuSizeOfProcessShootdownState () : UWORD

    // Calculate and return the size of the shootdown state for a process.

    bytes := SIZEOF KepBatchedShootdownState
    bytes +=
        SIZEOF KepBatchedShootdownPerCpu * KeQueryMostProcessorsInAnyNode ()

    RETURN bytes
END

#SECTION "PAGEtext"
FN KepInitializeBatchedShootdownState (
    IN state : ^KepBatchedShootdownState,
    IN systemspace : UWORD,
)

    // Initialize batched shootdown state. Assumes there's room for the
    // per-cpu tables after the main state structure.

    state^.BatchedShootdowns =
        CAST (state + SIZEOF KepBatchedShootdownState) TO ^VOID

    state^.AlternateBatchedShootdowns =
        CAST (state^.BatchedShootdowns + KeQueryMostProcessorsInAnyNode () *
        SIZEOF KepBatchedShootdownPerCpu) TO ^VOID

    state^.HasPendingFlushes = FALSE

    IF systemspace THEN
        // Set all shootdown target bits since this is used for shooting down
        // system space.

        KepSetProcessorMask ( &state^.ProcessorMask )
        state^.SystemSpace = TRUE

    ELSE
        // Clear all shootdown target bits since this is a normal user process.
        // They'll get set as threads from this process run on the various
        // processors.

        KepClearProcessorMask ( &state^.ProcessorMask )
        state^.SystemSpace = FALSE
    END

    KeInitializeLock ( &state^.FlushShootdownLock, "FlushShootdowns" )

    i := 0
    max := KeQueryMostProcessorsInAnyNode ()

    WHILE i < 2 DO
        table : ^KepBatchedShootdownPerCpu

        IF i == 0 THEN
            table = state^.BatchedShootdowns
        ELSE
            table = state^.AlternateBatchedShootdowns
        END

        j := 0

        WHILE j < max DO
            // Reset each per-cpu batched shootdown table.

            table[j].Index = 0

            KeInitializeLock ( &table[j].Lock, "BatchShootdownPerCpu" )

            j += 1
        END

        i += 1
    END
END

#END