//
// Implements support for Balanced Queue kernel objects.
//
// These are queues into which items can be inserted and removed.
// There is integration with the dispatcher so that when a thread which is
// dealing with a balanced queue item blocks, another thread is awoken to take
// its place; likewise, when a thread attempts to grab a balanced queue item and
// the maximum number of threads are already running, it will block. This is to
// prevent the processors from being oversubscribed with worker threads.
//

#INCLUDE "Kep.hjk"

#IF BLD_MP

#MACRO KepAcquireThreadList ( kepnode ) [
    KepAcquireSpinlockRaise ( &(kepnode)^.BalancedQueueThreadListLock )
]

#MACRO KepReleaseThreadList ( kepnode, oldipl ) [
    KepReleaseSpinlockLower (
        &(kepnode)^.BalancedQueueThreadListLock, // spinlock
        oldipl, // oldipl
    )
]

#MACRO KepAcquireThreadListElevated ( kepnode ) [
    KepAcquireSpinlock ( &(kepnode)^.BalancedQueueThreadListLock )
]

#MACRO KepReleaseThreadListElevated ( kepnode ) [
    KepReleaseSpinlock ( &(kepnode)^.BalancedQueueThreadListLock )
]

#ELSE

#MACRO KepAcquireThreadList ( kepnode ) [
    KepRaiseIpl ( KEP_IPL_DPC )
]

#MACRO KepReleaseThreadList ( kepnode, ipl ) [
    KepLowerIpl ( ipl )
]

#MACRO KepAcquireThreadListElevated ( kepnode ) []

#MACRO KepReleaseThreadListElevated ( kepnode ) []

#END

FN KepWakeBalancedQueue (
    IN queue : ^KeBalancedQueue,
)

    // A thread associated with this queue has disassociated from it, or is
    // going to sleep. See if we should wake up another thread.

    KepAcquireObjectElevated ( &queue^.Header.Header )

    oldcount := KeIncrementUlongMp (
        &queue^.ActiveThreadCount, // ptr
        0xFFFFFFFF, // inc
    )

    KeAssert ( oldcount != 0 )

    IF oldcount <= queue^.MaximumThreadCount AND
        queue^.Header.WaiterCount AND
        NOT RtlEmptyList ( &queue^.ItemListHead ) THEN

        // There are more threads remaining, there are threads waiting, and
        // there's at least one item to process, so unblock someone and get
        // him going on it.

        // We wake them with a status of OS_STATUS_KERNEL_APC so that they
        // repeat the wait loop, which will hopefully cause them to pick up this
        // item. If someone else steals it, they'll adjust their timeout and go
        // back to sleep.

        KepSatisfyQueuedObject (
            &queue^.Header, // object
            0, // priorityboost
            FALSE, // all
            OS_STATUS_KERNEL_APC, // status
        )
    END

    KepReleaseObjectElevated ( &queue^.Header.Header )
END

FN KepDisassociateFromBalancedQueue (
    IN thread : ^KeuThread,
)

    // Disassociate the thread from the balanced queue it takes items from.

    oldqueue := thread^.BalancedQueue

    IF NOT oldqueue THEN
        LEAVE
    END

    kepnode := KeNumaNodeFromSpacePointer ( oldqueue )^.Kep

    KepAcquireThreadListElevated ( kepnode )

    // Before we acquired the thread list lock, we might have gotten
    // removed from the old queue, so check that we're still associated.

    IF thread^.BalancedQueue THEN
        RtlRemoveEntryList ( &thread^.BalancedQueueEntry )

        KepWakeBalancedQueue ( thread^.BalancedQueue )

        thread^.BalancedQueue = NULLPTR
    END

    KepReleaseThreadListElevated ( kepnode )
END

FN (KepShouldSatisfyF) KepSatisfyBalancedQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN argument : ^VOID,
) : UWORD

    // Immediately satisfy a wait on a balanced queue when it is signaled (which
    // means there is at least one item in it) and the active count is less or
    // equal to the maximum count.

    queue := CAST object TO ^KeBalancedQueue

    RETURN queue^.Header.SignalCount AND
        queue^.ActiveThreadCount <= queue^.MaximumThreadCount
END

FN (KepAbortSatisfyF) KepAbortSatisfyBalancedQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN argument : ^VOID,
)

    // Satisfaction was aborted after we initially permitted it. Balanced queue
    // doesn't have anything to do here.

    NOTHING
END

FN (KepConsumeF) KepConsumeBalancedQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN argument : ^VOID,
)

    // When a balanced queue satisfied the thread's wait, that consumes a signal
    // count and a queue item.

    queue := CAST object TO ^KeBalancedQueue

    queue^.Header.SignalCount -= 1

    // Grab the item.

    item := queue^.ItemListHead.Next

    // Return the item.

    NOTHING (CAST argument TO ^^RtlListEntry)^ = item

    // Remove it from the list.

    RtlRemoveEntryList ( item )
END

FN (KepEnqueueF) KepEnqueueBalancedQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN waitblock : ^KepWaitBlock,
) : UWORD

    // Insert thread at head so that worker threads are scheduled in a LIFO
    // order, which promotes cache locality.

    queue := CAST object TO ^KeBalancedQueue

    RtlInsertAtHeadList (
        &queue^.Header.WaitListHead, // head
        &waitblock^.Links.List, // entry
    )

    KeAssert ( queue^.Header.WaiterCount != 0xFFFFFFFF )

    queue^.Header.WaiterCount += 1

    RETURN 0
END

#SECTION "text"
KepBalancedQueueType : KepDispatchObjectType = {
    [ShouldSatisfy] = &KepSatisfyBalancedQueue,
    [AbortSatisfy] = &KepAbortSatisfyBalancedQueue,
    [Consume] = &KepConsumeBalancedQueue,
    [Enqueue] = &KepEnqueueBalancedQueue,
    [Dequeue] = &KepDequeueWait,
}

EXPORT FN KeInitializeBalancedQueue (
    IN queue : ^KeBalancedQueue,
    IN name : ^UBYTE,
    IN maxthreads : UWORD,
)

    // Initialize a Balanced Queue object.
    // These have a dispatch header, but it should *never* be waited on
    // directly, only KeRemoveFromBalancedQueue should be used.

    KepInitializeQueuedDispatchObject (
        &queue^.Header, // header
        name, // name
        &KepBalancedQueueType, // type
    )

    queue^.Header.SignalCount = 0

    RtlInitializeList ( &queue^.ItemListHead )
    RtlInitializeList ( &queue^.ThreadListHead )

    queue^.ActiveThreadCount = 0

    // If a maximum number of active threads was specified, use that. Otherwise,
    // default to the number of processors in the system.

    IF maxthreads THEN
        queue^.MaximumThreadCount = maxthreads

    ELSE
        queue^.MaximumThreadCount = KeQueryMostProcessorsInAnyNode ()
    END
END

EXPORT FN KeInsertIntoBalancedQueue (
    IN queue : ^KeBalancedQueue,
    IN item : ^RtlListEntry,
    IN head : UWORD,
    IN priorityboost : UWORD,
)

    // Insert an item into the balanced queue at either the head or the tail.

    // Acquire the object spinlock.

    ipl := KepAcquireObject ( &queue^.Header.Header )

    IF queue^.Header.WaiterCount AND
        queue^.ActiveThreadCount < queue^.MaximumThreadCount THEN

        // Satisfy a wait. This may fail to wake anyone.
        // We wake them with a status of OS_STATUS_KERNEL_APC so that they
        // repeat the wait loop, which will hopefully cause them to pick up this
        // item. If someone else steals it, they'll adjust their timeout and go
        // back to sleep.

        KepSatisfyQueuedObject (
            &queue^.Header, // object
            priorityboost, // priorityboost
            FALSE, // all
            OS_STATUS_KERNEL_APC, // status
        )
    END

    // Insert the item into the queue.

    IF head THEN
        RtlInsertAtHeadList (
            &queue^.ItemListHead, // head
            item, // entry
        )

    ELSE
        RtlInsertAtTailList (
            &queue^.ItemListHead, // head
            item, // entry
        )
    END

    queue^.Header.SignalCount += 1

    KepReleaseObject ( &queue^.Header.Header, ipl )
END

EXPORT FN KeRemoveFromBalancedQueue (
    IN queue : ^KeBalancedQueue,
    IN waitmode : UWORD,
    IN alertable : UWORD,
    IN timeout : ^RtlUquad,
    OUT item : ^RtlListEntry,
) : OsStatus

    // Remove an item from the balanced queue. If there are too many threads, or
    // there are no items to remove, we block. 

    thread := KeCurrentThread ()

    // Not allowed in an APC because the associated balanced queue can conflict
    // between APC context and normal context.

    KeAssert ( NOT thread^.ExecutingKapc )

    ipl := KepRaiseIpl ( KEP_IPL_DPC )

    oldqueue := thread^.BalancedQueue

    IF oldqueue != queue THEN
        // Associate the thread with this queue.
        // Note that this queue will not be ran down while we're trying to
        // remove an item, because the Executive is holding a reference to the
        // associated object.

        KepDisassociateFromBalancedQueue ( thread )

        thread^.BalancedQueue = queue

        kepnode := KeNumaNodeFromSpacePointer ( queue )^.Kep

        KepAcquireThreadListElevated ( kepnode )

        RtlInsertAtTailList (
            &queue^.ThreadListHead, // head
            &thread^.BalancedQueueEntry, // entry
        )

        KepReleaseThreadListElevated ( kepnode )

        KeIncrementUlongMp (
            &queue^.ActiveThreadCount, // ptr
            1, // inc
        )
    END

    // The thread is now definitely associated with this queue, and won't become
    // disassociated from it for the duration of this operation as the owner of
    // the queue object has guaranteed its lifetime (for example with an object
    // manager reference).

    IF NOT RtlEmptyList ( &queue^.ItemListHead ) AND
        queue^.ActiveThreadCount <= queue^.MaximumThreadCount THEN

        // Make a quick check for an entry before trying to wait.

        KepAcquireObjectElevated ( &queue^.Header.Header )

        IF NOT RtlEmptyList ( &queue^.ItemListHead ) AND
            queue^.ActiveThreadCount <= queue^.MaximumThreadCount THEN

            // Got one.

            item = queue^.ItemListHead.Next

            RtlRemoveEntryList ( item )

            KeAssert ( queue^.Header.SignalCount != 0 )

            queue^.Header.SignalCount -= 1

            KepReleaseObject ( &queue^.Header.Header, ipl )

            RETURN OS_STATUS_SUCCESS
        END

        KepReleaseObjectElevated ( &queue^.Header.Header )
    END

    KepLowerIpl ( ipl )

    queueitem : ^RtlListEntry[1]

    status := KeWaitForSingleObject (
        waitmode, // waitmode
        alertable, // alertable
        timeout, // timeout
        queue, // object
        &queueitem[0], // argument
        NULLPTR, // continuation
    )

    IF status == 0 THEN
        // Got an item.

        item = queueitem[0]

        status = OS_STATUS_SUCCESS
    END

    RETURN status
END

FN KeuRundownBalancedQueue (
    IN queue : ^KeBalancedQueue,
)

    // Uninitialize a balanced queue. Nobody can be waiting on it since that
    // would imply a reference, and as it is being deleted, there must be zero
    // references. We have to disassociate all threads from this queue.

    kepnode := KeNumaNodeFromSpacePointer ( queue )^.Kep

    ipl := KepAcquireThreadList ( kepnode )

    head := &queue^.ThreadListHead
    listentry := head^.Next

    WHILE listentry != head DO
        thread := CONTAINEROF listentry TO KeuThread.BalancedQueueEntry

        // No need to remove the thread's list entry, just setting the queue
        // pointer to NULLPTR is sufficient.

        // Acquire thread lock to protect queue lifetime from its perspective.

        KepAcquireThreadElevated ( thread )

        thread^.BalancedQueue = NULLPTR

        KepReleaseThreadElevated ( thread )

        listentry = listentry^.Next
    END

    KepReleaseThreadList ( kepnode, ipl )
END