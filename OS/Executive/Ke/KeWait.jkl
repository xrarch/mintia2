//
// Implements waiting for threads for the MINTIA Kernel.
//

#INCLUDE "Kep.hjk"

#INCLUDE "<ll>/System/OsStatus.hjk"
#INCLUDE "<ll>/System/OsSignal.hjk"

#DEFINE KEP_WB_DEQUEUED 2

#MACRO KepDequeueWaitBlock ( object, waitblock ) [
    object = (waitblock)^.Object

    // Acquire the object lock.

    KepAcquireObjectElevated ( object )

    IF (waitblock)^.Flags & KEP_WB_DEQUEUED == 0 THEN
        // Remove the wait block.

        RtlRemoveEntryList ( &(waitblock)^.Entry )

        // Decrement waiter count, since this wait block wasn't
        // satisfied yet.

        KeAssert ( object^.WaiterCount != 0 )

        object^.WaiterCount -= 1
    END

    // Release the object lock.

    KepReleaseObjectElevated ( object )
]

#IF BLD_MP

FN KepTryCompleteWait (
    IN thread : ^KeuThread,
    IN waitstatus : UWORD,
) : UWORD

    // Try to complete the thread's wait by CAS'ing our wait status in.
    // This will fail if somebody else raced us to it.
    // Return TRUE if we completed the wait, FALSE otherwise.

    oldstatus := thread^.WaitStatus

    WHILE TRUE DO
        IF oldstatus != OS_STATUS_WAIT_PLACEHOLDER THEN
            // Somebody else woke the thread and is responsible for
            // unwaiting it.

            RETURN FALSE
        END

        IF KeCompareSwapUlong (
            &thread^.WaitStatus, // ptr
            waitstatus, // newvalue
            OS_STATUS_WAIT_PLACEHOLDER, // expectedvalue
        ) == oldstatus THEN

            RETURN TRUE
        END

        oldstatus = thread^.WaitStatus
    END
END

#ELSE

FN KepTryCompleteWait (
    IN thread : ^KeuThread,
    IN waitstatus : UWORD,
) : UWORD

    IF thread^.WaitStatus == OS_STATUS_WAIT_PLACEHOLDER THEN
        thread^.WaitStatus = waitstatus

        RETURN TRUE
    END

    RETURN FALSE
END

#END

#MACRO KepWaitTail ( waitblock, count, object, thread ) [
    // Macro containing wait-end processing code executed in the context of the
    // awoken thread, common to both the continuation and non-continuation case.

    // We're back! Thread lock is dropped, but we're still at KEP_IPL_DPC.

    // All of our wait blocks have been marked UNWAITED, but may not have been
    // dequeued, so we have to do that now.

    waitblock = thread^.WaitBlockTable
    count = thread^.WaitCount

    WHILE count DO
        KepDequeueWaitBlock ( object, waitblock )

        count -= 1
        waitblock += SIZEOF KepWaitBlock
    END

    IF thread^.WaitHasTimeout THEN
        waitblock = &thread^.TimeoutWaitBlock

        // Remove the timer wait block.

        KepDequeueWaitBlock ( object, waitblock )

        // Cancel the timer.

        KeDequeueTimer ( &thread^.Timeout )
    END
]

FN KepKernelApcReceived (
    IN timeout : ^RtlUquad,
    IN starttime : ^RtlUquad,
) : UWORD

    // A kernel APC interrupted the wait, so decrement the timeout based on how
    // many milliseconds have transpired since the wait began. Return TRUE if
    // the timeout is already in the past.

    currenttime : RtlUquad

    KepCaptureCurrentTicks ( &currenttime )

    RtlSubUquadFromUquad ( &currenttime, starttime )

    IF NOT RtlUquadLtUquad ( &currenttime, timeout ) THEN
        // Timeout already expired.

        RETURN TRUE
    END

    RtlSubUquadFromUquad ( timeout, &currenttime )

    RETURN FALSE
END

FN KepMasterContinuation ()

    // This routine is called in the context of any thread that was awoken after
    // performing a wait with a continuation.

    // We are at KEP_IPL_DPC and do not have the thread lock.

    thread := KeCurrentThread ()

    thread^.HasContinuation = FALSE

    continuation := &thread^.Continuation

    func := continuation^.Function

    // First we must do common wait-end processing.

    waitblocktable : ^KepWaitBlock
    objectcount : UWORD
    object : ^KepDispatchHeader
    queue : ^KeBalancedQueue

    KepWaitTail ( waitblocktable, objectcount, object, thread, queue )

    waitstatus := thread^.WaitStatus

    IF waitstatus != OS_STATUS_KERNEL_APC OR
        thread^.Alertable == KE_CANCEL_ON_KAPC THEN

        // Didn't wake up due to delivery of a KAPC, or we did but the
        // alertability mode indicated to cancel upon that event. Therefore we
        // should not restart the wait.

        KepLowerIpl ( thread^.WaitIpl )

@ExecuteContinuation

        func (
            continuation, // continuation
            waitstatus, // waitstatus
        )

        KeCrash ( "Continuation returned\n" )
    END

    // Awoke due to delivery of a kernel APC, and the alertable mode does
    // not indicate that the wait should be cancelled. Therefore we need to
    // adjust the timeout and put the thread back to sleep.

    // Capture the wait parameters before lowering IPL so that they
    // don't get corrupted by KAPCs that may arrive.

    waitmode := thread^.WaitMode
    objectcount = thread^.WaitCount
    hastimeout := thread^.WaitHasTimeout
    waitblocktable = thread^.WaitBlockTable
    alertable := thread^.Alertable
    objecttable : ^^KepDispatchHeader = NULLPTR

    IF objectcount <= KE_THREAD_WAIT_BLOCKS THEN
        // The integral thread wait block table was used.
        // This wait block table cannot be reused directly, because when we
        // lower IPL to deliver KAPCs below, it can be corrupted. So we have
        // to save the objects they point to now.

        IF objectcount != 0 THEN
            savedobjects : ^KepDispatchHeader[KE_THREAD_WAIT_BLOCKS]

            i := 0

            WHILE i < objectcount DO
                savedobjects[i] = waitblocktable[i].Object

                i += 1
            END

            objecttable = &savedobjects[0]
        END

        waitblocktable = NULLPTR
    END
    
    remainingtimeout : RtlUquad
    starttime : RtlUquad

    timeout : ^RtlUquad = NULLPTR

    IF hastimeout THEN
        timeout = &remainingtimeout

        RtlMoveUquad (
            timeout, // dest
            &thread^.RemainingWaitTimeout, // src
        )

        RtlMoveUquad (
            &starttime, // dest
            &thread^.StartWaitTime, // src
        )
    END

    KepLowerIpl ( thread^.WaitIpl )

    IF hastimeout AND KepKernelApcReceived (
        &remainingtimeout, // timeout
        &starttime, // starttime
    ) THEN

        // The wait timed out.

        waitstatus = OS_STATUS_WAIT_TIMEOUT

        GOTO ExecuteContinuation
    END

    // The wait should continue.

    waitstatus = KeWaitForObjects (
        waitmode, // waitmode
        alertable, // alertable
        timeout, // timeout
        objectcount, // objectcount
        objecttable, // objecttable
        waitblocktable, // waitblocktable
        continuation, // continuation
    )

    // KeWaitForObjects directly returns if the wait was immediately
    // satisfied or there was an interrupting event.

    GOTO ExecuteContinuation
END

FN KepUnwaitThread (
    IN thread : ^KeuThread,
    IN status : UWORD,
    IN priorityboost : UWORD,
) : UWORD

    // Unwait the thread.
    // The thread lock is held.
    // If we're here, the thread was definitely waiting. This means
    // that its wait block table is valid and full of initialized wait blocks.

    // If status is nonzero then we try to atomically claim the wait, and
    // return TRUE if we unwaited the thread, FALSE if someone else beat us to
    // it. It should always be nonzero unless the wait was previously claimed
    // (which can happen in cases of KepSatisfyObject).

    IF status THEN
        IF NOT KepTryCompleteWait (
            thread, // thread
            status, // waitstatus
        ) THEN

            RETURN FALSE
        END
    END

    KeAssert ( thread^.Status == KE_THREAD_WAITING )

    // Replenish the quantum of the thread.

    thread^.RemainingQuantum = KEP_DEFAULT_QUANTUM

    IF priorityboost AND thread^.Priority < OS_PRIORITY_LOW_REALTIME THEN
        // Apply the priority boost to the thread.

        newpri := thread^.BasePriority + priorityboost

        // Don't cross into the real time priority class.

        IF newpri > OS_PRIORITY_HIGH_USER THEN
            newpri = OS_PRIORITY_HIGH_USER
        END

        // Only apply the boost if it raises the thread's priority.

        IF newpri > thread^.Priority THEN
            thread^.Priority = newpri
        END
    END

    IF thread^.WaitMode == KE_USER_MODE THEN
        // Update the ticks the thread has spent sleeping.

        waitedms := thread^.StateMs
        currentms := KepLowTick ()

        IF waitedms < currentms THEN
            thread^.SleepMs += (currentms - waitedms) << KEP_TICK_SHIFT

            // Update interactivity score.

            KepUpdateInteractivity (
                thread, // thread
                FALSE, // deferupdate
            )
        END
    END

    // If it's associated with a balanced queue, we have to indicate that it's
    // awake now.

    queue := thread^.BalancedQueue

    IF queue THEN
        KeIncrementUlongMp (
            &queue^.ActiveThreadCount, // ptr
            1, // inc
        )
    END

    // Ready the thread.

    KepReadyThread ( thread )

    RETURN TRUE
END

#IF BLD_MP

FN KepDeferredUnwaitThread (
    IN thread : ^KeuThread,
    IN priorityboost : UWORD,
)

    // Defer unwaiting this thread until it's safe.

    IF KepTryAcquireThreadElevated ( thread ) THEN
        // Actually managed to try-acquire it now, so unwait now.

        KepUnwaitThread (
            thread, // thread
            0, // status
            priorityboost, // priorityboost
        )

        KepReleaseThreadElevated ( thread )

        LEAVE
    END

    thread^.PriorityBoost = priorityboost

    prb := KEP_CURRENT_PRB

    thread^.NextToUnwait = prb^.DeferredUnwaitThreadListHead
    prb^.DeferredUnwaitThreadListHead = thread

    KepSoftInterruptSelf (
        prb, // prb
        KEP_IPL_DPC, // ipl
    )
END

FN KepDeferredUnwaitThreads (
    IN prb : ^KepPrb,
)

    // Called from the DPC level interrupt when there are deferred threads to
    // unwait.

    thread := prb^.DeferredUnwaitThreadListHead
    prb^.DeferredUnwaitThreadListHead = NULLPTR

    WHILE thread DO
        next := thread^.NextToUnwait

        KepAcquireThreadElevated ( thread )

        KepUnwaitThread (
            thread, // thread
            0, // status
            thread^.PriorityBoost, // priorityboost
        )

        KepReleaseThreadElevated ( thread )

        thread = next
    END
END

#END

FN KepSatisfyObject (
    IN object : ^KepDispatchHeader,
    IN priorityboost : UWORD,
    IN all : UWORD,
    IN status : OsStatus,
) : UWORD

    // Satisfy a wait on the object. The object lock is held.
    // Return whether at least one thread was satisfied.

    listhead := &object^.WaitListHead
    listentry := listhead^.Next

    satisfied := FALSE

    WHILE listentry != listhead DO
        waitblock := CONTAINEROF listentry TO KepWaitBlock.Entry
        listentry = listentry^.Next

        thread := waitblock^.Thread

        // Set the wait block dequeued and remove it from our queue.

        waitblock^.Flags |= KEP_WB_DEQUEUED

        RtlRemoveEntryList ( &waitblock^.Entry )

        // Decrement our waiter count.

        object^.WaiterCount -= 1

        wakestatus := status

        IF NOT wakestatus THEN
            wakestatus = waitblock^.WakeStatus
        END

        IF NOT KepTryCompleteWait (
            thread, // thread
            wakestatus, // wakestatus
        ) THEN

            // Somebody else woke the thread and is responsible for unwaiting.

            CONTINUE
        END

        KepDeferredUnwaitThread (
            thread, // thread
            priorityboost, // priorityboost
        )

        IF NOT all THEN
            // We got one, so exit.

            RETURN TRUE
        END

        satisfied = TRUE
    END

    RETURN satisfied
END

EXPORT FN KeIsKilledThread (
    IN thread : ^KeuThread,
) : UWORD

    // Return whether the thread has been killed.
    // Useful for keeping things responsive to termination during lengthy
    // operations.

    IF thread^.IgnoreEventCount THEN
        RETURN FALSE
    END

    RETURN thread^.SignalMask[OS_SIGNAL_KILL / 32] &
        (1 << (OS_SIGNAL_KILL & 31))
END

FN KepCaptureCurrentTicksFunc (
    IN time : ^RtlUquad,
)

    // Capture current ticks, out-of-line.

    KepCaptureCurrentTicks ( time )
END

#MACRO KepQueueObject ( object ) [
    (CONTAINEROF (object) TO KeBalancedQueue.Header)
]

EXPORT FN KeWaitForObjects (
    IN waitmode : UWORD,
    IN alertable : UWORD,
    IN timeout : ^RtlUquad,
    IN objectcount : UWORD,
    IN objecttable : ^^KepDispatchHeader,
    IN waitblocktable : ^KepWaitBlock,
    IN continuation : ^KeContinuation,
) : OsStatus

    // Wait for any of multiple objects to enter a signaled state. A timeout
    // interval in milliseconds can be supplied. If it is NULLPTR, the timeout
    // is infinite.
    //
    // If a continuation is provided, and the thread is actually blocked, then
    // the thread will execute the continuation function on a fresh stack when
    // it is awoken. If the thread is not blocked (because the wait is aborted
    // prior to the blocking decision being made, or an object is already
    // signaled), then this function will return to the caller. The caller must
    // be prepared for either case.
    //
    // objecttable can be NULLPTR in which case the wait blocks in
    // waitblocktable are assumed to be preinitialized with object pointers.
    // (This is primarily for the re-waiting case of continuations).

    status : OsStatus

    KeAssert ( objectcount <= 0xFF )

    thread := KeCurrentThread ()

    IF NOT waitblocktable THEN
        KeAssert ( objectcount <= KE_THREAD_WAIT_BLOCKS )

        // Use the integral wait blocks of the thread.
        // This mechanism exists to remove dependency on allocation.

        waitblocktable = &thread^.WaitBlocks[0]
    END

    remainingtimeout : RtlUquad

    IF timeout THEN
        RtlMoveUquad (
            &remainingtimeout, // dest
            timeout, // src
        )
    END

@Retry

    // Raise IPL to stop APCs from corrupting our wait state if they come in
    // and try to wait in our context.

    ipl := KepRaiseIpl ( KEP_IPL_DPC )

    KeAssert ( ipl < KEP_IPL_DPC )

    i := 0
    waitblock := &waitblocktable[0]

    WHILE i < objectcount DO
        waitblock^.Thread = thread
        waitblock^.WakeStatus = i
        waitblock^.Flags = 0

        IF objecttable THEN
            waitblock^.Object = objecttable[i]
        END

        i += 1
        waitblock += SIZEOF KepWaitBlock
    END

    // Clear timeout wait block flags field.

    thread^.TimeoutWaitBlock.Flags = 0

    // Set the wait values in the thread.

    thread^.Alertable = alertable
    thread^.WaitMode = waitmode
    thread^.WaitIpl = ipl
    thread^.WaitHasTimeout = FALSE
    thread^.WaitStatus = OS_STATUS_WAIT_PLACEHOLDER

    // Store the wait block table in the thread.

    thread^.WaitBlockTable = waitblocktable

    // Acquire the thread lock to check for interrupting events.

    KepAcquireThreadElevated ( thread )

    bits := thread^.PendingEventsSet

    IF bits THEN
        // Ensure that everything is in order for the thread to wait, and that
        // no events should interrupt said wait.

        status = 0

        IF ipl == KEP_IPL_APC THEN
            // IPL >= KEP_IPL_APC masks out all events.

            IF alertable == KE_CANCEL_ON_KAPC AND
                bits & KEP_THREAD_PENDING_KAPC THEN

                // This allows consumers to use custom wait cleanup logic prior
                // to the execution of pending KAPCs (in particular, the
                // turnstile package).

                status = OS_STATUS_KERNEL_APC
            END

#IF BLD_MP
        ELSEIF bits & KEP_THREAD_PENDING_KAPC THEN
            // A KAPC was enqueued between raising IPL and locking our thread.

            KepReleaseThread ( thread, ipl )

            GOTO Retry
#END

        ELSEIF alertable == KE_UNALERTABLE THEN
            // Wait was unalertable.

            IF waitmode == KE_USER_MODE AND
                thread^.SignalMask[0] & (1 << OS_SIGNAL_KILL) THEN

                // Unalertable usermode waits are interrupted by termination.

                status = OS_STATUS_KILLED
            END

        ELSEIF waitmode == KE_KERNEL_MODE THEN
            IF NOT thread^.IgnoreEventCount AND
                thread^.SignalMask[0] & (1 << OS_SIGNAL_KILL) THEN

                // Alertable kernel mode waits are only interrupted by
                // termination.

                status = OS_STATUS_KILLED
            END

        ELSEIF bits & KEP_THREAD_PENDING_UAPC THEN
            // There are pending usermode APCs and this is a usermode
            // wait, so interrupt the wait and cause them to be
            // dispatched upon return to userspace.

            thread^.UserApcTriggered = TRUE
            thread^.UserInterrupt = TRUE

            status = OS_STATUS_USER_APC

        ELSEIF bits & KEP_THREAD_PENDING_SIGNAL THEN
            // There are pending signals and this is a usermode wait, so
            // interrupt the wait and cause them to be dispatched upon return
            // to usermode.

            thread^.SignalDeliverOnWaitMask[0] &= ~thread^.SignalMask[0]
            thread^.SignalDeliverOnWaitMask[1] &= ~thread^.SignalMask[1]

            thread^.UserInterrupt = TRUE

            status = OS_STATUS_SIGNALED
        END

        IF status THEN
            KepReleaseThread ( thread, ipl )

            RETURN status
        END
    END

    object : ^KepDispatchHeader

    waitblock = &waitblocktable[0]
    i = 0

    WHILE i < objectcount DO
        object = waitblocktable[i].Object

        KepAcquireObjectElevated ( object )

        // Check if the object should immediately satisfy the thread's wait.

        IF object^.Type^.ShouldSatisfy (
            thread, // thread
            object, // object
        ) THEN

            // Already signaled. Our wait has been satisfied before it began.
            // Try to atomically claim the wait completion on behalf of this
            // object and if that works, and it's not a notification event,
            // consume a signal count.

            IF NOT KepTryCompleteWait (
                thread, // thread
                i, // waitstatus
            ) THEN

                // We lost the race to complete our own wait so there is a
                // deferred unwait pending. The best thing to do now is to just
                // commit to a wait so that that unwait can occur. The effect
                // is kind of a barrier where we wait for it to be processed.
                // It'd be more difficult to try to intercept and cancel the
                // deferred unwait somehow and this case should be quite rare.

                KepReleaseObjectElevated ( object )

                GOTO Wait
            END

            // This object satisfied the thread's wait, so call the
            // type-specific consume function.

            object^.Type^.Consume (
                thread, // thread
                object, // object
            )

            KepReleaseObjectElevated ( object )

            KepReleaseThreadElevated ( thread )

            // Back out of the wait by simply removing our wait blocks from
            // all of the objects that we enqueued them to.

            j := 0
            waitblock = &waitblocktable[0]

            WHILE j < i DO
                KepDequeueWaitBlock ( object, waitblock )

                j += 1
                waitblock += SIZEOF KepWaitBlock
            END

            status = thread^.WaitStatus

            KepLowerIpl ( ipl )

            RETURN status
        END

        // Enqueue our wait block to the object.

        object^.Type^.Enqueue (
            thread, // thread
            object, // object
            waitblock, // waitblock
        )

        KeAssert ( object^.WaiterCount != 0xFFFFFFFF )

        object^.WaiterCount += 1

        KepReleaseObjectElevated ( object )

        waitblock += SIZEOF KepWaitBlock
        i += 1
    END

    // Capture the start time.

    starttime : RtlUquad

    IF timeout THEN
        KepCaptureCurrentTicksFunc ( &starttime )

        // Start the timeout.
        // NOTE: The timer object and the timeout wait block have been
        //       initialized by KeuInitializeThread already.

        waitblock = &thread^.TimeoutWaitBlock

        // Enqueue the timer.

        KeEnqueueTimer (
            &thread^.Timeout, // timer
            &remainingtimeout, // interval
            0, // context1
            0, // context2
        )

        // Insert the wait block in the timer's list.
        // This is safe to do without a lock because only we ever mess with
        // this timer in the context of this thread.

        RtlInsertAtTailList (
            &thread^.Timeout.Header.WaitListHead, // head
            &waitblock^.Entry, // entry
        )

        thread^.Timeout.Header.WaiterCount = 1

        thread^.WaitHasTimeout = TRUE
    END

    KeAssert ( thread != &KEP_CURRENT_PRB^.IdleThread )

    // Save information that may later be needed for a retry.

    RtlMoveUquad (
        &thread^.RemainingWaitTimeout, // dest
        &remainingtimeout, // src
    )

    RtlMoveUquad (
        &thread^.StartWaitTime, // dest
        &starttime, // src
    )

@Wait

    // Set the wait count to however many objects we really enqueued (not
    // necessarily the same as objectcount, see the GOTO above).

    thread^.WaitCount = i

    // If we're associated with a balanced queue, we have to indicate that we
    // are blocking so that someone else can be awoken.

    IF thread^.BalancedQueue THEN
        KepWakeBalancedQueue ( thread^.BalancedQueue )
    END

    // Set the thread status to WAITING.

    thread^.Status = KE_THREAD_WAITING

    // Store tick we slept on.

    thread^.StateMs = KepLowTick ()

    // Yield.

    KepYield (
        thread, // current
        KEP_CURRENT_PRB, // prb
        continuation, // continuation
    )

    // All of our wait blocks have been dequeued, timer dequeued, etc.

    // If we got back here, then we better not have had a continuation.
    // If we did, then we should be executing that right now.

    KeAssert ( continuation == NULLPTR )

    // Do common wait-end processing.

    KepWaitTail ( waitblock, i, object, thread )

    // Return the status.

    status = thread^.WaitStatus

    KepLowerIpl ( ipl )

    IF status != OS_STATUS_KERNEL_APC OR
        alertable == KE_CANCEL_ON_KAPC THEN

        // Not awoken due to KAPC delivery, or caller asked to cancel upon
        // KAPC delivery, so return now.

        RETURN status
    END

    // We executed a KAPC so adjust our timeout and go back to sleep.

    IF timeout AND KepKernelApcReceived (
        &remainingtimeout, // timeout
        &starttime, // starttime
    ) THEN

        RETURN OS_STATUS_WAIT_TIMEOUT
    END

    GOTO Retry
END

EXPORT FN KeWaitForSingleObject (
    IN waitmode : UWORD,
    IN alertable : UWORD,
    IN timeout : ^RtlUquad,
    IN object : ^KepDispatchHeader,
    IN continuation : ^KeContinuation,
) : OsStatus

    // Wait for a single object to enter a signaled state. A timeout
    // interval in milliseconds can be supplied. If it is NULLPTR, the timeout
    // is infinite.

    objecttable : ^KepDispatchHeader[1]
    objecttable[0] = object

    RETURN KeWaitForObjects (
        waitmode, // waitmode
        alertable, // alertable
        timeout, // timeout
        1, // objectcount
        &objecttable[0], // objecttable
        NULLPTR, // waitblocktable
        continuation, // continuation
    )
END