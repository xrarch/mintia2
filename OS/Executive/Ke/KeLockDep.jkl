//
// Lock dependency verifier.
//

#INCLUDE "Kep.hjk"


#IF BLD_LOCKDEP

#DEFINE NUM_BUCKETS 32

EXPORT KepLockMatrix : KepLockRelation[KEP_LOCKDEP_NUM_CLASSES]
EXPORT KepActiveLockClasses : ULONG
EXPORT KepLockClasses : KepLockClass[KEP_LOCKDEP_NUM_CLASSES]

MatrixLock : KepSpinlock

ClassesBuckets: RtlAvlNode[NUM_BUCKETS]
Started : UWORD = FALSE

#MACRO KepAcquireMatrix ( ) [
    KepAcquireSpinlockRaise ( &MatrixLock )
]

#MACRO KepReleaseMatrix ( ipl ) [
    KepReleaseSpinlockLower ( &MatrixLock, ipl )
]

#MACRO KepAcquireMatrixElevated ( ) [
    KepAcquireSpinlock ( &MatrixLock )
]

#MACRO KepReleaseMatrixElevated ( ) [
    KepReleaseSpinlock ( &MatrixLock )
]


FN KepHash (
    IN str : ^UBYTE,
) : UWORD

    // Simple hash for a string.

    hash := 0

    WHILE str^ DO
        hash += str^
        hash += hash << 10
        hash $= hash >> 6

        str += 1
    END

    hash += hash << 3
    hash $= hash >> 11
    hash += hash << 15

    RETURN hash
END

#SECTION "PAGEtext"
FN (RtlAvlLessThanF) KepCompareNameNodes (
    IN a : ^RtlAvlNode,
    IN b : ^RtlAvlNode,
) : UWORD

    // Return whether A < B, lexicographically.

    RETURN CAST RtlCompareString (
        (CONTAINEROF a TO KepLockClass.Entry )^.Name,  // str1
        (CONTAINEROF b TO KepLockClass.Entry )^.Name, // str2
    ) TO WORD < 0
END


EXPORT FN KepInitializeLockDep ()

    // Initialize the lock verifier.
    // This should be called as early as possible so that as many classes as
    // possible get registered here.

    i := 0

    KepInitializeSpinlock (&MatrixLock, NULLPTR )

    WHILE i != KEP_LOCKDEP_NUM_CLASSES DO
        entry := &KepLockClasses[i]
        entry^.Index = i
        i += 1
    END

    i = 0

    WHILE i != NUM_BUCKETS DO
        RtlInitializeAvl ( &ClassesBuckets[i] )
        i += 1
    END

    Started = TRUE
END

EXPORT FN KepFindLockClass (
    IN name : ^UBYTE,
    OUT outbucket : ^RtlAvlNode
) : ^KepLockClass

    // Find a lock class by its name.

    IF name == NULLPTR THEN
        // This lock shouldn't be checked.

        RETURN NULLPTR
    END

    // Hash the name.

    hash := KepHash ( name )

    // Get the hash bucket.

    bucket := &ClassesBuckets[hash & (NUM_BUCKETS - 1)]


    // Look up the name in the bucket, which is an AVL tree keyed by string and
    // ordered lexicographically.

    avlnode := bucket^.Right

    WHILE TRUE DO
        IF NOT avlnode THEN
            // Didn't find it, we'll need to create it.

            BREAK
        END

        checknode := CONTAINEROF avlnode TO KepLockClass.Entry

        res := CAST RtlCompareString (
            name, // str1
            checknode^.Name, // str2
        ) TO WORD

        IF res == 0 THEN
            // Found it! Return the class.

            RETURN checknode
        END

        IF res < 0 THEN
            avlnode = avlnode^.Left
        ELSE
            avlnode = avlnode^.Right
        END
    END

    outbucket = bucket

    RETURN NULLPTR
END

FN KepFindCreateLockClass (
    IN name : ^UBYTE,
    IN spin : UBYTE,
) : ^KepLockClass

    // Find a lock class by its name or create it if it doesn't exist.

    IF name == NULLPTR THEN
        // This lock shouldn't be checked.

        RETURN NULLPTR
    END


    // Lock the matrix.

    ipl := KepAcquireMatrix ()

    bucket : ^RtlAvlNode

    class := KepFindLockClass (
        name, // name
        OUT bucket, // outbucket
    )

    IF class != NULLPTR THEN
        KepReleaseMatrix ( ipl ) 
        RETURN class
    END

    KeAssert ( KepActiveLockClasses < KEP_LOCKDEP_NUM_CLASSES )

    // Get a new spot for our class.

    class = &KepLockClasses[KepActiveLockClasses]
    class^.Name = name
    class^.Spin = spin
    class^.Contention = 0

    // Insert it so that we can find it by name.

    RtlInsertAvl (
        bucket, // root
        &class^.Entry, // node
        &KepCompareNameNodes, // comparisonfunc
    )

    KepActiveLockClasses += 1


    KepReleaseMatrix ( ipl ) 

    RETURN class
END



FN KepLockCloneSet (
    IN to : ^KepLockRelation,
    IN from: ^KepLockRelation,
)
    // Clone one set into another.

    i := 0

    WHILE i != KEP_LOCKDEP_BITMAP_MASKS DO
        to^.Bitmap[i] = from^.Bitmap[i]
        i += 1
    END
END

EXPORT FN KepLockIsReachable (
    IN class : ULONG,
    IN from : ^KepLockRelation,
) : UBYTE

    // Return whether the given lock class is reachable.

    wordidx := class / SIZEOF UWORD
    bit := class % (SIZEOF UWORD * 8)
    mask := 1 << bit

    RETURN from^.Bitmap[wordidx] & mask != 0
END


FN KepLockSetReachable (
    IN lock : ^KepLockRelation,
    IN index : UBYTE,
)

    // Mark the given lock class as reachable.

    wordidx := index / SIZEOF UWORD
    bit := index % (SIZEOF UWORD * 8)
    mask := 1 << bit

    lock^.Bitmap[wordidx] |= mask
END

FN KepLockMergeSets (
    IN to : ^KepLockRelation,
    IN from : ^KepLockRelation,
)

    // Merge `from`'s reachability set into `to`.

    i := 0

    WHILE i != KEP_LOCKDEP_BITMAP_MASKS DO
        to^.Bitmap[i] |= from^.Bitmap[i]
        i += 1
    END

END

FN KepAddEdge (
    IN parent : ^KepLockClass,
    IN child : ^KepLockClass,
) : UWORD

    // Add an edge between parent -> child.
    // Return FALSE if a cycle was found.

    parentidx := parent^.Index
    childidx := child^.Index

    parentmx := &KepLockMatrix[parentidx]
    childmx := &KepLockMatrix[childidx]

    IF parentidx == childidx THEN
        // Both are of the same class, trust that whatever the user is doing is
        // right.

        RETURN TRUE
    END

    IF KepLockIsReachable ( parentidx, childmx ) THEN
        // Parent is reachable from child, there is a cycle.

        RETURN FALSE

    ELSEIF KepLockIsReachable ( childidx, parentmx ) THEN
        // This relationship is already known, don't bother.

        RETURN TRUE
    END

    // Add the child and its own children to the parent's reachability set.
    // While we're here, also add this set to the parent's ancestors.

    newmask : KepLockRelation

    KepLockCloneSet (
        &newmask, // to
        childmx, // from
    )

    // Mark the child as reachable.
    KepLockSetReachable (
        &newmask, // lock
        childidx, // index
    )

    i := 0

    WHILE i != KepActiveLockClasses DO
        mxentry := &KepLockMatrix[i]

        // Only keep ancestors.

        IF NOT KepLockIsReachable (parentidx, mxentry) AND
            i != parentidx THEN
            i += 1
            CONTINUE
        END

        // Add this mask to the ancestors.

        KepLockMergeSets (
            mxentry, // to
            &newmask, // from
        )

        i += 1
    END

    RETURN TRUE
END

FN KepCheck (
    IN class: ^KepLockClass,
    IN file : ^UBYTE,
    IN line : ULONG,
    IN heldlocks: ^KepHeldLocks,
)

    // Check that a given lock can be acquired.

    IF Started == FALSE THEN
        LEAVE
    END

    num := heldlocks^.Num

    IF num == 0 OR class == NULLPTR THEN
        // This is the first lock to get taken, or this is a lock we
        // shouldn't check.

        LEAVE
    END


    fast := TRUE
    classidx := class^.Index

    // Try checking the matrix without taking any locks.

    i := 0


    WHILE i != num DO
        heldlock := &heldlocks^.Locks[i]
        kepclass := CAST heldlock^.Class TO ^KepLockClass

        IF kepclass == NULLPTR THEN
            GOTO Next
        END

        heldidx := kepclass^.Index
        heldmx := &KepLockMatrix[heldidx]

        IF NOT KepLockIsReachable( classidx, heldmx ) THEN
            // Check again under the lock.

            fast = FALSE
            BREAK
        END

@Next
        i += 1
    END

    IF fast THEN
        LEAVE
    END

    // Take the graph lock and check again.
    // Also add edges if needed.

    ipl := KepAcquireMatrix ()

    i = 0

    WHILE i != num DO
        heldlock := &heldlocks^.Locks[i]
        kepclass := CAST heldlock^.Class TO ^KepLockClass

        IF kepclass == NULLPTR THEN
            GOTO Next2
        END


        good := KepAddEdge (
            heldlock^.Class, // parent
            class, // child
        )

        IF NOT good THEN
            KeCrash (
                "Lock cycle between %s and %s detected at %s:%d\n",
                kepclass^.Name,
                class^.Name,
                file,
                line,
            )
        END

@Next2
        i += 1
    END


    KepReleaseMatrix ( ipl )
END


FN KepCheckSpinlock (
    IN class: ^KepLockClass,
    IN file : ^UBYTE,
    IN line : ULONG,
)

    // Check that a given spinlock can be acquired.

    IF Started == FALSE THEN
        LEAVE
    END

    ipl := KepRaiseIpl ( KEP_IPL_DPC )
    prb := KEP_CURRENT_PRB

    KepCheck (
        class, // class
        file, // file
        line, // line
        &prb^.HeldLocks, // heldlocks
    )

    KepLowerIpl ( ipl )

END

FN KepAcquired (
    IN lock : ^VOID,
    IN class : ^KepLockClass,
    IN file : ^UBYTE,
    IN line : ULONG,
    IN heldlocks: ^KepHeldLocks,
)

    // Called when a lock was successfully acquired.


    num := heldlocks^.Num

    heldlocks^.Locks[num].Class = class
    heldlocks^.Locks[num].File = file
    heldlocks^.Locks[num].Line = line
    heldlocks^.Locks[num].Lock = lock

    heldlocks^.Num = num + 1
END

FN KepReleased (
    IN lock : ^VOID,
    IN heldlocks: ^KepHeldLocks,
)

    // Called when a lock was released.

    KeAssert ( heldlocks^.Num > 0 )

    i := 0
    num := heldlocks^.Num
    arr := &heldlocks^.Locks

    // Find the lock we just released.

    WHILE i != num DO
        IF arr^[i].Lock == lock THEN
            BREAK
        END
        i += 1
    END

    KeAssert ( i != num )

    num -= 1

    // Shift all other locks down.

    WHILE i < num DO
        arr^[i].Lock = arr^[i + 1].Lock
        arr^[i].Class = arr^[i + 1].Class
        arr^[i].File = arr^[i + 1].File
        arr^[i].Line = arr^[i + 1].Line

        i += 1
    END

    heldlocks^.Num = num
END


EXPORT FN KepAcquiredSpinlock (
    IN spinlock : ^KepSpinlock,
    IN file : ^UBYTE,
    IN line : ULONG,
)

    // Called when a spinlock was successfully acquired.

    IF Started == FALSE THEN
        LEAVE
    END

    ipl := KepRaiseIpl ( KEP_IPL_DPC )
    prb := KEP_CURRENT_PRB
    class := CAST spinlock^.Class TO ^KepLockClass

    KepAcquired (
        CAST spinlock TO ^VOID, // lock
        class, // class
        file, // file
        line, // line
        &prb^.HeldLocks, // heldlocks
    ) 

    KepLowerIpl ( ipl )
END

EXPORT FN KepReleasedSpinlock (
    IN spinlock : ^KepSpinlock,
)

    // Called when a spinlock was released.

    IF Started == FALSE THEN
        LEAVE
    END

    ipl := KepRaiseIpl ( KEP_IPL_DPC )
    prb := KEP_CURRENT_PRB

    KepReleased (
        CAST spinlock TO ^VOID, // lock
        &prb^.HeldLocks, // heldlocks
    )

    KepLowerIpl ( ipl )
END



EXPORT FN KepLockDepInitializeSpinlock (
    IN spinlock : ^KepSpinlock,
    IN name : ^UBYTE
)

    // Register a spinlock to a given lock class.

    IF Started == FALSE THEN
        spinlock^.Class = NULLPTR
        LEAVE
    END

    class := KepFindCreateLockClass (
        name, // name
        TRUE, // spin
    )

    spinlock^.Class = CAST class TO ^VOID
END

EXPORT FN KepLockDepTryAcquireSpinlock (
    IN spinlock : ^KepSpinlock,
    IN file : ^UBYTE,
    IN line : ULONG
) : UWORD

    // Checked wrapper over TryAcquireSpinlock.

    ret := KepTryAcquireSpinlockRaw ( spinlock )

    IF ret == TRUE THEN
        KepAcquiredSpinlock (
            spinlock, // spinlock
            file, // file
            line, // line
        )

    ELSE
        class := CAST spinlock^.Class TO ^KepLockClass
        KepLockDepRegisterContention ( class )
    END

    RETURN ret
END


EXPORT FN KepLockDepRegisterContention (
    IN class : ^KepLockClass,
)

    // Register contention for a given lock class.

    IF class == NULLPTR THEN
        LEAVE
    END

    KeIncrementUlong ( &class^.Contention, 1 )

END

EXPORT FN KepLockDepAcquireSpinlock (
    IN spinlock : ^KepSpinlock,
    IN file : ^UBYTE,
    IN line : ULONG
)

    // Checked wrapper over AcquireSpinlock.


    class := CAST spinlock^.Class TO ^KepLockClass

    KepCheckSpinlock (
        class, // class
        file, // file
        line // line
    )

    ret := KepTryAcquireSpinlockRaw ( spinlock )

    IF ret == TRUE THEN
        GOTO End
    END

    KepLockDepRegisterContention ( class )

    KepAcquireSpinlockRaw ( spinlock )
@End
    KepAcquiredSpinlock (
        spinlock, // spinlock
        file, // file
        line, // line
    )
END



EXPORT FN KepLockDepAcquireSpinlockRaise (
    IN spinlock : ^KepSpinlock,
    IN file : ^UBYTE,
    IN line : ULONG
) : UWORD

    // Checked wrapper over AcquireSpinlockRaise.

    class := CAST spinlock^.Class TO ^KepLockClass

    KepCheckSpinlock (
        class, // class
        file, // file
        line, // line
    )

    ipl := KepRaiseIpl ( KEP_IPL_DPC )
    ret := KepTryAcquireSpinlockRaw ( spinlock )

    IF ret == TRUE THEN
        GOTO End
    END


    KepAcquireSpinlockRaiseRaw (spinlock)

@End
    KepAcquiredSpinlock (
        spinlock, // spinlock
        file, // file
        line, // line
    )

    RETURN ipl
END

EXPORT FN KepLockDepAcquireSpinlockInPrb (
    IN offset : UWORD,
    IN file : ^UBYTE,
    IN line : ULONG
) : UWORD

    // Checked wrapper over AcquireSpinlockInPrb.

    spinlock := CAST (KEP_CURRENT_PRB_LOCAL + offset) TO ^KepSpinlock
    class := CAST spinlock^.Class TO ^KepLockClass

    KepCheckSpinlock (
        class, // class
        file, // file
        line, // line
    )

    oldipl := KepAcquireSpinlockInPrbRaw ( offset )

    prb := KEP_CURRENT_PRB
    globalspinlock := CAST (prb + offset) TO ^KepSpinlock

    KepAcquiredSpinlock (
        globalspinlock, // spinlock
        file, // file
        line, // line
    )

    RETURN oldipl
END

EXPORT FN KepLockDepInitializeLock (
    IN lock : ^KeLock,
    IN name : ^UBYTE
)

    // Register a kernel lock to a given lock class.

    IF Started == FALSE THEN
        lock^.Class = NULLPTR
        LEAVE
    END

    class := KepFindCreateLockClass (
        name, // name
        FALSE, // spin
    )

    lock^.Class = class
END

EXPORT FN KepCheckLock (
    IN class: ^KepLockClass,
    IN file : ^UBYTE,
    IN line : ULONG,
)

    // Check that a kernel lock can be acquired.

    IF Started == FALSE THEN
        LEAVE
    END

    curthread := KeCurrentThread ()

    IF curthread == NULLPTR THEN
        // Kernel locks are used while constructing the boot idle thread, before
        // there is a current thread in which to record held locks.

        LEAVE
    END

    KepCheck (
        class, // class
        file, // file
        line, // line
        &curthread^.HeldLocks, // heldlocks
    )
END


EXPORT FN KepAcquiredLock (
    IN lock : ^KeLock,
    IN file : ^UBYTE,
    IN line : ULONG,
)

    // Called after a kernel lock was successfully acquired.

    IF Started == FALSE THEN
        LEAVE
    END

    curtd := KeCurrentThread ()

    IF curtd == NULLPTR THEN
        LEAVE
    END

    KepAcquired (
        CAST lock TO ^VOID, // lock
        lock^.Class, // class
        file, // file
        line, // line
        &curtd^.HeldLocks // heldlocks
    )
END

EXPORT FN KepReleasedLock (
    IN lock : ^KeLock,
)

    // Called after a kernel lock was released.

    IF Started == FALSE THEN
        LEAVE
    END

    curtd := KeCurrentThread ()

    IF curtd == NULLPTR THEN
        LEAVE
    END

    KepReleased (
        CAST lock TO ^VOID, // lock
        &curtd^.HeldLocks, // heldlocks
    )
END


#END
