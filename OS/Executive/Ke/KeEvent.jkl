//
// Implements support for KeEvent dispatcher objects.
//

#INCLUDE "Kep.hjk"

FN (KepShouldSatisfyF) KepSatisfyWhenSignaled (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
) : UWORD

    // Immediately satisfy a wait on this object when it is signaled.

    RETURN object^.SignalCount
END

FN (KepConsumeF) KepConsumeSignalCount (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
)

    // When this object satisfied the thread's wait, that consumes a signal
    // count.

    object^.SignalCount -= 1
END

FN (KepConsumeF) KepConsumeNoOp (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
)

    // When this object satisfied the thread's wait, that does nothing.

    NOTHING
END

FN (KepEnqueueF) KepEnqueueWaitFifo (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN waitblock : ^KepWaitBlock,
)

    // Insert thread at tail so that oldest waiter gets awoken first.

    RtlInsertAtTailList (
        &object^.WaitListHead, // head
        &waitblock^.Entry, // entry
    )
END

// Also shared with semaphores.
PUBLIC KepSynchEventType : KepDispatchObjectType = {
    [ShouldSatisfy] = &KepSatisfyWhenSignaled,
    [Consume] = &KepConsumeSignalCount,
    [Enqueue] = &KepEnqueueWaitFifo,
}

// Also shared with timers.
PUBLIC KepNotifEventType : KepDispatchObjectType = {
    [ShouldSatisfy] = &KepSatisfyWhenSignaled,
    [Consume] = &KepConsumeNoOp,
    [Enqueue] = &KepEnqueueWaitFifo,
}

EXPORT FN KeInitializeEvent (
    IN event : ^KeEvent,
    IN name : ^UBYTE,
    IN notification : UWORD,
    IN signalstate : UWORD,
)

    type := &KepSynchEventType

    IF notification THEN
        type = &KepNotifEventType
    END

    KepInitializeDispatchObject (
        &event^.Header, // hdr
        name, // name
        type, // type
    )

    IF signalstate THEN
        signalstate = 1
    END

    event^.Header.SignalCount = signalstate
END

EXPORT FN KeResetEvent (
    IN event : ^KeEvent,
) : UWORD

    ipl := KepAcquireObject ( &event^.Header )

    old := event^.Header.SignalCount
    event^.Header.SignalCount = 0

    KepReleaseObject ( &event^.Header, ipl )

    RETURN old
END

EXPORT FN KeSignalEvent (
    IN event : ^KeEvent,
    IN priorityboost : UWORD,
) : UWORD

    // Signal the event object and return its previous state.

    ipl := KepAcquireObject ( &event^.Header )

    IF event^.Header.SignalCount THEN
        KepReleaseObject ( &event^.Header, ipl )

        RETURN 1
    END

    IF event^.Header.WaiterCount THEN
        // Satisfy waits on the object.

        IF event^.Header.Type == &KepNotifEventType THEN
            // Satisfy ALL waits.

            KepSatisfyObject (
                &event^.Header, // object
                priorityboost, // priorityboost
                TRUE, // all
                0, // status
            )

            // Set signaled.

            event^.Header.SignalCount = 1

        ELSE
            // Satisfy one wait.

            IF NOT KepSatisfyObject (
                &event^.Header, // object
                priorityboost, // priorityboost
                FALSE, // all
                0, // status
            ) THEN
                // Didn't satisfy any waits. Set signaled.

                event^.Header.SignalCount = 1
            END
        END

    ELSE
        event^.Header.SignalCount = 1
    END

    KepReleaseObject ( &event^.Header, ipl )

    RETURN 0
END