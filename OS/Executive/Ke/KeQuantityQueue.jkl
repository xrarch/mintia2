//
// Implements support for KeQuantityQueue dispatcher objects.
//

#INCLUDE "Kep.hjk"

#MACRO KepThreadTierId ( queue, thread ) [
    ((CAST ((thread) + (queue)^.TierOffset) TO ^UBYTE)^)
]

FN (RtlLessThanF) KepCompareQuantityQueueRequests (
    IN a : ^RtlHeapEntry,
    IN b : ^RtlHeapEntry,
) : UWORD

    // Compare two requests.

    waitblock1 := CONTAINEROF a TO KepWaitBlock.Links.Heap
    waitblock2 := CONTAINEROF b TO KepWaitBlock.Links.Heap

    // First compute the key as the beginning tick of the request plus the
    // size of the request. This makes smaller requests satisfied sooner, but
    // eventually age of the request will cause it to be satisfied.

    key1 : UWORD = waitblock1^.Context + waitblock1^.Argument
    key2 : UWORD = waitblock2^.Context + waitblock2^.Argument

    // Now return which one is smaller.

    RETURN key1 < key2
END

FN KepTrySatisfyQuantityQueue (
    IN queue : ^KeuQuantityQueue,
    IN lockedthread : ^KeuThread,
)

    // Try to satisfy waits on the quantity queue. Lower tiers are satisfied
    // first. Object lock is held.

    max := queue^.TierCount
    tier := &queue^.Tiers[0]

    resource := queue^.Resource
    value := resource^
    new : UWORD

    WHILE max DO
        threshold := tier^.Threshold

        // Iterate over the two heap roots of the tier. The first one is the
        // one that real-time / interactive threads go on, and they'll receive
        // hunks of quantity first, as they reach the root of the heap, to
        // promote responsiveness. However, if a request reaches the root and
        // is too big to be satisfied, then we will still advance to the next
        // heap and try to satisfy requests from lower priority threads. This
        // avoids starvation and is okay because tiers are supposed to be
        // airtight boundaries but we make no guarantees for scheduling classes.

        i := 0

        WHILE i < 2 DO
            WHILE tier^.HeapRoot[i] != NULLPTR DO
                // The heap still has wait blocks on it, so grab one.

                waitblock :=
                    CONTAINEROF tier^.HeapRoot[i] TO KepWaitBlock.Links.Heap

                thread := waitblock^.Thread

                amount := CAST waitblock^.Argument TO UWORD

@Retry

                // Check if there is enough to satisfy the request, or if it
                // would cause the quantity to drop below the threshold.

                IF value < amount OR
                    (value - amount) < threshold THEN

                    // Not enough, break out of satisfying waiters on this heap.

                    BREAK
                END

                // Try to atomically claim the resource.

                new = KeCompareSwapPtr (
                    resource, // ptr
                    value - amount, // newvalue
                    value, // expectedvalue
                )

                IF new != value THEN
                    // CAS failed because value became stale, retry.

                    value = new

                    GOTO Retry
                END

                // Managed to satisfy this wait block, so remove it from the
                // heap.

                RtlRemoveFromHeap (
                    &KepCompareQuantityQueueRequests, // comparisonfunc
                    &tier^.HeapRoot[i], // rootptr
                    &waitblock^.Links.Heap, // entry
                )

                // Set the Thread pointer to NULLPTR since that's the usual
                // way to indicate to the KeWaitYaddaYadda logic that a
                // dispatcher object has unlinked a wait block from its
                // structures.

                waitblock^.Thread = NULLPTR

                // Decrement our waiter count since we use that as a hint.

                queue^.WaiterCount -= 1

                // Try to atomically claim responsibility for completing the
                // wait (other contenders include other objects the thread is
                // waiting on, KAPC delivery, and signals).

                IF NOT KepTryCompleteWait (
                    thread, // thread
                    waitblock^.Index, // wakestatus
                ) THEN

                    // Somebody else woke the thread and is responsible for
                    // unwaiting. Return the resource since the thread isn't
                    // going to get a successful status from its wait.

                    KeIncrementPtr (
                        resource, // ptr
                        amount, // inc
                    )

                ELSE
                    // We are responsible for unwaiting the thread.

#IF BLD_MP
                    IF thread == lockedthread THEN
                        // The caller already has this thread locked, so
                        // we should directly call the unwait function that
                        // assumes the thread lock is held. This happens when
                        // a thread's tier is increased by priority inheritance
                        // and we were called to see if it can now be satisfied.

                        KepUnwaitThread (
                            thread, // thread
                            0, // status
                            0, // priorityboost
                        )

                    ELSE
                        KepDeferredUnwaitThread (
                            thread, // thread
                            0, // priorityboost
                        )
                    END
#ELSE
                    KepUnwaitThread (
                        thread, // thread
                        0, // status
                        0, // priorityboost
                    )
#END

                    // The remaining value of the resource should be decremented
                    // by the amount we just handed out.

                    value -= amount
                END
            END

            i += 1
        END

        // If there are any threads still waiting on this tier, then don't
        // advance to the next one, since satisfaction should be strictly
        // ordered by tier (this one should ALWAYS be satisfied before any
        // further ones).

        IF tier^.HeapRoot[0] != NULLPTR OR
            tier^.HeapRoot[1] != NULLPTR THEN

            // There are so break out.

            BREAK
        END

        // Satisfy threads in the next tier.

        tier += SIZEOF KeuQuantityTier
        max -= 1
    END
END

FN (KepShouldSatisfyF) KepSatisfyQuantityQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN argument : ^VOID,
) : UWORD

    // Immediately satisfy a wait on a quantity queue if the thread's current
    // tier ID allows it to take the amount. This is done under both the queue's
    // object lock and the thread's lock, so if the tier ID is only updated
    // under one of those locks then this is guaranteed to commit the wait for
    // the correct tier.

    amount := CAST argument TO UWORD
    queue := CAST object TO ^KeuQuantityQueue

    tier := &queue^.Tiers[KepThreadTierId ( queue, thread )]

    // First increment the waiter count, have to do this before checking the
    // available resource or else someone who increments it might miss waking us
    // even though we end up committing a wait.

    queue^.WaiterCount += 1

    KeWriteMemoryBarrier ()

    // Try to just CAS the atomic counter.

    resource := queue^.Resource
    value := resource^
    new : UWORD

    WHILE TRUE DO
        IF value < amount OR
            (value - amount) < tier^.Threshold THEN

            // There isn't enough to satisfy the request, or it would cause the
            // quantity to drop below the threshold, so go block.

            RETURN FALSE
        END

        new = KeCompareSwapPtr (
            resource, // ptr
            value - amount, // newvalue
            value, // expectedvalue
        )

        IF new == value THEN
            // Claimed it, so return now.

            RETURN TRUE
        END

        value = new
    END
END

FN (KepAbortSatisfyF) KepAbortSatisfyQuantityQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN argument : ^VOID,
)

    // Satisfaction was aborted after we initially permitted it.
    // Have to return the amount we took from the resource earlier.

    // Unlike other times where we increment the counter, we don't need to see
    // if anyone should be awoken, since we've had the queue's lock held since
    // we took this amount, so nobody can possibly have blocked on it who
    // shouldn't be.

    amount := CAST argument TO UWORD
    queue := CAST object TO ^KeuQuantityQueue

    KeIncrementPtr (
        queue^.Resource, // ptr
        amount, // inc
    )

    queue^.WaiterCount -= 1
END

FN (KepConsumeF) KepConsumeQuantityQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN argument : ^VOID,
)

    // Don't have to do anything here since our ShouldSatisfy function already
    // yoinked the amount.

    NOTHING
END

FN (KepEnqueueF) KepEnqueueQuantityQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN waitblock : ^KepWaitBlock,
) : UWORD

    // The thread's wait on the quantity queue has been committed, so we need
    // to enqueue the wait block.

    amount := CAST waitblock^.Argument TO UWORD
    queue := CAST object TO ^KeuQuantityQueue

    tierid := KepThreadTierId ( queue, thread )

    tier := &queue^.Tiers[tierid]

    // Part of the key for the wait block is the tick that the request was
    // made at, to try to avoid starvation of older requests of many pages.

    waitblock^.Context = KepLowTick ()

    // Compute whether the thread should go into the timeshared min heap or the
    // interactive/realtime min heap.

    heapindex := NOT (thread^.Priority >= OS_PRIORITY_LOW_REALTIME |
        thread^.InteractiveBits)

    waitblock^.Spare1 = heapindex
    waitblock^.Spare2 = tierid

    // Now insert in the heap.

    RtlInsertIntoHeap (
        &KepCompareQuantityQueueRequests, // comparisonfunc
        &tier^.HeapRoot[heapindex], // rootptr
        &waitblock^.Links.Heap, // entry
    )

    RETURN (KEP_REQUEUE_WHEN_CLASS_RAISED |
        KEP_REQUEUE_WHEN_CLASS_LOWERED |
        KEP_REQUEUE_WHEN_VMP_RAISED |
        KEP_REQUEUE_WHEN_VMP_LOWERED)
END

FN (KepDequeueF) KepDequeueQuantityQueue (
    IN object : ^KepDispatchHeader,
    IN waitblock : ^KepWaitBlock,
)

    // Dequeue a wait on the quantity queue.

    queue := CAST object TO ^KeuQuantityQueue

    // We stashed the heap index and tier in the waitblock to avoid having to
    // recompute it.

    tier := &queue^.Tiers[waitblock^.Spare2]
    heapindex := waitblock^.Spare1

    // Remove the waitblock from the heap.

    RtlRemoveFromHeap (
        &KepCompareQuantityQueueRequests, // comparisonfunc
        &tier^.HeapRoot[heapindex], // rootptr
        &waitblock^.Links.Heap, // entry
    )

    // Decrement waiter count since we use that as a hint.

    queue^.WaiterCount -= 1
END

FN (KepRequeueF) KepRequeueQuantityQueue (
    IN thread : ^KeuThread,
    IN object : ^KepDispatchHeader,
    IN waitblock : ^KepWaitBlock,
    IN flags : UWORD,
)

    // The waiting thread's priority changed so we were called to see if we
    // should move the wait block or satisfy the wait. The thread lock and
    // object lock are held.

    queue := CAST object TO ^KeuQuantityQueue

    // Compute which tier and heap the thread should go in now.

    tierid := KepThreadTierId ( queue, thread )

    heapindex := NOT (thread^.Priority >= OS_PRIORITY_LOW_REALTIME |
        thread^.InteractiveBits)

    // Grab the heap and tier it is currently in, since we stashed those in the
    // waitblock.

    currentheapindex := waitblock^.Spare1
    currenttierid := waitblock^.Spare2

    // Check if it actually changed and needs to be requeued.

    IF currentheapindex != heapindex OR
        currenttierid != tierid THEN

        // The wait block really is in the wrong heap or tier so fully
        // requeue it.

        tier := &queue^.Tiers[currenttierid]

        // First remove from the old heap.

        RtlRemoveFromHeap (
            &KepCompareQuantityQueueRequests, // comparisonfunc
            &tier^.HeapRoot[currentheapindex], // rootptr
            &waitblock^.Links.Heap, // entry
        )

        // Save new heap index and tier.

        waitblock^.Spare1 = heapindex
        waitblock^.Spare2 = tierid

        // Now insert in the new heap.

        tier = &queue^.Tiers[tierid]

        RtlInsertIntoHeap (
            &KepCompareQuantityQueueRequests, // comparisonfunc
            &tier^.HeapRoot[heapindex], // rootptr
            &waitblock^.Links.Heap, // entry
        )

        IF tierid < currenttierid THEN
            // The thread is now in a lower tier which means it has a more
            // permissible threshold that may allow it to take the resources it
            // wants.

            KepTrySatisfyQuantityQueue (
                queue, // queue
                thread, // lockedthread
            )
        END
    END
END

#SECTION "text"
KepQuantityQueueType : KepDispatchObjectType = {
    [ShouldSatisfy] = &KepSatisfyQuantityQueue,
    [AbortSatisfy] = &KepAbortSatisfyQuantityQueue,
    [Consume] = &KepConsumeQuantityQueue,
    [Enqueue] = &KepEnqueueQuantityQueue,
    [Dequeue] = &KepDequeueQuantityQueue,
    [Requeue] = &KepRequeueQuantityQueue,
}

FN KeuInitializeQuantityQueue (
    IN queue : ^KeuQuantityQueue,
    IN name : ^UBYTE,
    IN resource : ^UWORD,
    IN tiers : ^KeuQuantityTier,
    IN tiercount : UWORD,
    IN tieroffset : UWORD,
    IN errorstatus : OsStatus,
)

    // Initialize a quantity queue.
    //
    // The Threshold field of each tier should have been initialized by the
    // caller. Tiers should be sorted in increasing order of threshold.
    //
    // tieroffset is an offset from the base of a KeuThread structure at which
    // a UBYTE tier ID can be found.

    KepInitializeDispatchObject (
        &queue^.Header, // hdr
        name, // name
        &KepQuantityQueueType, // type
    )

    queue^.Resource = resource
    queue^.Tiers = tiers
    queue^.TierOffset = tieroffset
    queue^.TierCount = tiercount
    queue^.WaiterCount = 0
    queue^.ErrorStatus = errorstatus

    i := 0

    WHILE i < tiercount DO
        // Initialize two min-heaps per tier. The first min-heap is for
        // real-time / interactive threads and the second is for timeshared
        // threads, to make sure the former gets first dibs always.

        tiers[i].HeapRoot[0] = NULLPTR
        tiers[i].HeapRoot[1] = NULLPTR

        i += 1
    END
END

FN KeuDecrementQuantityQueue (
    IN queue : ^KeuQuantityQueue,
    IN amount : UWORD,
    IN waitmode : UWORD,
    IN alertable : UWORD,
    IN timeout : ^RtlUquad,
    IN wait : UWORD,
) : OsStatus

    // Decrement the quantity by amount. If this would cause the quantity to
    // drop below the tier's threshold, then block the thread until enough is
    // available.

    tier := &queue^.Tiers[KepThreadTierId ( queue, KeCurrentThread () )]

    // Try to just CAS the atomic counter.

    resource := queue^.Resource
    value := resource^
    new : UWORD

    WHILE TRUE DO
        IF value < amount OR
            (value - amount) < tier^.Threshold THEN

            // There isn't enough to satisfy the request, or it would cause the
            // resource to drop below the threshold, so go block.

            BREAK
        END

        IF amount == 0 THEN
            // Caller is just checking to see if the resource is above its
            // threshold. It is, so return rather than doing a useless CAS.

            RETURN OS_STATUS_SUCCESS
        END

        new = KeCompareSwapPtr (
            resource, // ptr
            value - amount, // newvalue
            value, // expectedvalue
        )

        IF new == value THEN
            // Claimed it, so return now.

            RETURN OS_STATUS_SUCCESS
        END

        value = new
    END

    IF NOT wait THEN
        RETURN queue^.ErrorStatus
    END

    RETURN KeWaitForSingleObject (
        waitmode, // waitmode
        alertable, // alertable
        timeout, // timeout
        queue, // object
        CAST amount TO ^VOID, // argument
        NULLPTR, // continuation
    )
END

FN KeuIncrementQuantityQueue (
    IN queue : ^KeuQuantityQueue,
    IN amount : UWORD,
)

    // Release the amount to the quantity queue and then wake up anybody who
    // can be awoken.

    KeIncrementPtr (
        queue^.Resource, // ptr
        amount, // inc
    )

    IF queue^.WaiterCount THEN
        // There are waiters, so they might need to be awoken.

        // XXX WaiterCount could prove to not be a sufficient hint to avoid
        //     major contention on this lock during low memory circumstances
        //     so maintaining an out-of-line "minimum amount" for each heap
        //     root that we could scan locklessly here, to tell with more
        //     certainty that there's really someone to satisfy, might be a
        //     good idea if that turns out to be a big problem.

        ipl := KepAcquireObject ( &queue^.Header )

        KepTrySatisfyQuantityQueue (
            queue, // queue
            NULLPTR, // lockedthread
        )

        KepReleaseObject ( &queue^.Header, ipl )
    END
END